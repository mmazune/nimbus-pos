    entityType           RiskEntityType     @map("entity_type")
    entityId             String             @map("entity_id")
    actorUserId          String?            @map("actor_user_id")
    relatedOrderId       String?            @map("related_order_id")
    relatedShiftId       String?            @map("related_shift_id")
    relatedTillSessionId String?            @map("related_till_session_id")
    relatedPaymentId     String?            @map("related_payment_id")
    relatedRefundId      String?            @map("related_refund_id")
