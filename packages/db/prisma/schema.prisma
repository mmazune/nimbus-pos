    branch          Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
    order           Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
    reservation     Reservation?     @relation(fields: [reservationId], references: [id], onDelete: SetNull)
    event           Event?           @relation(fields: [eventId], references: [id], onDelete: SetNull)
    feedbackRequest FeedbackRequest? @relation(fields: [feedbackRequestId], references: [id], onDelete: SetNull)
    acknowledgedBy  User?            @relation("FeedbackAcknowledgedBy", fields: [acknowledgedById], references: [id], onDelete: SetNull)
    resolvedBy      User?            @relation("FeedbackResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
