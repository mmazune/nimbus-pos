/// Persists a normalized branch ranking for a metric family over a defined window.
model FranchiseRanking {
    id                 String               @id @default(cuid())
    orgId              String               @map("org_id")
    branchId           String               @map("branch_id")
    rankingType        FranchiseRankingType @map("ranking_type")
    windowType         FranchiseWindowType  @map("window_type")
    windowStart        DateTime             @map("window_start")
    windowEnd          DateTime             @map("window_end")
    rank               Int
    score              Decimal              @db.Decimal(14, 4)
    normalizationBasis String?              @map("normalization_basis")
    sourceSignals      Json?                @map("source_signals")
    branchCount        Int                  @default(0) @map("branch_count")
    metadata           Json?
    generatedAt        DateTime             @default(now()) @map("generated_at")
    createdAt          DateTime             @default(now()) @map("created_at")
    updatedAt          DateTime             @updatedAt @map("updated_at")

    organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
    branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)

    @@unique([orgId, branchId, rankingType, windowType, windowStart, windowEnd])
    @@index([orgId])
    @@index([branchId])
    @@index([rankingType])
    @@index([windowStart, windowEnd])
    @@index([orgId, rankingType, windowStart, windowEnd])
    @@index([orgId, branchId, rankingType])
    @@map("franchise_rankings")
}

