    notes              String?
    metadata           Json?
    createdAt          DateTime      @default(now()) @map("created_at")
    updatedAt          DateTime      @updatedAt @map("updated_at")

    organization            Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
    branch                  Branch?            @relation(fields: [branchId], references: [id], onDelete: SetNull)
    parentAccount           Account?           @relation("AccountHierarchy", fields: [parentAccountId], references: [id], onDelete: SetNull)
    childAccounts           Account[]          @relation("AccountHierarchy")
    debitPostingSourceMaps  PostingSourceMap[] @relation("DebitAccount")
    creditPostingSourceMaps PostingSourceMap[] @relation("CreditAccount")
    outputTaxConfigs        TaxLedgerConfig[]  @relation("OutputTaxAccount")
    inputTaxConfigs         TaxLedgerConfig[]  @relation("InputTaxAccount")
    discountConfigs         TaxLedgerConfig[]  @relation("DiscountAccount")
    depositLiabilityConfigs TaxLedgerConfig[]  @relation("DepositLiabilityAccount")
    payrollPayableConfigs   TaxLedgerConfig[]  @relation("PayrollPayableAccount")
    // M29 — GL journal lines
    journalLines            JournalLine[]
    // M37 — Budget lines
    budgetLines             BudgetLine[]
    // M36 — Bank reconciliation
    bankAccountsLinked      BankAccount[]      @relation("BankAccountGlAccount")
    manualBankEntries       ManualBankEntry[]  @relation("ManualBankEntryAccount")

    @@unique([orgId, code])
    @@index([orgId])
    @@index([branchId])
    @@index([accountType])
    @@index([status])
    @@index([parentAccountId])
    @@index([systemManaged])
    @@index([orgId, accountType, status])
    @@map("accounts")
}

/// Cost center / department used for later operational and financial attribution.
model CostCenter {
    id          String   @id @default(cuid())
    orgId       String   @map("org_id")
    branchId    String?  @map("branch_id")
    code        String
    name        String
    description String?
    active      Boolean  @default(true)
    metadata    Json?
    createdAt   DateTime @default(now()) @map("created_at")
    updatedAt   DateTime @updatedAt @map("updated_at")

    organization Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
    branch       Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
    // M29 — GL journal lines
    journalLines JournalLine[]
    // M37 — Budget lines
    budgetLines  BudgetLine[]

    @@unique([orgId, code])
    @@index([orgId])
    @@index([branchId])
    @@index([code])
    @@index([active])
    @@index([orgId, active])
    @@map("cost_centers")
}

/// Fiscal period for an organization. Supports DRAFT→OPEN→CLOSED→LOCKED lifecycle.
model FiscalPeriod {
    id         String             @id @default(cuid())
    orgId      String             @map("org_id")
    name       String
    startsAt   DateTime           @map("starts_at")
    endsAt     DateTime           @map("ends_at")
    status     FiscalPeriodStatus @default(DRAFT)
    openedAt   DateTime?          @map("opened_at")
    openedById String?            @map("opened_by_id")
    closedAt   DateTime?          @map("closed_at")
    closedById String?            @map("closed_by_id")
    lockedAt   DateTime?          @map("locked_at")
    lockedById String?            @map("locked_by_id")
    metadata   Json?
    createdAt  DateTime           @default(now()) @map("created_at")
    updatedAt  DateTime           @updatedAt @map("updated_at")

    organization        Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
    openedBy            User?                @relation("FiscalPeriodOpenedBy", fields: [openedById], references: [id], onDelete: SetNull)
    closedBy            User?                @relation("FiscalPeriodClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
    lockedBy            User?                @relation("FiscalPeriodLockedBy", fields: [lockedById], references: [id], onDelete: SetNull)
    // M29 — GL journal entries
    journalEntries      JournalEntry[]
    // M36 — Bank Reconciliation + Period Close
    bankReconciliations BankReconciliation[]
    closeRuns           PeriodCloseRun[]
    // M37 — Budgets + Forecasts
    budgets             Budget[]
    forecastRuns        ForecastRun[]

    @@index([orgId])
    @@index([status])
    @@index([startsAt])
    @@index([endsAt])
    @@index([orgId, status])
    @@index([orgId, startsAt, endsAt])
    @@map("fiscal_periods")
}

/// Maps an operational source document type to default debit/credit accounts for future journal posting.
model PostingSourceMap {
    id                 String   @id @default(cuid())
    orgId              String   @map("org_id")
    sourceKey          String   @map("source_key")
    debitAccountId     String?  @map("debit_account_id")
    creditAccountId    String?  @map("credit_account_id")
    costCenterRequired Boolean  @default(false) @map("cost_center_required")
    active             Boolean  @default(true)
    notes              String?
    metadata           Json?
    createdAt          DateTime @default(now()) @map("created_at")
    updatedAt          DateTime @updatedAt @map("updated_at")

    organization  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
    debitAccount  Account?     @relation("DebitAccount", fields: [debitAccountId], references: [id], onDelete: SetNull)
    creditAccount Account?     @relation("CreditAccount", fields: [creditAccountId], references: [id], onDelete: SetNull)

    @@unique([orgId, sourceKey])
    @@index([orgId])
    @@index([sourceKey])
    @@index([active])
    @@index([orgId, active])
    @@map("posting_source_maps")
}

/// Tax-ledger configuration linking key tax/discount/liability accounts for future tax-aware postings.
model TaxLedgerConfig {
    id                        String   @id @default(cuid())
    orgId                     String   @map("org_id")
    outputTaxAccountId        String?  @map("output_tax_account_id")
    inputTaxAccountId         String?  @map("input_tax_account_id")
    discountAccountId         String?  @map("discount_account_id")
    depositLiabilityAccountId String?  @map("deposit_liability_account_id")
    payrollPayableAccountId   String?  @map("payroll_payable_account_id")
    active                    Boolean  @default(true)
    metadata                  Json?
    createdAt                 DateTime @default(now()) @map("created_at")
    updatedAt                 DateTime @updatedAt @map("updated_at")

    organization            Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
    outputTaxAccount        Account?     @relation("OutputTaxAccount", fields: [outputTaxAccountId], references: [id], onDelete: SetNull)
    inputTaxAccount         Account?     @relation("InputTaxAccount", fields: [inputTaxAccountId], references: [id], onDelete: SetNull)
    discountAccount         Account?     @relation("DiscountAccount", fields: [discountAccountId], references: [id], onDelete: SetNull)
    depositLiabilityAccount Account?     @relation("DepositLiabilityAccount", fields: [depositLiabilityAccountId], references: [id], onDelete: SetNull)
    payrollPayableAccount   Account?     @relation("PayrollPayableAccount", fields: [payrollPayableAccountId], references: [id], onDelete: SetNull)

    @@index([orgId])
    @@index([active])
    @@index([orgId, active])
    @@map("tax_ledger_configs")
}

// ── M29 Models ──

/// A balanced journal entry in the general ledger. Source-traceable, immutable once posted.
model JournalEntry {
    id               String        @id @default(cuid())
    orgId            String        @map("org_id")
    branchId         String?       @map("branch_id")
    journalNumber    String        @map("journal_number")
    journalDate      DateTime      @map("journal_date") @db.Date
    status           JournalStatus @default(DRAFT)
    sourceKey        String?       @map("source_key")
    sourceDocumentId String?       @map("source_document_id")
    reference        String?
    description      String?
    fiscalPeriodId   String?       @map("fiscal_period_id")
    reversedFromId   String?       @unique @map("reversed_from_id")
    reversalOfId     String?       @unique @map("reversal_of_id")
    totalDebit       Decimal       @default(0) @map("total_debit") @db.Decimal(10, 2)
    totalCredit      Decimal       @default(0) @map("total_credit") @db.Decimal(10, 2)
    postedAt         DateTime?     @map("posted_at")
    postedById       String?       @map("posted_by_id")
    metadata         Json?
    createdAt        DateTime      @default(now()) @map("created_at")
    updatedAt        DateTime      @updatedAt @map("updated_at")

    organization   Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
    branch         Branch?         @relation(fields: [branchId], references: [id], onDelete: SetNull)
    fiscalPeriod   FiscalPeriod?   @relation(fields: [fiscalPeriodId], references: [id], onDelete: SetNull)
    postedBy       User?           @relation("JournalPostedBy", fields: [postedById], references: [id], onDelete: SetNull)
    reversedFrom   JournalEntry?   @relation("JournalReversal", fields: [reversedFromId], references: [id], onDelete: SetNull)
    reversalEntry  JournalEntry?   @relation("JournalReversal")
    lines          JournalLine[]
    postingRuns    PostingRun[]
    // M34 — AP payments linked to this journal
    vendorPayments VendorPayment[]
    // M35 — AR receipts linked to this journal
    arReceipts     ArReceipt[]

    @@unique([orgId, journalNumber])
    @@index([orgId])
    @@index([branchId])
    @@index([journalNumber])
    @@index([journalDate])
    @@index([status])
    @@index([sourceKey])
    @@index([sourceDocumentId])
    @@index([fiscalPeriodId])
    @@index([orgId, status])
    @@index([orgId, journalDate])
    @@index([orgId, sourceKey, sourceDocumentId])
    @@map("journal_entries")
}

/// A single debit or credit line within a journal entry.
model JournalLine {
    id             String               @id @default(cuid())
    orgId          String               @map("org_id")
    journalEntryId String               @map("journal_entry_id")
    accountId      String               @map("account_id")
    costCenterId   String?              @map("cost_center_id")
    direction      JournalLineDirection
    amount         Decimal              @db.Decimal(10, 2)
    description    String?
    metadata       Json?
    createdAt      DateTime             @default(now()) @map("created_at")
    updatedAt      DateTime             @updatedAt @map("updated_at")

    organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
    journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
    account      Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)
    costCenter   CostCenter?  @relation(fields: [costCenterId], references: [id], onDelete: SetNull)

    @@index([orgId])
    @@index([journalEntryId])
    @@index([accountId])
    @@index([costCenterId])
    @@index([direction])
    @@index([orgId, accountId])
    @@map("journal_lines")
}

/// A posting run tracks automated journal creation from a source document.
model PostingRun {
    id               String           @id @default(cuid())
    orgId            String           @map("org_id")
    branchId         String?          @map("branch_id")
    sourceKey        String           @map("source_key")
    sourceDocumentId String?          @map("source_document_id")
    status           PostingRunStatus @default(PENDING)
    journalEntryId   String?          @map("journal_entry_id")
    startedAt        DateTime         @default(now()) @map("started_at")
    finishedAt       DateTime?        @map("finished_at")
    runKey           String?          @map("run_key")
    errorCount       Int              @default(0) @map("error_count")
    metadata         Json?
    createdAt        DateTime         @default(now()) @map("created_at")
    updatedAt        DateTime         @updatedAt @map("updated_at")

    organization  Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
    branch        Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
    journalEntry  JournalEntry?  @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
    postingErrors PostingError[]

    @@index([orgId])
    @@index([branchId])
    @@index([sourceKey])
    @@index([sourceDocumentId])
    @@index([status])
    @@index([runKey])
    @@index([journalEntryId])
    @@index([orgId, sourceKey, sourceDocumentId])
    @@index([orgId, runKey])
    @@map("posting_runs")
}

/// A recorded error from a posting run — stored for replay and investigation.
model PostingError {
    id               String             @id @default(cuid())
    orgId            String             @map("org_id")
    branchId         String?            @map("branch_id")
    postingRunId     String?            @map("posting_run_id")
    sourceKey        String             @map("source_key")
    sourceDocumentId String?            @map("source_document_id")
    status           PostingErrorStatus @default(OPEN)
    code             String
    message          String
    details          Json?
    createdAt        DateTime           @default(now()) @map("created_at")
    updatedAt        DateTime           @updatedAt @map("updated_at")

    organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
    branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
    postingRun   PostingRun?  @relation(fields: [postingRunId], references: [id], onDelete: SetNull)

    @@index([orgId])
    @@index([branchId])
    @@index([postingRunId])
    @@index([sourceKey])
    @@index([sourceDocumentId])
    @@index([status])
    @@index([code])
    @@index([orgId, status])
    @@index([orgId, sourceKey])
    @@map("posting_errors")
}

// ── Enums (M34) ──

enum VendorBillStatus {
    DRAFT
    APPROVED
    PARTIALLY_PAID
    PAID
    OVERDUE
    CANCELLED
}

enum VendorBillSourceType {
    MANUAL_SERVICE
    GRN_LINKED
    EXPENSE
    RECURRING
    ONE_OFF_EVENT
    UTILITY
    SUBSCRIPTION
}

enum CounterpartyType {
    INVENTORY_SUPPLIER
    SERVICE_PROVIDER
    UTILITY_PROVIDER
    SUBSCRIPTION_VENDOR
    CONTRACTOR
    FREELANCER
    ENTERTAINER
    LANDLORD
    OTHER
}

enum RecurrenceCadence {
    WEEKLY
    MONTHLY
    QUARTERLY
    ANNUALLY
}

enum PayableReminderStatus {
    PENDING
    SENT
    DISMISSED
    EXPIRED
}

enum VendorPaymentStatus {
    PENDING
    POSTED
    FAILED
    CANCELLED
}

enum CreditNoteStatus {
    OPEN
    PARTIALLY_APPLIED
    FULLY_APPLIED
    VOID
}

// ── M34 Models ──

/// Vendor / supplier / counterparty used in accounts payable.
model Supplier {
    id               String           @id @default(cuid())
    orgId            String           @map("org_id")
    branchId         String?          @map("branch_id")
    name             String
    code             String?
    counterpartyType CounterpartyType @default(INVENTORY_SUPPLIER) @map("counterparty_type")
    contactName      String?          @map("contact_name")
    email            String?
    phone            String?
    address          String?
    taxId            String?          @map("tax_id")
    paymentTermDays  Int?             @map("payment_term_days")
    bankName         String?          @map("bank_name")
    bankAccountNo    String?          @map("bank_account_no")
    currencyCode     String           @default("USD") @map("currency_code")
    isActive         Boolean          @default(true) @map("is_active")
    notes            String?
    metadata         Json?
    createdAt        DateTime         @default(now()) @map("created_at")
    updatedAt        DateTime         @updatedAt @map("updated_at")

    organization      Organization           @relation(fields: [orgId], references: [id], onDelete: Cascade)
    branch            Branch?                @relation(fields: [branchId], references: [id], onDelete: SetNull)
    vendorBills       VendorBill[]
    vendorPayments    VendorPayment[]
    creditNotes       CreditNote[]
    recurringProfiles RecurringBillProfile[]
    payableReminders  PayableReminder[]      @relation("ReminderSupplier")

    @@unique([orgId, code])
    @@index([orgId])
    @@index([branchId])
    @@index([isActive])
    @@index([orgId, isActive])
    @@index([counterpartyType])
    @@index([orgId, counterpartyType])
    @@map("suppliers")
}

/// A vendor/supplier bill (payable document). Supports GRN-originated, manual, recurring, and one-off event bills.
model VendorBill {
    id                 String               @id @default(cuid())
    orgId              String               @map("org_id")
    branchId           String?              @map("branch_id")
    supplierId         String               @map("supplier_id")
    billNumber         String               @map("bill_number")
    status             VendorBillStatus     @default(DRAFT)
    sourceType         VendorBillSourceType @map("source_type")
    sourceDocumentId   String?              @map("source_document_id")
    recurringProfileId String?              @map("recurring_profile_id")
    billDate           DateTime             @map("bill_date") @db.Date
    issueDate          DateTime             @map("issue_date") @db.Date
    dueDate            DateTime             @map("due_date") @db.Date
    servicePeriodStart DateTime?            @map("service_period_start") @db.Date
    servicePeriodEnd   DateTime?            @map("service_period_end") @db.Date
    currencyCode       String               @default("USD") @map("currency_code")
    subtotal           Decimal              @default(0) @db.Decimal(12, 2)
    taxAmount          Decimal              @default(0) @map("tax_amount") @db.Decimal(12, 2)
    totalAmount        Decimal              @default(0) @map("total_amount") @db.Decimal(12, 2)
    outstandingAmount  Decimal              @default(0) @map("outstanding_amount") @db.Decimal(12, 2)
    approvedAt         DateTime?            @map("approved_at")
    approvedById       String?              @map("approved_by_id")
    notes              String?
    metadata           Json?
    createdAt          DateTime             @default(now()) @map("created_at")
    updatedAt          DateTime             @updatedAt @map("updated_at")

    organization     Organization              @relation(fields: [orgId], references: [id], onDelete: Cascade)
    branch           Branch?                   @relation(fields: [branchId], references: [id], onDelete: SetNull)
    supplier         Supplier                  @relation(fields: [supplierId], references: [id], onDelete: Restrict)
    approvedBy       User?                     @relation("VendorBillApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
    recurringProfile RecurringBillProfile?     @relation(fields: [recurringProfileId], references: [id], onDelete: SetNull)
    lines            VendorBillLine[]
    paymentAllocs    VendorPaymentAllocation[]
    reminders        PayableReminder[]         @relation("ReminderBill")

    @@unique([orgId, billNumber])
    @@index([orgId])
    @@index([branchId])
    @@index([supplierId])
    @@index([status])
    @@index([dueDate])
    @@index([sourceType])
    @@index([sourceDocumentId])
    @@index([recurringProfileId])
    @@index([orgId, status])
    @@index([orgId, supplierId, status])
    @@index([orgId, dueDate])
    @@map("vendor_bills")
}

/// A single line item within a vendor bill.
model VendorBillLine {
    id           String   @id @default(cuid())
    vendorBillId String   @map("vendor_bill_id")
    orgId        String   @map("org_id")
    description  String
    quantity     Decimal  @db.Decimal(10, 3)
    unitPrice    Decimal  @map("unit_price") @db.Decimal(12, 2)
    taxRate      Decimal  @default(0) @map("tax_rate") @db.Decimal(5, 2)
    taxAmount    Decimal  @default(0) @map("tax_amount") @db.Decimal(12, 2)
    lineTotal    Decimal  @map("line_total") @db.Decimal(12, 2)
    accountId    String?  @map("account_id")
    costCenterId String?  @map("cost_center_id")
    itemId       String?  @map("item_id")
    metadata     Json?
    createdAt    DateTime @default(now()) @map("created_at")
    updatedAt    DateTime @updatedAt @map("updated_at")

    vendorBill   VendorBill   @relation(fields: [vendorBillId], references: [id], onDelete: Cascade)
    organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

    @@index([vendorBillId])
    @@index([orgId])
    @@map("vendor_bill_lines")
}

/// An AP payment applied against one or more approved vendor bills.
model VendorPayment {
    id              String              @id @default(cuid())
    orgId           String              @map("org_id")
    branchId        String?             @map("branch_id")
    supplierId      String              @map("supplier_id")
    paymentNumber   String              @map("payment_number")
    status          VendorPaymentStatus @default(PENDING)
    paymentDate     DateTime            @map("payment_date") @db.Date
    currencyCode    String              @default("USD") @map("currency_code")
    amount          Decimal             @db.Decimal(12, 2)
    remainingAmount Decimal             @map("remaining_amount") @db.Decimal(12, 2)
    paymentMethod   String              @map("payment_method")
    reference       String?
    journalEntryId  String?             @map("journal_entry_id")
    paidById        String              @map("paid_by_id")
    notes           String?
    metadata        Json?
    createdAt       DateTime            @default(now()) @map("created_at")
    updatedAt       DateTime            @updatedAt @map("updated_at")

    organization Organization              @relation(fields: [orgId], references: [id], onDelete: Cascade)
    branch       Branch?                   @relation(fields: [branchId], references: [id], onDelete: SetNull)
    supplier     Supplier                  @relation(fields: [supplierId], references: [id], onDelete: Restrict)
    paidBy       User                      @relation("VendorPaymentPaidBy", fields: [paidById], references: [id], onDelete: Restrict)
    journalEntry JournalEntry?             @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
    allocations  VendorPaymentAllocation[]

    @@unique([orgId, paymentNumber])
    @@index([orgId])
    @@index([branchId])
    @@index([supplierId])
    @@index([status])
    @@index([paymentDate])
    @@index([orgId, supplierId])
    @@index([orgId, status])
    @@map("vendor_payments")
}

/// Tracks how much of a vendor payment was allocated to a specific bill.
model VendorPaymentAllocation {
    id              String   @id @default(cuid())
    vendorPaymentId String   @map("vendor_payment_id")
    vendorBillId    String   @map("vendor_bill_id")
    orgId           String   @map("org_id")
    amount          Decimal  @db.Decimal(12, 2)
    createdAt       DateTime @default(now()) @map("created_at")

    vendorPayment VendorPayment @relation(fields: [vendorPaymentId], references: [id], onDelete: Cascade)
    vendorBill    VendorBill    @relation(fields: [vendorBillId], references: [id], onDelete: Restrict)
    organization  Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)

    @@unique([vendorPaymentId, vendorBillId])
    @@index([vendorPaymentId])
    @@index([vendorBillId])
    @@index([orgId])
    @@map("vendor_payment_allocations")
}

/// A vendor-issued credit note. Reduces payables owed to a supplier.
model CreditNote {
    id               String           @id @default(cuid())
    orgId            String           @map("org_id")
    branchId         String?          @map("branch_id")
    supplierId       String           @map("supplier_id")
    creditNoteNumber String           @map("credit_note_number")
    status           CreditNoteStatus @default(OPEN)
    issueDate        DateTime         @map("issue_date") @db.Date
    expiryDate       DateTime?        @map("expiry_date") @db.Date
    currencyCode     String           @default("USD") @map("currency_code")
    totalAmount      Decimal          @map("total_amount") @db.Decimal(12, 2)
    appliedAmount    Decimal          @default(0) @map("applied_amount") @db.Decimal(12, 2)
    remainingAmount  Decimal          @map("remaining_amount") @db.Decimal(12, 2)
    sourceBillId     String?          @map("source_bill_id")
    reason           String?
    notes            String?
    metadata         Json?
    createdAt        DateTime         @default(now()) @map("created_at")
    updatedAt        DateTime         @updatedAt @map("updated_at")

    organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
    branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
    supplier     Supplier     @relation(fields: [supplierId], references: [id], onDelete: Restrict)

    @@unique([orgId, creditNoteNumber])
    @@index([orgId])
    @@index([branchId])
    @@index([supplierId])
    @@index([status])
    @@index([issueDate])
    @@index([orgId, supplierId])
    @@index([orgId, status])
    @@map("credit_notes")
}

/// A recurring bill profile for periodic obligations (rent, utilities, subscriptions, cleaning, etc.).
model RecurringBillProfile {
    id                  String               @id @default(cuid())
    orgId               String               @map("org_id")
    branchId            String?              @map("branch_id")
    supplierId          String               @map("supplier_id")
    profileName         String               @map("profile_name")
    cadence             RecurrenceCadence
    expectedAmount      Decimal              @map("expected_amount") @db.Decimal(12, 2)
    currencyCode        String               @default("USD") @map("currency_code")
    nextDueDate         DateTime             @map("next_due_date") @db.Date
    leadDays            Int                  @default(7) @map("lead_days")
    startDate           DateTime?            @map("start_date") @db.Date
    endDate             DateTime?            @map("end_date") @db.Date
    sourceType          VendorBillSourceType @default(RECURRING) @map("source_type")
    description         String?
    isActive            Boolean              @default(true) @map("is_active")
    lastGeneratedAt     DateTime?            @map("last_generated_at")
    lastGeneratedBillId String?              @map("last_generated_bill_id")
    notes               String?
    metadata            Json?
    createdAt           DateTime             @default(now()) @map("created_at")
    updatedAt           DateTime             @updatedAt @map("updated_at")

    organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
    branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
    supplier     Supplier     @relation(fields: [supplierId], references: [id], onDelete: Restrict)
    vendorBills  VendorBill[]

    @@index([orgId])
    @@index([branchId])
    @@index([supplierId])
    @@index([isActive])
    @@index([cadence])
    @@index([nextDueDate])
    @@index([orgId, isActive])
    @@index([orgId, branchId, cadence])
    @@index([orgId, nextDueDate])
    @@map("recurring_bill_profiles")
}

/// A payable reminder for upcoming due dates or service-period expirations.
model PayableReminder {
    id            String                @id @default(cuid())
    orgId         String                @map("org_id")
    branchId      String?               @map("branch_id")
    supplierId    String?               @map("supplier_id")
    vendorBillId  String?               @map("vendor_bill_id")
    status        PayableReminderStatus @default(PENDING)
    remindAt      DateTime              @map("remind_at")
    dueDate       DateTime              @map("due_date") @db.Date
    title         String
    description   String?
    dismissedAt   DateTime?             @map("dismissed_at")
    dismissedById String?               @map("dismissed_by_id")
    metadata      Json?
    createdAt     DateTime              @default(now()) @map("created_at")
    updatedAt     DateTime              @updatedAt @map("updated_at")

    organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
    branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
    supplier     Supplier?    @relation("ReminderSupplier", fields: [supplierId], references: [id], onDelete: SetNull)
    vendorBill   VendorBill?  @relation("ReminderBill", fields: [vendorBillId], references: [id], onDelete: SetNull)
    dismissedBy  User?        @relation("ReminderDismissedBy", fields: [dismissedById], references: [id], onDelete: SetNull)

    @@index([orgId])
    @@index([branchId])
    @@index([supplierId])
    @@index([vendorBillId])
    @@index([status])
    @@index([remindAt])
    @@index([dueDate])
    @@index([orgId, status, remindAt])
    @@index([orgId, branchId, status])
    @@map("payable_reminders")
}

// ═══════════════════════════════════════════════════════════════════
// M35 — Accounts Receivable + Invoicing + Direct Bill
// ═══════════════════════════════════════════════════════════════════

// ── Enums (M35) ──

enum CustomerAccountStatus {
    ACTIVE
    INACTIVE
    SUSPENDED
}

enum CustomerAccountType {
    CORPORATE
    HOUSE
    INDIVIDUAL
}

enum InvoiceStatus {
    DRAFT
    ISSUED
    PARTIALLY_PAID
    PAID
    CANCELLED
    CREDIT_ADJUSTED
}

enum InvoiceSourceType {
    DIRECT_BILL
    EVENT
    RESERVATION
    CORPORATE
    MANUAL
}

enum ReceiptStatus {
    PENDING
    POSTED
    FAILED
    CANCELLED
    REVERSED
}

enum ArCreditNoteStatus {
    OPEN
    PARTIALLY_APPLIED
    FULLY_APPLIED
    VOID
}

// ── M35 Models ──

/// Customer/house/corporate billing account for AR. Tracks open balance and billing identity.
model CustomerAccount {
    id           String                @id @default(cuid())
    orgId        String                @map("org_id")
    branchId     String?               @map("branch_id")
    name         String
    code         String?
    type         CustomerAccountType   @default(INDIVIDUAL)
    status       CustomerAccountStatus @default(ACTIVE)
    contactName  String?               @map("contact_name")
    email        String?
    phone        String?
    address      String?
    taxId        String?               @map("tax_id")
    currencyCode String                @default("USD") @map("currency_code")
    creditLimit  Decimal?              @map("credit_limit") @db.Decimal(12, 2)
    openBalance  Decimal               @default(0) @map("open_balance") @db.Decimal(12, 2)
    notes        String?
    metadata     Json?
    createdById  String                @map("created_by_id")
    createdAt    DateTime              @default(now()) @map("created_at")
    updatedAt    DateTime              @updatedAt @map("updated_at")

    organization Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
    branch       Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
    createdBy    User           @relation("CustomerAccountCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
    invoices     Invoice[]
    receipts     ArReceipt[]
    creditNotes  ArCreditNote[]

    @@unique([orgId, code])
    @@index([orgId])
    @@index([branchId])
    @@index([type])
    @@index([status])
    @@index([orgId, status])
    @@index([orgId, type, status])
    @@map("customer_accounts")
}

/// AR invoice document. Supports direct-bill, corporate, event, and reservation billing.
/// Line items are frozen snapshots so later source edits do not corrupt AR history.
model Invoice {
    id                 String            @id @default(cuid())
    orgId              String            @map("org_id")
    branchId           String?           @map("branch_id")
    customerAccountId  String            @map("customer_account_id")
    invoiceNumber      String            @map("invoice_number")
    status             InvoiceStatus     @default(DRAFT)
    sourceType         InvoiceSourceType @default(MANUAL) @map("source_type")
    sourceDocumentId   String?           @map("source_document_id")
    invoiceDate        DateTime          @map("invoice_date") @db.Date
    issueDate          DateTime?         @map("issue_date") @db.Date
    dueDate            DateTime          @map("due_date") @db.Date
    currencyCode       String            @default("USD") @map("currency_code")
    subtotal           Decimal           @default(0) @db.Decimal(12, 2)
    taxAmount          Decimal           @default(0) @map("tax_amount") @db.Decimal(12, 2)
    totalAmount        Decimal           @default(0) @map("total_amount") @db.Decimal(12, 2)
    outstandingBalance Decimal           @default(0) @map("outstanding_balance") @db.Decimal(12, 2)
    issuedAt           DateTime?         @map("issued_at")
    issuedById         String?           @map("issued_by_id")
    notes              String?
    metadata           Json?
    createdById        String            @map("created_by_id")
    createdAt          DateTime          @default(now()) @map("created_at")
    updatedAt          DateTime          @updatedAt @map("updated_at")

    organization    Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
    branch          Branch?             @relation(fields: [branchId], references: [id], onDelete: SetNull)
    customerAccount CustomerAccount     @relation(fields: [customerAccountId], references: [id], onDelete: Restrict)
    issuedBy        User?               @relation("InvoiceIssuedBy", fields: [issuedById], references: [id], onDelete: SetNull)
    createdBy       User                @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
    lines           InvoiceLine[]
    receiptAllocs   ReceiptAllocation[]
    creditNotes     ArCreditNote[]

    @@unique([orgId, invoiceNumber])
    @@index([orgId])
    @@index([branchId])
    @@index([customerAccountId])
    @@index([status])
    @@index([dueDate])
    @@index([sourceType])
    @@index([sourceDocumentId])
    @@index([orgId, status])
    @@index([orgId, customerAccountId, status])
    @@index([orgId, dueDate])
    @@index([orgId, customerAccountId, dueDate])
    @@map("invoices")
}

/// Frozen line snapshot within an AR invoice.
model InvoiceLine {
    id           String   @id @default(cuid())
    invoiceId    String   @map("invoice_id")
    orgId        String   @map("org_id")
    description  String
    quantity     Decimal  @db.Decimal(10, 3)
    unitPrice    Decimal  @map("unit_price") @db.Decimal(12, 2)
    taxRate      Decimal  @default(0) @map("tax_rate") @db.Decimal(5, 2)
    taxAmount    Decimal  @default(0) @map("tax_amount") @db.Decimal(12, 2)
    lineTotal    Decimal  @map("line_total") @db.Decimal(12, 2)
    accountId    String?  @map("account_id")
    costCenterId String?  @map("cost_center_id")
    metadata     Json?
    createdAt    DateTime @default(now()) @map("created_at")
    updatedAt    DateTime @updatedAt @map("updated_at")

    invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
    organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

    @@index([invoiceId])
    @@index([orgId])
    @@map("invoice_lines")
}

/// Customer receipt document. Represents an incoming payment from a customer.
model ArReceipt {
    id                String        @id @default(cuid())
    orgId             String        @map("org_id")
    branchId          String?       @map("branch_id")
    customerAccountId String        @map("customer_account_id")
    receiptNumber     String        @map("receipt_number")
    status            ReceiptStatus @default(PENDING)
    receiptDate       DateTime      @map("receipt_date") @db.Date
    currencyCode      String        @default("USD") @map("currency_code")
    amount            Decimal       @db.Decimal(12, 2)
    remainingAmount   Decimal       @default(0) @map("remaining_amount") @db.Decimal(12, 2)
    paymentMethod     String        @map("payment_method")
    reference         String?
    journalEntryId    String?       @map("journal_entry_id")
    receivedById      String        @map("received_by_id")
    notes             String?
    metadata          Json?
    createdAt         DateTime      @default(now()) @map("created_at")
    updatedAt         DateTime      @updatedAt @map("updated_at")

    organization    Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
    branch          Branch?             @relation(fields: [branchId], references: [id], onDelete: SetNull)
    customerAccount CustomerAccount     @relation(fields: [customerAccountId], references: [id], onDelete: Restrict)
    receivedBy      User                @relation("ArReceiptReceivedBy", fields: [receivedById], references: [id], onDelete: Restrict)
    journalEntry    JournalEntry?       @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
    allocations     ReceiptAllocation[]

    @@unique([orgId, receiptNumber])
    @@index([orgId])
    @@index([branchId])
    @@index([customerAccountId])
    @@index([status])
    @@index([receiptDate])
    @@index([journalEntryId])
    @@index([orgId, status])
    @@index([orgId, customerAccountId, status])
    @@map("ar_receipts")
}

/// Allocation of a customer receipt against a specific AR invoice. Supports partial settlement.
model ReceiptAllocation {
    id              String   @id @default(cuid())
    orgId           String   @map("org_id")
    receiptId       String   @map("receipt_id")
    invoiceId       String   @map("invoice_id")
    allocatedAmount Decimal  @map("allocated_amount") @db.Decimal(12, 2)
    allocatedAt     DateTime @default(now()) @map("allocated_at")
    notes           String?
    metadata        Json?
    createdAt       DateTime @default(now()) @map("created_at")
    updatedAt       DateTime @updatedAt @map("updated_at")

    organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
    receipt      ArReceipt    @relation(fields: [receiptId], references: [id], onDelete: Cascade)
    invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

    @@index([orgId])
    @@index([receiptId])
    @@index([invoiceId])
    @@index([orgId, receiptId])
    @@index([orgId, invoiceId])
    @@map("receipt_allocations")
}

/// AR credit note issued to a customer. Supports later allocation against open invoices.
model ArCreditNote {
    id                String             @id @default(cuid())
    orgId             String             @map("org_id")
    branchId          String?            @map("branch_id")
    customerAccountId String             @map("customer_account_id")
    invoiceId         String?            @map("invoice_id")
    creditNoteNumber  String             @map("credit_note_number")
    status            ArCreditNoteStatus @default(OPEN)
    creditNoteDate    DateTime           @map("credit_note_date") @db.Date
    currencyCode      String             @default("USD") @map("currency_code")
    amount            Decimal            @db.Decimal(12, 2)
    appliedAmount     Decimal            @default(0) @map("applied_amount") @db.Decimal(12, 2)
    remainingAmount   Decimal            @map("remaining_amount") @db.Decimal(12, 2)
    reason            String?
    notes             String?
    metadata          Json?
    issuedById        String             @map("issued_by_id")
    createdAt         DateTime           @default(now()) @map("created_at")
    updatedAt         DateTime           @updatedAt @map("updated_at")

    organization    Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
    branch          Branch?         @relation(fields: [branchId], references: [id], onDelete: SetNull)
    customerAccount CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Restrict)
    invoice         Invoice?        @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
    issuedBy        User            @relation("ArCreditNoteIssuedBy", fields: [issuedById], references: [id], onDelete: Restrict)

    @@unique([orgId, creditNoteNumber])
    @@index([orgId])
    @@index([branchId])
    @@index([customerAccountId])
    @@index([invoiceId])
    @@index([status])
    @@index([creditNoteDate])
    @@index([orgId, status])
    @@index([orgId, customerAccountId, status])
    @@map("ar_credit_notes")
}

// ═══════════════════════════════════════════════════════════════════
// M36 — Bank Reconciliation + Period Close + Locks
// ═══════════════════════════════════════════════════════════════════

// ── Enums (M36) ──

enum BankStatementStatus {
    PENDING
    IMPORTED
    RECONCILED
    VOIDED
}

enum BankStatementLineStatus {
    UNMATCHED
    MATCHED
    SKIPPED
}

enum BankReconciliationStatus {
    OPEN
    IN_PROGRESS
    COMPLETED
    DISPUTED
}

enum PeriodCloseRunStatus {
    PENDING
    COMPLETED
    FAILED
}

// ── M36 Models ──

/// Bank account registered for reconciliation. One per bank account per branch.
model BankAccount {
    id           String   @id @default(cuid())
    orgId        String   @map("org_id")
    branchId     String   @map("branch_id")
    name         String
    accountCode  String   @map("account_code")
    bankName     String   @map("bank_name")
    currencyCode String   @default("UGX") @map("currency_code")
    glAccountId  String?  @map("gl_account_id")
    isActive     Boolean  @default(true) @map("is_active")
    notes        String?
    metadata     Json?
    createdAt    DateTime @default(now()) @map("created_at")
    updatedAt    DateTime @updatedAt @map("updated_at")

    organization      Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
    branch            Branch               @relation(fields: [branchId], references: [id], onDelete: Cascade)
    glAccount         Account?             @relation("BankAccountGlAccount", fields: [glAccountId], references: [id], onDelete: SetNull)
    statements        BankStatement[]
    reconciliations   BankReconciliation[]
    manualBankEntries ManualBankEntry[]

    @@unique([orgId, accountCode])
    @@index([orgId])
    @@index([branchId])
    @@index([glAccountId])
    @@index([isActive])
    @@index([orgId, branchId, isActive])
    @@map("bank_accounts")
}

/// An imported bank statement covering a date range for a bank account.
model BankStatement {
    id             String              @id @default(cuid())
    orgId          String              @map("org_id")
    branchId       String              @map("branch_id")
    bankAccountId  String              @map("bank_account_id")
    statementDate  DateTime            @map("statement_date") @db.Date
    periodStart    DateTime            @map("period_start") @db.Date
    periodEnd      DateTime            @map("period_end") @db.Date
    openingBalance Decimal             @map("opening_balance") @db.Decimal(12, 2)
    closingBalance Decimal             @map("closing_balance") @db.Decimal(12, 2)
    status         BankStatementStatus @default(PENDING)
    importedById   String              @map("imported_by_id")
    reference      String?
    notes          String?
    metadata       Json?
    createdAt      DateTime            @default(now()) @map("created_at")
    updatedAt      DateTime            @updatedAt @map("updated_at")

    organization    Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
    branch          Branch               @relation(fields: [branchId], references: [id], onDelete: Cascade)
    bankAccount     BankAccount          @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
    importedBy      User                 @relation("BankStatementImportedBy", fields: [importedById], references: [id], onDelete: Restrict)
    lines           BankStatementLine[]
    reconciliations BankReconciliation[]

    @@index([orgId])
    @@index([branchId])
    @@index([bankAccountId])
    @@index([status])
    @@index([statementDate])
    @@index([orgId, bankAccountId, status])
    @@map("bank_statements")
}

/// A single transaction line within a bank statement.
model BankStatementLine {
    id                   String                  @id @default(cuid())
    orgId                String                  @map("org_id")
    bankStatementId      String                  @map("bank_statement_id")
    txDate               DateTime                @map("tx_date") @db.Date
    description          String
    amount               Decimal                 @db.Decimal(12, 2)
    direction            JournalLineDirection
    reference            String?
    status               BankStatementLineStatus @default(UNMATCHED)
    matchedJournalLineId String?                 @map("matched_journal_line_id")
    matchedManualEntryId String?                 @map("matched_manual_entry_id")
    matchedAt            DateTime?               @map("matched_at")
    matchedById          String?                 @map("matched_by_id")
    metadata             Json?
    createdAt            DateTime                @default(now()) @map("created_at")
    updatedAt            DateTime                @updatedAt @map("updated_at")

    organization       Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
    bankStatement      BankStatement    @relation(fields: [bankStatementId], references: [id], onDelete: Cascade)
    matchedBy          User?            @relation("BankStatementLineMatchedBy", fields: [matchedById], references: [id], onDelete: SetNull)
    matchedManualEntry ManualBankEntry? @relation(fields: [matchedManualEntryId], references: [id], onDelete: SetNull)

    @@index([orgId])
    @@index([bankStatementId])
    @@index([txDate])
    @@index([status])
    @@index([matchedJournalLineId])
    @@index([matchedManualEntryId])
    @@index([bankStatementId, status])
    @@map("bank_statement_lines")
}

/// Bank reconciliation run linking a bank account to a fiscal period.
model BankReconciliation {
    id               String                   @id @default(cuid())
    orgId            String                   @map("org_id")
    branchId         String                   @map("branch_id")
    bankAccountId    String                   @map("bank_account_id")
    bankStatementId  String?                  @map("bank_statement_id")
    fiscalPeriodId   String?                  @map("fiscal_period_id")
    status           BankReconciliationStatus @default(OPEN)
    statementBalance Decimal                  @default(0) @map("statement_balance") @db.Decimal(12, 2)
    matchedTotal     Decimal                  @default(0) @map("matched_total") @db.Decimal(12, 2)
    unmatchedCount   Int                      @default(0) @map("unmatched_count")
    matchedCount     Int                      @default(0) @map("matched_count")
    startedById      String                   @map("started_by_id")
    completedAt      DateTime?                @map("completed_at")
    completedById    String?                  @map("completed_by_id")
    notes            String?
    metadata         Json?
    createdAt        DateTime                 @default(now()) @map("created_at")
    updatedAt        DateTime                 @updatedAt @map("updated_at")

    organization  Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
    branch        Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
    bankAccount   BankAccount    @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
    bankStatement BankStatement? @relation(fields: [bankStatementId], references: [id], onDelete: SetNull)
    fiscalPeriod  FiscalPeriod?  @relation(fields: [fiscalPeriodId], references: [id], onDelete: SetNull)
    startedBy     User           @relation("BankRecMatchedBy", fields: [startedById], references: [id], onDelete: Restrict)
    completedBy   User?          @relation("BankRecCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)

    @@index([orgId])
    @@index([branchId])
    @@index([bankAccountId])
    @@index([bankStatementId])
    @@index([fiscalPeriodId])
    @@index([status])
    @@index([orgId, branchId, status])
    @@index([orgId, bankAccountId, fiscalPeriodId])
    @@map("bank_reconciliations")
}

/// Tracks the execution of a period-close operation including retained earnings journal creation.
model PeriodCloseRun {
    id                             String               @id @default(cuid())
    orgId                          String               @map("org_id")
    branchId                       String?              @map("branch_id")
    fiscalPeriodId                 String               @map("fiscal_period_id")
    status                         PeriodCloseRunStatus @default(PENDING)
    retainedEarningsJournalEntryId String?              @map("retained_earnings_journal_entry_id")
    retainedEarningsAmount         Decimal?             @map("retained_earnings_amount") @db.Decimal(12, 2)
    incomeTotal                    Decimal?             @map("income_total") @db.Decimal(12, 2)
    expenseTotal                   Decimal?             @map("expense_total") @db.Decimal(12, 2)
    failureReason                  String?              @map("failure_reason")
    closedById                     String               @map("closed_by_id")
    closedAt                       DateTime             @default(now()) @map("closed_at")
    summary                        Json?
    notes                          String?
    metadata                       Json?
    createdAt                      DateTime             @default(now()) @map("created_at")
    updatedAt                      DateTime             @updatedAt @map("updated_at")

    organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
    branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
    fiscalPeriod FiscalPeriod @relation(fields: [fiscalPeriodId], references: [id], onDelete: Restrict)
    closedBy     User         @relation("PeriodCloseRunCreatedBy", fields: [closedById], references: [id], onDelete: Restrict)

    @@index([orgId])
    @@index([branchId])
    @@index([fiscalPeriodId])
    @@index([status])
    @@index([orgId, fiscalPeriodId])
    @@map("period_close_runs")
}

/// Manual bank entry created during reconciliation for missing transactions (bank charges, interest, fees, etc.)
model ManualBankEntry {
    id            String               @id @default(cuid())
    orgId         String               @map("org_id")
    branchId      String               @map("branch_id")
    bankAccountId String               @map("bank_account_id")
    txDate        DateTime             @map("tx_date") @db.Date
    amount        Decimal              @db.Decimal(12, 2)
    direction     JournalLineDirection
    description   String
    entryType     String               @map("entry_type")
    accountId     String?              @map("account_id")
    reference     String?
    notes         String?
    createdById   String               @map("created_by_id")
    metadata      Json?
    createdAt     DateTime             @default(now()) @map("created_at")
    updatedAt     DateTime             @updatedAt @map("updated_at")

    organization Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
    branch       Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
    bankAccount  BankAccount         @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
    account      Account?            @relation("ManualBankEntryAccount", fields: [accountId], references: [id], onDelete: SetNull)
    createdBy    User                @relation("ManualBankEntryCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
    matchedLines BankStatementLine[]

    @@index([orgId])
    @@index([branchId])
    @@index([bankAccountId])
    @@index([accountId])
    @@index([txDate])
    @@index([orgId, bankAccountId])
    @@map("manual_bank_entries")
}

// ─────────────────────────────────────────────────────────────────
// M37 models: Budgets + Forecasts + Procurement Advisory
// ─────────────────────────────────────────────────────────────────

// ── Enums (M37) ──

enum BudgetStatus {
    DRAFT
    ACTIVE
    FINALIZED
    ARCHIVED
}

enum BudgetType {
    OPERATIONAL
    FINANCIAL
}

enum ForecastRunStatus {
    PENDING
    RUNNING
    COMPLETED
    FAILED
}

enum ForecastType {
    BRANCH
    ROLLUP
    FRANCHISE
}

enum ProcurementSuggestionStatus {
    PENDING
    REVIEWED
    DISMISSED
    ACTIONED
}

enum DemandCalendarType {
    BRUNCH
    SPORTS_NIGHT
    DJ_NIGHT
    PRIVATE_EVENT
    HOLIDAY_RUSH
    PROMOTION
    LARGE_RESERVATION
    CUSTOM
}

enum DaypartType {
    BREAKFAST
    LUNCH
    AFTERNOON
    DINNER
    LATE_NIGHT
    ALL_DAY
}

enum ProcurementUrgency {
    MONITOR
    ORDER_NEXT_PO
    STOCK_UP_BEFORE_EVENT
    TRANSFER_FROM_BRANCH
    URGENT_LOCAL_BUY
}

// ── M37 Models ──

/// Top-level budget plan scoped to a branch + fiscal period.
model Budget {
    id             String       @id @default(cuid())
    orgId          String       @map("org_id")
    branchId       String       @map("branch_id")
    fiscalPeriodId String?      @map("fiscal_period_id")
    name           String
    budgetType     BudgetType   @default(OPERATIONAL) @map("budget_type")
    status         BudgetStatus @default(DRAFT)
    version        Int          @default(1)
    periodStart    DateTime     @map("period_start")
    periodEnd      DateTime     @map("period_end")
    totalBudget    Decimal      @default(0) @map("total_budget") @db.Decimal(14, 2)
    notes          String?
    metadata       Json?
    createdById    String       @map("created_by_id")
    updatedById    String?      @map("updated_by_id")
    createdAt      DateTime     @default(now()) @map("created_at")
    updatedAt      DateTime     @updatedAt @map("updated_at")

    organization Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
