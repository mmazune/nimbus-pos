    @@unique([orgId, userId, channel, digestType])
    @@index([orgId])
    @@index([userId])
    @@index([frequency])
    @@index([isActive])
    @@index([orgId, userId])
    @@index([orgId, digestType, isActive])
    @@map("hq_digest_subscriptions")
}

