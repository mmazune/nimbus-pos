/// Employee master record. Separate from auth User — supports staff without system login.
model Employee {
    id                    String         @id @default(cuid())
    orgId                 String         @map("org_id")
    branchId              String?        @map("branch_id")
    userId                String?        @unique @map("user_id")
    employeeCode          String         @map("employee_code")
    firstName             String         @map("first_name")
    lastName              String         @map("last_name")
    middleName            String?        @map("middle_name")
    phone                 String?
    email                 String?
    dateOfBirth           DateTime?      @map("date_of_birth")
    hireDate              DateTime       @map("hire_date")
    status                EmployeeStatus @default(ACTIVE)
    employmentType        EmploymentType @map("employment_type")
    positionId            String?        @map("position_id")
    compensationProfileId String?        @map("compensation_profile_id")
    emergencyContactName  String?        @map("emergency_contact_name")
    emergencyContactPhone String?        @map("emergency_contact_phone")
    address               Json?
    notes                 String?
    metadata              Json?
    createdAt             DateTime       @default(now()) @map("created_at")
    updatedAt             DateTime       @updatedAt @map("updated_at")

    organization         Organization           @relation(fields: [orgId], references: [id], onDelete: Cascade)
    branch               Branch?                @relation(fields: [branchId], references: [id], onDelete: SetNull)
    user                 User?                  @relation("EmployeeUser", fields: [userId], references: [id], onDelete: SetNull)
    position             Position?              @relation(fields: [positionId], references: [id], onDelete: SetNull)
    compensationProfile  CompensationProfile?   @relation(fields: [compensationProfileId], references: [id], onDelete: SetNull)
    contracts            EmploymentContract[]
    // M24 — Attendance + Leave + Shift Swaps
    attendanceRecords    AttendanceRecord[]
    leaveRequests        LeaveRequest[]         @relation("LeaveRequestEmployee")
    shiftSwapsRequested  ShiftSwapRequest[]     @relation("ShiftSwapRequester")
    shiftSwapsTargeted   ShiftSwapRequest[]     @relation("ShiftSwapTarget")
    // M25 — Scheduling + Templates + Duty Roster
    scheduleAssignments  ScheduleAssignment[]
    // M26 — Payroll Engine + Pay Runs + Payslips
    payrollAdjustments   PayrollAdjustment[]
    paySlips             PaySlip[]
    // M27 — Staff Insights + Awards + Promotion Suggestions
    insightSnapshots     StaffInsightSnapshot[]
    staffAwards          StaffAward[]
    promotionSuggestions PromotionSuggestion[]

    @@unique([orgId, employeeCode])
    @@index([orgId])
    @@index([branchId])
    @@index([userId])
    @@index([status])
    @@index([employmentType])
    @@index([positionId])
    @@index([compensationProfileId])
