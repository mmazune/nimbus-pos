// ── M40 Models — Alerts + Digests + Real-Time Owner Views ──
//
// M40 is the operational nervous system of Nimbus. It detects important
// situations from existing source-of-truth modules (inventory, shifts,
// reservations, billing, …), routes them to configured channels (email
// / SMS / Slack), persists every delivery attempt, supports retries +
// escalation, and surfaces a near-real-time owner feed.
//
// Locked rules:
//   - Owner SaaS billing payment-failure alerts are LIVE.
//   - Public diner payment-execution alerts are NOT in scope while
//     public mobile-money execution is still pending.
//   - Channel adapters are provider-agnostic: dev/mock adapters are used
//     when no live provider env is configured. Every dispatch — live or
//     mock — persists an AlertDelivery row.
//
// Models: AlertRule, AlertChannel, AlertDelivery, DigestSchedule,
// OwnerLiveEvent.
//
// Enums: AlertRuleType, AlertSeverity, AlertRuleStatus, AlertChannelType,
// AlertChannelStatus, AlertDeliveryStatus, DigestFrequency,
// DigestScheduleStatus, OwnerLiveEventType.

enum AlertRuleType {
    LOW_STOCK
    CASH_VARIANCE
    BOOKING_REMINDER
    BILLING_PAYMENT_FAILURE
    OVERDUE_VENDOR_BILL
    UPCOMING_EVENT_STOCK_RISK
    SHIFT_NOT_CLOSED
    LARGE_WASTAGE_SPIKE
    FAILED_WEBHOOK_DELIVERY
    FRANCHISE_BRANCH_AT_RISK
}

/// Groups alert rule types into operational routing buckets.
/// OPERATIONAL_IMMEDIATE → mobile/SMS; OWNER_FINANCE → email/digest;
/// BOOKING_EVENT → email/push; TECHNICAL_INTEGRATION → Slack/webhook.
enum AlertCategory {
    OPERATIONAL_IMMEDIATE
    OWNER_FINANCE
    BOOKING_EVENT
    TECHNICAL_INTEGRATION
}

/// Preferred delivery channel class for this alert rule.
/// The channel dispatcher uses this as the default intent when
/// no explicit channelCodes override is provided.
enum AlertChannelIntent {
    MOBILE_SMS
    EMAIL_DIGEST
    SLACK_WEBHOOK
    ALL_CHANNELS
}

enum AlertSeverity {
    INFO
    WARNING
    CRITICAL
}

enum AlertRuleStatus {
    ACTIVE
    DISABLED
}

enum AlertChannelType {
    EMAIL
    SMS
    SLACK
}

enum AlertChannelStatus {
    ACTIVE
    DISABLED
}

enum AlertDeliveryStatus {
    PENDING
    SENT
    FAILED
    RETRY_SCHEDULED
    RETRY_EXHAUSTED
    NON_RETRYABLE
    SKIPPED
}

enum DigestFrequency {
    DAILY
    WEEKLY
}

enum DigestScheduleStatus {
    ACTIVE
    DISABLED
}

enum OwnerLiveEventType {
    LOW_STOCK
    CASH_VARIANCE
    BOOKING_REMINDER
    BILLING_PAYMENT_FAILURE
    WASTAGE_SPIKE
    SHIFT_OPEN_LATE
    FRANCHISE_BRANCH_RISK
    INFO
}

/// A rule that watches a real source signal (inventory, shift close,
/// reservation timing, owner SaaS billing, …) and, when its threshold is
/// crossed, fans an alert out to one or more configured channels.
model AlertRule {
    id               String              @id @default(cuid())
    orgId            String              @map("org_id")
    branchId         String?             @map("branch_id")
    code             String
    name             String
    description      String?
    type             AlertRuleType
    severity         AlertSeverity       @default(WARNING)
    status           AlertRuleStatus     @default(ACTIVE)
    alertCategory    AlertCategory?      @map("alert_category")
    channelIntent    AlertChannelIntent? @map("channel_intent")
    sourceModule     String              @map("source_module")
    thresholdConfig  Json?               @map("threshold_config")
    channelCodes     String[]            @default([]) @map("channel_codes")
    escalationConfig Json?               @map("escalation_config")
    metadata         Json?
    createdAt        DateTime            @default(now()) @map("created_at")
    updatedAt        DateTime            @updatedAt @map("updated_at")

    organization Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
    branch       Branch?         @relation(fields: [branchId], references: [id], onDelete: SetNull)
    deliveries   AlertDelivery[]

    @@unique([orgId, code])
    @@index([orgId])
    @@index([branchId])
    @@index([orgId, type, status])
    @@index([orgId, alertCategory, status])
    @@index([status])
    @@map("alert_rules")
}

/// A configured destination for alert delivery (EMAIL / SMS / SLACK).
/// Provider credentials are stored in `config` as references (env keys)
/// or non-secret webhook URLs — never hard-coded secrets.
model AlertChannel {
    id        String             @id @default(cuid())
    orgId     String             @map("org_id")
    code      String
    name      String
    type      AlertChannelType
    status    AlertChannelStatus @default(ACTIVE)
    config    Json?
    metadata  Json?
    createdAt DateTime           @default(now()) @map("created_at")
    updatedAt DateTime           @updatedAt @map("updated_at")

    organization Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
    deliveries   AlertDelivery[]

    @@unique([orgId, code])
    @@index([orgId])
    @@index([orgId, type, status])
    @@index([status])
    @@map("alert_channels")
}

/// One persistent delivery attempt of an alert through a single channel.
/// Critical alerts fan out to multiple channels — that produces multiple
/// AlertDelivery rows, one per channel. Retries update the same row's
/// `attemptCount` / `status` / `lastError`.
model AlertDelivery {
    id            String              @id @default(cuid())
    orgId         String              @map("org_id")
    ruleId        String?             @map("rule_id")
    channelId     String              @map("channel_id")
    alertType     String              @map("alert_type")
    severity      AlertSeverity       @default(WARNING)
    status        AlertDeliveryStatus @default(PENDING)
    attemptCount  Int                 @default(0) @map("attempt_count")
    maxAttempts   Int                 @default(3) @map("max_attempts")
    payload       Json
    lastError     String?             @map("last_error")
    failureReason String?             @map("failure_reason")
    dedupeKey     String?             @map("dedupe_key")
    sentAt        DateTime?           @map("sent_at")
    nextRetryAt   DateTime?           @map("next_retry_at")
    isTest        Boolean             @default(false) @map("is_test")
    triggeredById String?             @map("triggered_by_id")
    createdAt     DateTime            @default(now()) @map("created_at")
    updatedAt     DateTime            @updatedAt @map("updated_at")

    organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
    rule         AlertRule?   @relation(fields: [ruleId], references: [id], onDelete: SetNull)
    channel      AlertChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

    @@unique([orgId, dedupeKey, channelId])
    @@index([orgId])
    @@index([ruleId])
    @@index([channelId])
    @@index([orgId, status, createdAt])
    @@index([status])
    @@index([nextRetryAt])
    @@map("alert_deliveries")
}

/// Scheduled digest definition — daily / weekly summaries that aggregate
/// existing source signals (low stock, cash variance, billing risk,
/// upcoming bookings, …) and dispatch through configured channels.
model DigestSchedule {
    id           String               @id @default(cuid())
    orgId        String               @map("org_id")
    branchId     String?              @map("branch_id")
    code         String
    name         String
    description  String?
    digestType   String               @map("digest_type")
    frequency    DigestFrequency      @default(DAILY)
    hourLocal    Int                  @default(7) @map("hour_local")
    dayOfWeek    Int?                 @map("day_of_week")
    timezone     String               @default("UTC")
    channelCodes String[]             @default([]) @map("channel_codes")
    status       DigestScheduleStatus @default(ACTIVE)
    lastRunAt    DateTime?            @map("last_run_at")
    nextRunAt    DateTime?            @map("next_run_at")
    metadata     Json?
    createdAt    DateTime             @default(now()) @map("created_at")
    updatedAt    DateTime             @updatedAt @map("updated_at")

    organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
    branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)

    @@unique([orgId, code])
    @@index([orgId])
    @@index([branchId])
    @@index([orgId, frequency, status])
    @@index([status])
    @@map("digest_schedules")
}

/// Append-only log of recent operational events surfaced on the owner
/// live feed. Lightweight projection over already-existing source rows;
/// newer entries supersede older ones in the GET /owner/live response.
model OwnerLiveEvent {
    id           String             @id @default(cuid())
    orgId        String             @map("org_id")
    branchId     String?            @map("branch_id")
    type         OwnerLiveEventType
    severity     AlertSeverity      @default(INFO)
    title        String
    message      String?
    sourceModule String             @map("source_module")
    sourceRef    String?            @map("source_ref")
    payload      Json?
    createdAt    DateTime           @default(now()) @map("created_at")

    organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
    branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)

    @@index([orgId, createdAt])
    @@index([orgId, branchId, type, createdAt])
    @@index([orgId, severity, createdAt])
    @@map("owner_live_events")
}

// ══════════════════════════════════════════════════════════════════════
// M41 — Reliability Layer (Idempotency + Offline Contracts + Sync)
// ══════════════════════════════════════════════════════════════════════

enum IdempotencyStatus {
    IN_FLIGHT
    SUCCEEDED
    FAILED
    CONFLICT
}

enum SyncJobType {
    ORDER_DRAFT_UPDATE
    ORDER_SUBMIT
    PAYMENT_CAPTURE
    REFUND_CREATE
    AR_RECEIPT_CREATE
    AP_PAYMENT_CREATE
    RESERVATION_HOLD
    RESERVATION_CONFIRM
    EVENT_BOOKING_HOLD
    EVENT_BOOKING_CONFIRM
    STOCK_ADJUSTMENT
    ATTENDANCE_EVENT
    SHIFT_ACTION
    GENERIC_REPLAY
}

enum SyncJobStatus {
    QUEUED
    IN_PROGRESS
    SUCCEEDED
    FAILED
    RETRYABLE
    CONFLICT
    CANCELLED
}

enum SyncJobOrigin {
    OFFLINE_CLIENT
    SERVICE_WORKER
    SUPPORT_REPLAY
    SYSTEM_RETRY
}

enum SyncConflictStatus {
    OPEN
    RESOLVED
    DISMISSED
}

enum SyncConflictResolution {
    SERVER_TRUTH_KEPT
    CLIENT_PAYLOAD_APPLIED
    MANUAL_MERGE
    DISCARDED
}

enum RetryDisposition {
    RETRYABLE
    PERMANENT_FAILURE
    CONFLICT
    DUPLICATE_SUPPRESSED
}

/// Generic idempotency record. Captures actor + endpoint + key + request hash and
/// the linked result so that repeated requests with the same key and same payload
/// return the same effective response. A repeat with a *different* payload is a
/// conflict and must be rejected.
model IdempotencyKey {
    id             String            @id @default(cuid())
    orgId          String?           @map("org_id")
    actorUserId    String?           @map("actor_user_id")
    routeMethod    String            @map("route_method")
    routePath      String            @map("route_path")
    scope          String            @default("default")
    key            String
    requestHash    String            @map("request_hash")
    status         IdempotencyStatus @default(IN_FLIGHT)
    statusCode     Int?              @map("status_code")
    responseBody   Json?             @map("response_body")
    responseRef    String?           @map("response_ref")
    failureSummary String?           @map("failure_summary")
    expiresAt      DateTime?         @map("expires_at")
    completedAt    DateTime?         @map("completed_at")
    createdAt      DateTime          @default(now()) @map("created_at")
    updatedAt      DateTime          @updatedAt @map("updated_at")

    organization Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)

    @@unique([scope, key, routeMethod, routePath])
    @@index([orgId, actorUserId, routePath])
    @@index([status, createdAt])
    @@index([expiresAt])
    @@map("idempotency_keys")
}

/// A queued offline-safe write job. Created by a client / service-worker that
/// captured the user intent while offline (or by a support tool replaying a
/// failed write) and is later replayed against the live service. Replay always
/// invokes the existing domain service — SyncJob never reimplements business
/// rules.
model SyncJob {
    id               String        @id @default(cuid())
    orgId            String        @map("org_id")
    branchId         String?       @map("branch_id")
    actorUserId      String?       @map("actor_user_id")
    type             SyncJobType
    status           SyncJobStatus @default(QUEUED)
    origin           SyncJobOrigin @default(OFFLINE_CLIENT)
    clientMutationId String        @map("client_mutation_id")
    idempotencyKey   String?       @map("idempotency_key")
    routeMethod      String?       @map("route_method")
    routePath        String?       @map("route_path")
    requestBody      Json          @map("request_body")
    requestHeaders   Json?         @map("request_headers")
    intentSummary    String?       @map("intent_summary")
    capturedAt       DateTime      @map("captured_at")
    queuedAt         DateTime      @default(now()) @map("queued_at")
    lastAttemptAt    DateTime?     @map("last_attempt_at")
    nextRetryAt      DateTime?     @map("next_retry_at")
    completedAt      DateTime?     @map("completed_at")
    attemptCount     Int           @default(0) @map("attempt_count")
    maxAttempts      Int           @default(5) @map("max_attempts")
    resultRef        String?       @map("result_ref")
    resultSummary    Json?         @map("result_summary")
    lastError        String?       @map("last_error")
    failureReason    String?       @map("failure_reason")
    metadata         Json?
    createdAt        DateTime      @default(now()) @map("created_at")
    updatedAt        DateTime      @updatedAt @map("updated_at")

    organization Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
    branch       Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
    attempts     SyncJobAttempt[]
    conflicts    SyncConflict[]

    @@unique([orgId, clientMutationId])
    @@index([orgId, status, type, createdAt])
    @@index([orgId, branchId, status])
    @@index([status, nextRetryAt])
    @@index([type])
    @@map("sync_jobs")
}

/// Per-attempt audit record for a SyncJob replay. Preserves the disposition
/// (retryable vs permanent vs conflict) and any error payload.
model SyncJobAttempt {
    id          String           @id @default(cuid())
    jobId       String           @map("job_id")
    attemptNo   Int              @map("attempt_no")
    startedAt   DateTime         @default(now()) @map("started_at")
    finishedAt  DateTime?        @map("finished_at")
    disposition RetryDisposition @default(RETRYABLE)
    statusCode  Int?             @map("status_code")
    error       String?
    metadata    Json?

    job SyncJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

    @@unique([jobId, attemptNo])
    @@index([jobId])
    @@index([disposition])
    @@map("sync_job_attempts")
}

/// Captures a server-vs-client divergence detected during sync replay.
/// Server truth is preferred but the conflict record keeps the client's
/// attempted payload, the server state at decision time, the chosen
/// resolution, and a free-form diff summary so it stays auditable.
model SyncConflict {
    id             String                  @id @default(cuid())
    orgId          String                  @map("org_id")
    jobId          String?                 @map("job_id")
    type           SyncJobType
    status         SyncConflictStatus      @default(OPEN)
    resolution     SyncConflictResolution? @map("resolution")
    targetEntity   String?                 @map("target_entity")
    targetEntityId String?                 @map("target_entity_id")
    clientPayload  Json                    @map("client_payload")
    serverState    Json                    @map("server_state")
    diffSummary    String                  @map("diff_summary")
    reason         String
    detectedAt     DateTime                @default(now()) @map("detected_at")
    resolvedAt     DateTime?               @map("resolved_at")
    resolvedById   String?                 @map("resolved_by_id")
    resolutionNote String?                 @map("resolution_note")
    createdAt      DateTime                @default(now()) @map("created_at")
    updatedAt      DateTime                @updatedAt @map("updated_at")

    organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
    job          SyncJob?     @relation(fields: [jobId], references: [id], onDelete: SetNull)

    @@index([orgId, status, createdAt])
    @@index([orgId, jobId])
    @@index([type])
    @@map("sync_conflicts")
}

// ----------------------------------------------------------------------
// M42 — Feature Flags + Maintenance Windows + Training Mode
// ----------------------------------------------------------------------
//
// Operational control plane for staged rollout, demo safety, and training
// / sandbox modes. The primitives are deliberately small:
//
//   - FeatureFlag        — named switch with scope (GLOBAL/ORG/BRANCH).
//   - MaintenanceWindow  — time-bounded window that may BLOCK_WRITES
//                          for a set of WriteBlockCategory values.
//   - TrainingSession    — explicit sandbox session that prevents real
//                          posting to accounting / inventory tables.
//   - FlagAudit          — append-only audit of control-plane changes
//                          and any blocks emitted by the control plane.
//
// Locked rules:
//   - Training mode must NEVER post to real accounting or inventory tables.
//     The control-plane facade short-circuits flagged write surfaces.
//   - Maintenance windows can optionally block writes by category.
//   - No hotel / property-group concept is introduced.

enum FeatureFlagScope {
    GLOBAL
    ORG
    BRANCH
}

enum FeatureFlagStatus {
    ENABLED
    DISABLED
    ARCHIVED
}

enum MaintenanceWindowStatus {
    SCHEDULED
    ACTIVE
    COMPLETED
    CANCELLED
}

enum MaintenanceWindowMode {
    ANNOUNCEMENT_ONLY
    BLOCK_WRITES
}

enum WriteBlockCategory {
    BILLING_WRITES
    INVENTORY_WRITES
    ACCOUNTING_WRITES
    PUBLIC_BOOKING_WRITES
    ADMIN_CONFIGURATION_WRITES
    ALL_WRITES
}

enum TrainingSessionStatus {
    ACTIVE
    COMPLETED
    EXPIRED
    CANCELLED
}

enum TrainingSessionMode {
    SANDBOX_ISOLATED
    SIMULATION_ONLY
}

enum FlagAuditAction {
    FLAG_CREATED
    FLAG_UPDATED
    FLAG_ENABLED
    FLAG_DISABLED
    FLAG_ARCHIVED
    MAINTENANCE_WINDOW_CREATED
    MAINTENANCE_WINDOW_UPDATED
    MAINTENANCE_WINDOW_ACTIVATED
    MAINTENANCE_WINDOW_DEACTIVATED
    TRAINING_SESSION_STARTED
    TRAINING_SESSION_ENDED
    WRITE_BLOCKED_BY_MAINTENANCE
    REAL_POST_BLOCKED_BY_TRAINING
}

/// A named feature switch. Scope determines whether the switch applies
/// globally, to a specific org, or to a specific branch (most-specific
/// scope wins at resolution time). Targeting metadata lives in `targeting`
/// (JSON) for forward-compat experiments without requiring a migration.
model FeatureFlag {
    id             String            @id @default(cuid())
    key            String
    name           String
    description    String?
    scope          FeatureFlagScope  @default(ORG)
    orgId          String?           @map("org_id")
    branchId       String?           @map("branch_id")
    status         FeatureFlagStatus @default(DISABLED)
    rolloutPercent Int               @default(0) @map("rollout_percent")
    targeting      Json?
    metadata       Json?
    createdById    String?           @map("created_by_id")
    updatedById    String?           @map("updated_by_id")
    createdAt      DateTime          @default(now()) @map("created_at")
    updatedAt      DateTime          @updatedAt @map("updated_at")

    organization Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
    branch       Branch?       @relation(fields: [branchId], references: [id], onDelete: Cascade)
    audits       FlagAudit[]

    @@unique([scope, key, orgId, branchId])
    @@index([key])
    @@index([orgId, status])
    @@index([branchId, status])
    @@index([scope, status])
    @@map("feature_flags")
}

/// A time-bounded operational window. When `mode` is BLOCK_WRITES and the
/// current time is between startsAt/endsAt while status is ACTIVE, the
/// control-plane facade refuses writes whose category appears in
/// `blockCategories`. ANNOUNCEMENT_ONLY windows are advisory only.
model MaintenanceWindow {
    id              String                  @id @default(cuid())
    orgId           String?                 @map("org_id")
    branchId        String?                 @map("branch_id")
    code            String
    title           String
    message         String?
    mode            MaintenanceWindowMode   @default(ANNOUNCEMENT_ONLY)
    status          MaintenanceWindowStatus @default(SCHEDULED)
    blockCategories WriteBlockCategory[]    @default([]) @map("block_categories")
    startsAt        DateTime                @map("starts_at")
    endsAt          DateTime                @map("ends_at")
    activatedAt     DateTime?               @map("activated_at")
    deactivatedAt   DateTime?               @map("deactivated_at")
    createdById     String?                 @map("created_by_id")
    updatedById     String?                 @map("updated_by_id")
    metadata        Json?
    createdAt       DateTime                @default(now()) @map("created_at")
    updatedAt       DateTime                @updatedAt @map("updated_at")

    organization Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
    branch       Branch?       @relation(fields: [branchId], references: [id], onDelete: Cascade)
    audits       FlagAudit[]

    @@unique([orgId, code])
    @@index([orgId, status, startsAt])
    @@index([branchId, status])
    @@index([status, startsAt, endsAt])
    @@map("maintenance_windows")
}

/// A safe sandbox / training session. While ACTIVE for an actor, eligible
/// write surfaces short-circuit into a simulated response and never persist
/// real accounting / inventory rows. The session is explicitly time-bounded
/// (`expiresAt`) and auditable.
model TrainingSession {
    id          String                @id @default(cuid())
    orgId       String                @map("org_id")
    branchId    String?               @map("branch_id")
    actorUserId String                @map("actor_user_id")
    label       String
    purpose     String?
    mode        TrainingSessionMode   @default(SIMULATION_ONLY)
    status      TrainingSessionStatus @default(ACTIVE)
    startedAt   DateTime              @default(now()) @map("started_at")
    expiresAt   DateTime              @map("expires_at")
    endedAt     DateTime?             @map("ended_at")
    endedById   String?               @map("ended_by_id")
    metadata    Json?
    createdAt   DateTime              @default(now()) @map("created_at")
    updatedAt   DateTime              @updatedAt @map("updated_at")

    organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
    branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)

    @@index([orgId, status, createdAt])
    @@index([orgId, branchId, status])
    @@index([actorUserId, status])
    @@index([expiresAt])
    @@map("training_sessions")
}

/// Append-only audit trail for control-plane changes (flag CRUD,
/// maintenance lifecycle, training start/end) and for blocks emitted
/// by the control-plane facade (e.g. WRITE_BLOCKED_BY_MAINTENANCE,
/// REAL_POST_BLOCKED_BY_TRAINING).
model FlagAudit {
    id                  String          @id @default(cuid())
    orgId               String?         @map("org_id")
    action              FlagAuditAction
    flagId              String?         @map("flag_id")
    maintenanceWindowId String?         @map("maintenance_window_id")
    trainingSessionId   String?         @map("training_session_id")
    actorUserId         String?         @map("actor_user_id")
    beforeState         Json?           @map("before_state")
    afterState          Json?           @map("after_state")
    note                String?
    metadata            Json?
    createdAt           DateTime        @default(now()) @map("created_at")

    organization Organization?      @relation(fields: [orgId], references: [id], onDelete: Cascade)
    flag         FeatureFlag?       @relation(fields: [flagId], references: [id], onDelete: SetNull)
    window       MaintenanceWindow? @relation(fields: [maintenanceWindowId], references: [id], onDelete: SetNull)

    @@index([orgId, createdAt])
    @@index([flagId, createdAt])
    @@index([maintenanceWindowId, createdAt])
    @@index([action, createdAt])
    @@map("flag_audits")
}

// ── BG1 Models — Invitation Acceptance + Password Lifecycle ──

enum InvitationStatus {
    PENDING
    ACCEPTED
    REVOKED
    EXPIRED
}

enum PasswordResetPurpose {
    FORGOT_PASSWORD
    INVITATION_FIRST_LOGIN
    FORCE_RESET_BY_ADMIN
}

/// BG1 — Tracked invitation row (replaces stateless tokens from M39.2 onboarding).
/// Persisted so resend / revoke / accept can be audited and idempotent.
/// FK columns reference users/orgs/branches/roles at the DB level; no Prisma
/// back-relations are declared to keep the User/Org/Branch/Role models stable.
model Invitation {
    id             String           @id @default(cuid())
    organizationId String           @map("organization_id")
    branchId       String           @map("branch_id")
    roleId         String           @map("role_id")
    email          String
    firstName      String?          @map("first_name")
    lastName       String?          @map("last_name")
    tokenHash      String           @unique @map("token_hash")
    status         InvitationStatus @default(PENDING)
    expiresAt      DateTime         @map("expires_at")
    acceptedAt     DateTime?        @map("accepted_at")
    acceptedById   String?          @map("accepted_by_id")
    revokedAt      DateTime?        @map("revoked_at")
    revokedById    String?          @map("revoked_by_id")
    revokedReason  String?          @map("revoked_reason")
    resendCount    Int              @default(0) @map("resend_count")
    lastResentAt   DateTime?        @map("last_resent_at")
    invitedById    String           @map("invited_by_id")
    membershipId   String?          @map("membership_id")
    userId         String?          @map("user_id")
    metadata       Json?
    createdAt      DateTime         @default(now()) @map("created_at")
    updatedAt      DateTime         @updatedAt @map("updated_at")

    @@index([organizationId, status])
    @@index([branchId])
    @@index([email])
    @@map("invitations")
}

/// BG1 — Single-use password reset / first-login token.
/// Token value is hashed (SHA-256) before persistence.
model PasswordResetToken {
    id            String               @id @default(cuid())
    userId        String               @map("user_id")
    tokenHash     String               @unique @map("token_hash")
    purpose       PasswordResetPurpose @default(FORGOT_PASSWORD)
    expiresAt     DateTime             @map("expires_at")
    consumedAt    DateTime?            @map("consumed_at")
    invalidatedAt DateTime?            @map("invalidated_at")
    ipAddress     String?              @map("ip_address")
    userAgent     String?              @map("user_agent")
    metadata      Json?
    createdAt     DateTime             @default(now()) @map("created_at")

    @@index([userId, purpose])
    @@index([expiresAt])
    @@map("password_reset_tokens")
}

// ============================================================
// BG5 — Device / Printer / Terminal Registry
// ------------------------------------------------------------
// Per the BG1 Invitation pattern: FK columns reference orgs/branches at the
// DB level (enforced via the migration SQL) but no Prisma back-relations are
// declared on Organization / Branch so those models stay byte-stable. This
// is purely additive — two new models (Device, PrinterRoute) and three new
// enums (DeviceType, DeviceStatus, PrinterRouteType).
// ============================================================

enum DeviceType {
    POS_TERMINAL
    KDS_SCREEN
    PRINTER
    PAYMENT_TERMINAL_STUB
}

enum DeviceStatus {
    ACTIVE
    INACTIVE
    DISABLED
    RETIRED
}

enum PrinterRouteType {
    RECEIPT
    KITCHEN
    BAR
}

/// BG5 — Operational device registry (POS terminals, KDS screens, printers,
/// and payment-terminal stubs). One row per registered device. Physical hardware
/// integration is intentionally out of scope; this is a configuration/registry
/// surface only. `pairedToDeviceId` is a self-FK used by the terminal-pairing
/// stub to associate a PAYMENT_TERMINAL_STUB with a POS_TERMINAL.
model Device {
    id               String       @id @default(cuid())
    orgId            String       @map("org_id")
    branchId         String       @map("branch_id")
    type             DeviceType
    name             String
    station          String?
    activationCode   String       @unique @map("activation_code")
    status           DeviceStatus @default(ACTIVE)
    pairedToDeviceId String?      @map("paired_to_device_id")
    capabilities     Json?
    metadata         Json?
    lastSeenAt       DateTime?    @map("last_seen_at")
    createdAt        DateTime     @default(now()) @map("created_at")
    updatedAt        DateTime     @updatedAt @map("updated_at")

    @@unique([branchId, name])
    @@index([orgId, branchId])
    @@index([type])
    @@index([status])
    @@index([pairedToDeviceId])
    @@map("devices")
}

/// BG5 — Printer routing configuration. Maps a printer Device to a route type
/// (cashier receipt, kitchen prep, bar) optionally further qualified by station.
/// Branch-scoped. Disabling is soft (`enabled = false`) so the audit trail
/// retains the historical assignment.
model PrinterRoute {
    id        String           @id @default(cuid())
    orgId     String           @map("org_id")
    branchId  String           @map("branch_id")
    printerId String           @map("printer_id")
    routeType PrinterRouteType @map("route_type")
    station   String?
    enabled   Boolean          @default(true)
    priority  Int              @default(100)
    createdAt DateTime         @default(now()) @map("created_at")
    updatedAt DateTime         @updatedAt @map("updated_at")

    @@unique([branchId, routeType, station, printerId], name: "branch_route_station_printer_unique")
    @@index([branchId, routeType])
    @@index([printerId])
    @@map("printer_routes")
}
