    maxApiKeys          Int          @default(0) @map("max_api_keys")
    webhooksEnabled     Boolean      @default(false) @map("webhooks_enabled")
    maxWebhookEndpoints Int          @default(0) @map("max_webhook_endpoints")
    analyticsEnabled    Boolean      @default(false) @map("analytics_enabled")
    franchiseEnabled    Boolean      @default(false) @map("franchise_enabled")
    supportTier         String       @default("basic") @map("support_tier")
    limits              Json?
    sortOrder           Int          @default(0) @map("sort_order")
    createdAt           DateTime     @default(now()) @map("created_at")
    updatedAt           DateTime     @updatedAt @map("updated_at")

    subscriptions Subscription[]

    @@index([status])
    @@index([code])
    @@map("plans")
}

/// Links an organization to a plan with lifecycle state.
