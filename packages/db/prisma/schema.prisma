// ── Nimbus POS — Prisma Schema ──
// M1 models: AppConfig + SeedHistory
// M2 models: User, Role, Permission, RolePermission, UserRole, Session, RefreshToken, AuditLog
// M3 models: Organization, Branch, Membership
// M3.1 additions: QuickPinTier enum, quick PIN fields on User
// M4 models: OrgSettings, ExchangeRate
// M5 models: FloorPlan, Table + TableStatus enum
// M6 models: Category, TaxCategory, MenuItem + MenuItemType, PrepStation enums
// M6.1 models: MenuBrowseGroup, MenuBrowseSubgroup, MenuItemServing + MenuSection, ServingFormat enums
// M7 models: ModifierGroup, ModifierOption, MenuItemOnGroup
// M8 models: InventoryItem, RecipeIngredient
// M9 models: StockBatch, StockAdjustment (+ reorder fields on InventoryItem)
// M10 models: Order, OrderItem + OrderStatus, ServiceType enums
// M11 models: KdsTicket, KdsTicketItem, KdsSlaConfig + KdsTicketStatus, KdsUrgencyState enums
// M12 models: Discount + DiscountType, DiscountStatus enums
// M13.1 additions: PaymentCaptureMode, PaymentVerificationStatus enums; extended Payment, PaymentIntent, WebhookEvent fields
// M15 models: Shift, TillSession, CashMovement, ShiftCloseSummary + ShiftStatus, TillSessionStatus, CashMovementType, VarianceStatus enums
// M16 models: Reservation, ReservationDeposit, ReservationEvent + ReservationStatus, ReservationSource, ReservationDepositStatus, ReservationEventType enums
// M17 models: Event, EventTicketClass, EventBooking, EventTicket, EventCheckIn, EventAuditLog + EventStatus, EventBookingStatus, TicketStatus, TicketClassType, CheckInStatus enums
// M18 models: AnomalyRule, RiskThreshold, AnomalyEvent, StaffRiskSnapshot + AnomalyRuleStatus, AnomalyRuleType, AnomalySeverity, AnomalyEventStatus, RiskEntityType enums
// M19 models: KpiSnapshot, KpiSubscription + KpiScopeType, KpiMetricWindow, KpiSubscriptionStatus enums
// M20 models: ReportRun, ExportArtifact + ReportType, ReportWindow, ExportFormat, ReportRunStatus, ExportArtifactStatus enums
// M21 models: Feedback, FeedbackTag, NpsSummary, FeedbackRequest + FeedbackStatus, FeedbackSource, FeedbackSentiment, FeedbackRequestStatus, NpsBucket enums
// M22 models: Document, DocumentLink, StorageProviderConfig + DocumentStatus, DocumentType, DocumentLinkType, StorageProviderType enums
// M23 models: Employee, EmploymentContract, Position, CompensationProfile + EmployeeStatus, EmploymentType, ContractStatus, SalaryBasis enums
// M24 models: AttendanceRecord, LeaveRequest, ShiftSwapRequest, AttendancePolicy + AttendanceStatus, LeaveRequestStatus, LeaveType, ShiftSwapStatus enums
// M25 models: ShiftTemplate, Schedule, ScheduleAssignment, CoverageRule + ScheduleStatus, CoverageRuleStatus, CoverageSeverity enums
// M26 models: PayComponent, PayrollAdjustment, PayRun, PaySlip + PayRunStatus, PayComponentType, PaySlipStatus, PayrollAdjustmentType enums
// M27 models: StaffInsightSnapshot, StaffAward, PromotionSuggestion + StaffInsightStatus, AwardType, PromotionSuggestionStatus enums
// M28 models: Account, CostCenter, FiscalPeriod, PostingSourceMap, TaxLedgerConfig + AccountType, AccountStatus, FiscalPeriodStatus enums
// M29 models: JournalEntry, JournalLine, PostingRun, PostingError + JournalStatus, PostingRunStatus, PostingErrorStatus, JournalLineDirection enums
// M34 models: Supplier, VendorBill, VendorBillLine, VendorPayment, VendorPaymentAllocation, CreditNote + VendorBillStatus, VendorBillSourceType, VendorPaymentStatus, CreditNoteStatus enums
// M35 models: CustomerAccount, Invoice, InvoiceLine, ArReceipt, ReceiptAllocation, ArCreditNote + CustomerAccountStatus, CustomerAccountType, InvoiceStatus, InvoiceSourceType, ReceiptStatus, ArCreditNoteStatus enums
// M39 models: Plan, Subscription, UsageMeter, ApiKey, WebhookEndpoint, SupportSession, DevAdmin + PlanStatus, SubscriptionStatus, BillingCycle, UsageMetricType, ApiKeyStatus, WebhookStatus, WebhookEventType, SupportSessionStatus enums
// M40 models: AlertRule, AlertChannel, AlertDelivery, DigestSchedule, OwnerLiveEvent + AlertRuleType, AlertCategory, AlertChannelIntent, AlertSeverity, AlertRuleStatus, AlertChannelType, AlertChannelStatus, AlertDeliveryStatus, DigestFrequency, DigestScheduleStatus, OwnerLiveEventType enums
// M41 models: IdempotencyKey, SyncJob, SyncJobAttempt, SyncConflict + IdempotencyStatus, SyncJobType, SyncJobStatus, SyncJobOrigin, SyncConflictStatus, SyncConflictResolution, RetryDisposition enums
// M42 models: FeatureFlag, MaintenanceWindow, TrainingSession, FlagAudit + FeatureFlagScope, FeatureFlagStatus, MaintenanceWindowStatus, MaintenanceWindowMode, WriteBlockCategory, TrainingSessionStatus, TrainingSessionMode, FlagAuditAction enums
// All IDs use cuid2-compatible strings.

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider  = "postgresql"
    url       = env("DATABASE_URL")
    directUrl = env("DIRECT_DATABASE_URL")
}

// ── Enums (M2) ──

enum RoleLevel {
    L1
    L2
    L3
    L4
    L5
}

enum JobRole {
    OWNER
    MANAGER
    ACCOUNTANT
    PROCUREMENT
    STOCK_MANAGER
    SUPERVISOR
    CASHIER
    CHEF
    WAITER
    BARTENDER
    EVENT_MANAGER
}

enum SessionPlatform {
    WEB_BACKOFFICE
    POS_DESKTOP
    MOBILE_APP
    KDS_SCREEN
    DEV_PORTAL
    OTHER
}

enum SessionSource {
    PASSWORD
    PIN
    API_KEY
    SSO
    WEBAUTHN
}

// ── Enums (M3.1) ──

enum QuickPinTier {
    LOW_6
    HIGH_8
}

// ── Enums (M3) ──

enum OrganizationStatus {
    ACTIVE
    INACTIVE
    SUSPENDED
}

enum BranchStatus {
    ACTIVE
    INACTIVE
    CLOSED
}

enum MembershipStatus {
    ACTIVE
    INACTIVE
    SUSPENDED
}

// ── M1 Models ──

/// Key/value configuration store for system bootstrap.
model AppConfig {
    id        String   @id @default(cuid())
    key       String   @unique
    value     String
    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@map("app_config")
}

/// Records idempotent seed runs so seeds can detect prior execution.
model SeedHistory {
    id       String   @id @default(cuid())
    seedName String   @map("seed_name")
    runAt    DateTime @default(now()) @map("run_at")
    status   String   @default("completed")
    details  String?

    @@unique([seedName])
    @@map("seed_history")
}

// ── M2 Models ──

/// System user. Supports email/password, optional PIN login, and quick PIN login.
model User {
    id           String   @id @default(cuid())
    email        String   @unique
    passwordHash String   @map("password_hash")
    pinHash      String?  @map("pin_hash")
    firstName    String   @map("first_name")
    lastName     String   @map("last_name")
    isActive     Boolean  @default(true) @map("is_active")
    createdAt    DateTime @default(now()) @map("created_at")
    updatedAt    DateTime @updatedAt @map("updated_at")

    // M3.1 — Quick PIN Login fields
    displayName        String?       @map("display_name")
    employeeCode       String?       @map("employee_code")
    quickPinHash       String?       @map("quick_pin_hash")
    pinLookupHash      String?       @unique @map("pin_lookup_hash")
    pinLength          Int?          @map("pin_length")
    pinTier            QuickPinTier? @map("pin_tier")
    quickPinEnabled    Boolean       @default(false) @map("quick_pin_enabled")
    lastPinChangedAt   DateTime?     @map("last_pin_changed_at")
    pinLockedUntil     DateTime?     @map("pin_locked_until")
    failedPinAttempts  Int           @default(0) @map("failed_pin_attempts")
    avatarUrl          String?       @map("avatar_url")
    quickPinIssuedAt   DateTime?     @map("quick_pin_issued_at")
    quickPinIssuedById String?       @map("quick_pin_issued_by_id")

    // BG1 — Invitation Acceptance + Password Lifecycle
    mustChangePassword Boolean @default(false) @map("must_change_password")

    // Relations
    userRoles                      UserRole[]
    sessions                       Session[]
    refreshTokens                  RefreshToken[]
    auditLogs                      AuditLog[]                  @relation("AuditActor")
    memberships                    Membership[]
    stockAdjustments               StockAdjustment[]
    orders                         Order[]
    discountsCreated               Discount[]                  @relation("DiscountCreatedBy")
    discountsApproved              Discount[]                  @relation("DiscountApprovedBy")
    discountsRejected              Discount[]                  @relation("DiscountRejectedBy")
    paymentsEntered                Payment[]                   @relation("PaymentEnteredBy")
    refundsCreated                 Refund[]                    @relation("RefundCreatedBy")
    refundsApproved                Refund[]                    @relation("RefundApprovedBy")
    shiftsOpened                   Shift[]                     @relation("ShiftOpenedBy")
    shiftsClosed                   Shift[]                     @relation("ShiftClosedBy")
    tillsOperated                  TillSession[]               @relation("TillOperator")
    tillsOpened                    TillSession[]               @relation("TillOpenedBy")
    tillsClosed                    TillSession[]               @relation("TillClosedBy")
    cashMovementsCreated           CashMovement[]              @relation("CashMovementCreatedBy")
    cashMovementsApproved          CashMovement[]              @relation("CashMovementApprovedBy")
    shiftSummariesGenerated        ShiftCloseSummary[]         @relation("ShiftSummaryGeneratedBy")
    reservationsCreated            Reservation[]               @relation("ReservationCreatedBy")
    reservationsUpdated            Reservation[]               @relation("ReservationUpdatedBy")
    depositsRecorded               ReservationDeposit[]        @relation("DepositRecordedBy")
    reservationEventsActed         ReservationEvent[]          @relation("ReservationEventActor")
    // M17 — Events + Booking + Ticketing
    eventsCreated                  Event[]                     @relation("EventCreatedBy")
    eventsUpdated                  Event[]                     @relation("EventUpdatedBy")
    eventBookingsBooked            EventBooking[]              @relation("EventBookingBookedBy")
    eventCheckInsActed             EventCheckIn[]              @relation("EventCheckInActor")
    eventAuditLogsActed            EventAuditLog[]             @relation("EventAuditLogActor")
    // M18 — Anomaly Detection
    anomalyRulesCreated            AnomalyRule[]               @relation("AnomalyRuleCreatedBy")
    anomalyRulesUpdated            AnomalyRule[]               @relation("AnomalyRuleUpdatedBy")
    anomalyEventsActed             AnomalyEvent[]              @relation("AnomalyEventActor")
    anomalyEventsAcked             AnomalyEvent[]              @relation("AnomalyEventAcknowledgedBy")
    staffRiskSnapshots             StaffRiskSnapshot[]         @relation("StaffRiskSnapshotUser")
    // M19 — Dashboards + KPI
    kpiSubscriptions               KpiSubscription[]           @relation("KpiSubscriptionUser")
    // M20 — Reports + Exports
    reportRunsRequested            ReportRun[]                 @relation("ReportRunRequestedBy")
    exportArtifactsGenerated       ExportArtifact[]            @relation("ExportArtifactGeneratedBy")
    // M21 — Feedback + NPS
    feedbacksAcknowledged          Feedback[]                  @relation("FeedbackAcknowledgedBy")
    feedbacksResolved              Feedback[]                  @relation("FeedbackResolvedBy")
    feedbackTagsCreated            FeedbackTag[]               @relation("FeedbackTagCreatedBy")
    feedbackRequestsCreated        FeedbackRequest[]           @relation("FeedbackRequestCreatedBy")
    // M22 — Documents + Uploads
    documentsUploaded              Document[]                  @relation("DocumentUploadedBy")
    documentsDeleted               Document[]                  @relation("DocumentDeletedBy")
    documentLinksCreated           DocumentLink[]              @relation("DocumentLinkCreatedBy")
    // M23 — HR Core
    employee                       Employee?                   @relation("EmployeeUser")
    contractsCreated               EmploymentContract[]        @relation("ContractCreatedBy")
    contractsUpdated               EmploymentContract[]        @relation("ContractUpdatedBy")
    // M24 — Attendance + Leave + Shift Swaps
    attendanceRecords              AttendanceRecord[]          @relation("AttendanceUser")
    leaveRequestsRequested         LeaveRequest[]              @relation("LeaveRequestedBy")
    leaveRequestsReviewed          LeaveRequest[]              @relation("LeaveReviewedBy")
    shiftSwapsApproved             ShiftSwapRequest[]          @relation("ShiftSwapApprovedBy")
    // M25 — Scheduling + Templates + Duty Roster
    schedulesPublished             Schedule[]                  @relation("SchedulePublishedBy")
    // M26 — Payroll Engine + Pay Runs + Payslips
    payRunsBuilt                   PayRun[]                    @relation("PayRunBuiltBy")
    payRunsApproved                PayRun[]                    @relation("PayRunApprovedBy")
    payRunsPaid                    PayRun[]                    @relation("PayRunPaidBy")
    payrollAdjustmentsCreated      PayrollAdjustment[]         @relation("PayrollAdjustmentCreatedBy")
    // M27 — Staff Insights + Awards + Promotion Suggestions
    insightsGenerated              StaffInsightSnapshot[]      @relation("InsightGeneratedBy")
    awardsCreated                  StaffAward[]                @relation("AwardCreatedBy")
    promotionsGenerated            PromotionSuggestion[]       @relation("PromotionGeneratedBy")
    promotionsDecided              PromotionSuggestion[]       @relation("PromotionDecidedBy")
    // M28 — Accounting Foundation
    fiscalPeriodsOpened            FiscalPeriod[]              @relation("FiscalPeriodOpenedBy")
    fiscalPeriodsClosed            FiscalPeriod[]              @relation("FiscalPeriodClosedBy")
    fiscalPeriodsLocked            FiscalPeriod[]              @relation("FiscalPeriodLockedBy")
    // M29 — General Ledger + Journal Entries + Posting Engine
    journalEntriesPosted           JournalEntry[]              @relation("JournalPostedBy")
    // M34 — Accounts Payable
    vendorBillsApproved            VendorBill[]                @relation("VendorBillApprovedBy")
    vendorPaymentsMade             VendorPayment[]             @relation("VendorPaymentPaidBy")
    remindersDismissed             PayableReminder[]           @relation("ReminderDismissedBy")
    // M35 — Accounts Receivable
    customerAccountsCreated        CustomerAccount[]           @relation("CustomerAccountCreatedBy")
    invoicesIssued                 Invoice[]                   @relation("InvoiceIssuedBy")
    invoicesCreated                Invoice[]                   @relation("InvoiceCreatedBy")
    arReceiptsReceived             ArReceipt[]                 @relation("ArReceiptReceivedBy")
    arCreditNotesIssued            ArCreditNote[]              @relation("ArCreditNoteIssuedBy")
    // M36 — Bank Reconciliation + Period Close
    bankStatementsImported         BankStatement[]             @relation("BankStatementImportedBy")
    bankReconciliationsStarted     BankReconciliation[]        @relation("BankRecMatchedBy")
    bankReconciliationsCompleted   BankReconciliation[]        @relation("BankRecCompletedBy")
    periodCloseRunsCreated         PeriodCloseRun[]            @relation("PeriodCloseRunCreatedBy")
    bankStatementLinesMatched      BankStatementLine[]         @relation("BankStatementLineMatchedBy")
    manualBankEntriesCreated       ManualBankEntry[]           @relation("ManualBankEntryCreatedBy")
    // M37 — Budgets + Forecasts + Procurement Advisory
    budgetsCreated                 Budget[]                    @relation("BudgetCreatedBy")
    budgetsUpdated                 Budget[]                    @relation("BudgetUpdatedBy")
    forecastRunsCreated            ForecastRun[]               @relation("ForecastRunCreatedBy")
    procurementSuggestionsReviewed ProcurementSuggestion[]     @relation("ProcurementSuggestionReviewedBy")
    demandCalendarEntriesCreated   DemandCalendarEntry[]       @relation("DemandCalendarCreatedBy")
    demandCalendarEntriesUpdated   DemandCalendarEntry[]       @relation("DemandCalendarUpdatedBy")
    // M38 — Franchise + Multi-Branch Suite
    branchBudgetRollupsGenerated   BranchBudgetRollup[]        @relation("BranchBudgetRollupGeneratedBy")
    transfersRequested             InterBranchTransfer[]       @relation("TransferRequestedBy")
    transfersApproved              InterBranchTransfer[]       @relation("TransferApprovedBy")
    hqDigestSubscriptions          HqDigestSubscription[]      @relation("HqDigestSubscriptionUser")
    // M38.1 — Franchise Analytics + Consolidation
    consolidationRunsGenerated     FranchiseConsolidationRun[] @relation("ConsolidationRunGeneratedBy")
    // M39 — Billing + Subscription Plans + Dev Portal
    apiKeysCreated                 ApiKey[]                    @relation("ApiKeyCreatedBy")
    apiKeysRevoked                 ApiKey[]                    @relation("ApiKeyRevokedBy")
    webhookEndpointsCreated        WebhookEndpoint[]           @relation("WebhookEndpointCreatedBy")
    supportSessionsOpened          SupportSession[]            @relation("SupportSessionOpenedBy")
    supportSessionsClosed          SupportSession[]            @relation("SupportSessionClosedBy")
    devAdmin                       DevAdmin?                   @relation("DevAdminUser")

    @@map("users")
}

/// Named role with a hierarchical level and optional job role.
model Role {
    id          String    @id @default(cuid())
    name        String    @unique
    description String?
    level       RoleLevel
    jobRole     JobRole?  @map("job_role")
    isActive    Boolean   @default(true) @map("is_active")
    createdAt   DateTime  @default(now()) @map("created_at")
    updatedAt   DateTime  @updatedAt @map("updated_at")

    // Relations
    userRoles       UserRole[]
    rolePermissions RolePermission[]
    memberships     Membership[]

    @@map("roles")
}

/// A named permission string (resource:action pattern).
model Permission {
    id          String   @id @default(cuid())
    action      String   @unique
    description String?
    createdAt   DateTime @default(now()) @map("created_at")
    updatedAt   DateTime @updatedAt @map("updated_at")

    // Relations
    rolePermissions RolePermission[]

    @@map("permissions")
}

/// Many-to-many: role ↔ permission.
model RolePermission {
    id           String   @id @default(cuid())
    roleId       String   @map("role_id")
    permissionId String   @map("permission_id")
    createdAt    DateTime @default(now()) @map("created_at")

    role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
    permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

    @@unique([roleId, permissionId])
    @@map("role_permissions")
}

/// Many-to-many: user ↔ role assignment.
/// orgId/branchId nullable now; will be scoped in M3.
model UserRole {
    id        String   @id @default(cuid())
    userId    String   @map("user_id")
    roleId    String   @map("role_id")
    orgId     String?  @map("org_id")
    branchId  String?  @map("branch_id")
    createdAt DateTime @default(now()) @map("created_at")

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
    role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

    @@unique([userId, roleId, orgId, branchId])
    @@map("user_roles")
}

/// Tracks an active login session.
model Session {
    id             String          @id @default(cuid())
    userId         String          @map("user_id")
    orgId          String?         @map("org_id")
    branchId       String?         @map("branch_id")
    jti            String          @unique
    platform       SessionPlatform
    source         SessionSource
    ipAddress      String?         @map("ip_address")
    userAgent      String?         @map("user_agent")
    lastActivityAt DateTime        @default(now()) @map("last_activity_at")
    expiresAt      DateTime        @map("expires_at")
    revokedAt      DateTime?       @map("revoked_at")
    revokedById    String?         @map("revoked_by_id")
    revokedReason  String?         @map("revoked_reason")
    createdAt      DateTime        @default(now()) @map("created_at")

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@map("sessions")
}

/// Persisted refresh token supporting rotation and revocation.
model RefreshToken {
    id           String    @id @default(cuid())
    userId       String    @map("user_id")
    tokenHash    String    @unique @map("token_hash")
    family       String
    sessionId    String    @map("session_id")
    expiresAt    DateTime  @map("expires_at")
    revokedAt    DateTime? @map("revoked_at")
    replacedById String?   @map("replaced_by_id")
    createdAt    DateTime  @default(now()) @map("created_at")

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@index([family])
    @@map("refresh_tokens")
}

/// Immutable audit trail for security and sensitive events.
model AuditLog {
    id          String   @id @default(cuid())
    actorUserId String?  @map("actor_user_id")
    action      String
    entityType  String   @map("entity_type")
    entityId    String?  @map("entity_id")
    metadata    Json?
    ipAddress   String?  @map("ip_address")
    userAgent   String?  @map("user_agent")
    createdAt   DateTime @default(now()) @map("created_at")

    actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

    @@index([actorUserId])
    @@index([action])
    @@index([entityType])
    @@map("audit_logs")
}

// ── M3 Models ──

/// Tenant root entity. All business data is ultimately scoped to an organization.
model Organization {
    id        String             @id @default(cuid())
    name      String
    slug      String             @unique
    legalName String?            @map("legal_name")
    taxId     String?            @map("tax_id")
    status    OrganizationStatus @default(ACTIVE)
    createdAt DateTime           @default(now()) @map("created_at")
    updatedAt DateTime           @updatedAt @map("updated_at")

    branches                    Branch[]
    memberships                 Membership[]
    settings                    OrgSettings?
    exchangeRates               ExchangeRate[]
    floorPlans                  FloorPlan[]
    tables                      Table[]
    categories                  Category[]
    taxCategories               TaxCategory[]
    menuItems                   MenuItem[]
    menuBrowseGroups            MenuBrowseGroup[]
    modifierGroups              ModifierGroup[]
    inventoryItems              InventoryItem[]
    recipeIngredients           RecipeIngredient[]
    stockBatches                StockBatch[]
    stockAdjustments            StockAdjustment[]
    orders                      Order[]
    kdsTickets                  KdsTicket[]
    kdsSlaConfigs               KdsSlaConfig[]
    discounts                   Discount[]
    payments                    Payment[]
    paymentIntents              PaymentIntent[]
    refunds                     Refund[]
    shifts                      Shift[]
    tillSessions                TillSession[]
    cashMovements               CashMovement[]
    shiftCloseSummaries         ShiftCloseSummary[]
    reservations                Reservation[]
    reservationDeposits         ReservationDeposit[]
    reservationEvents           ReservationEvent[]
    // M17 — Events
    events                      Event[]
    eventTicketClasses          EventTicketClass[]
    eventBookings               EventBooking[]
    eventTickets                EventTicket[]
    eventCheckIns               EventCheckIn[]
    eventAuditLogs              EventAuditLog[]
    // M18 — Anomaly Detection
    anomalyRules                AnomalyRule[]
    riskThresholds              RiskThreshold[]
    anomalyEvents               AnomalyEvent[]
    staffRiskSnapshots          StaffRiskSnapshot[]
    // M19 — Dashboards + KPI
    kpiSnapshots                KpiSnapshot[]
    kpiSubscriptions            KpiSubscription[]
    // M20 — Reports + Exports
    reportRuns                  ReportRun[]
    exportArtifacts             ExportArtifact[]
    // M21 — Feedback + NPS
    feedbacks                   Feedback[]
    feedbackTags                FeedbackTag[]
    npsSummaries                NpsSummary[]
    feedbackRequests            FeedbackRequest[]
    // M22 — Documents + Uploads
    documents                   Document[]
    documentLinks               DocumentLink[]
    storageProviderConfigs      StorageProviderConfig[]
    // M23 — HR Core
    employees                   Employee[]
    employmentContracts         EmploymentContract[]
    positions                   Position[]
    compensationProfiles        CompensationProfile[]
    // M24 — Attendance + Leave + Shift Swaps
