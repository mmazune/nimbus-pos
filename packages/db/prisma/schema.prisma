/// Links a user to a branch within an organization with a specific role.
model Membership {
    id              String           @id @default(cuid())
    userId          String           @map("user_id")
    organizationId  String           @map("organization_id")
    branchId        String           @map("branch_id")
    roleId          String           @map("role_id")
    status          MembershipStatus @default(ACTIVE)
    isDefaultBranch Boolean          @default(false) @map("is_default_branch")
    createdAt       DateTime         @default(now()) @map("created_at")
    updatedAt       DateTime         @updatedAt @map("updated_at")

    user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
    organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
    role         Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)

    @@unique([userId, branchId])
    @@index([organizationId])
    @@index([branchId])
    @@index([userId])
    @@map("memberships")
}

// ── M4 Models ──

/// Central org-level configuration. One row per organization.
/// JSON fields:
///   anomalyThresholds: { lateVoidMin: number, heavyDiscountUGX: number }
///   platformAccess: { useRoleDefaults: boolean, overrides?: Record<string, string[]> }
///   franchiseWeights: { [metric: string]: number }
///   metadata: arbitrary org metadata (e.g. businessRegistration, logo)
///   defaults: future catch-all for module defaults
///   taxMatrix: { defaultVatPct: number, categories: { name: string, vatPct: number }[] }
///   rounding: { mode: "NEAREST"|"UP"|"DOWN", increment: number }
///   bookingPolicies: { requireDeposit: boolean, maxPartySize?: number, ... }
///   attendance: { autoClockOutHours: number, ... }
///   inventoryTolerance: { variancePct: number, ... }
model OrgSettings {
    id                        String   @id @default(cuid())
    orgId                     String   @unique @map("org_id")
    vatPercent                Decimal  @default(18.00) @map("vat_percent") @db.Decimal(5, 2)
    currency                  String   @default("UGX")
    discountApprovalThreshold Decimal  @default(5000) @map("discount_approval_threshold") @db.Decimal(10, 2)
    reservationHoldMinutes    Int      @default(30) @map("reservation_hold_minutes")
    receiptFooter             String?  @map("receipt_footer")
    metadata                  Json?
    anomalyThresholds         Json?    @map("anomaly_thresholds")
    platformAccess            Json?    @map("platform_access")
    franchiseWeights          Json?    @map("franchise_weights")
    showCostToChef            Boolean  @default(false) @map("show_cost_to_chef")
    defaults                  Json?
    baseCurrencyCode          String?  @map("base_currency_code")
    taxMatrix                 Json?    @map("tax_matrix")
    rounding                  Json?
    bookingPolicies           Json?    @map("booking_policies")
    attendance                Json?
    inventoryTolerance        Json?    @map("inventory_tolerance")
    createdAt                 DateTime @default(now()) @map("created_at")
    updatedAt                 DateTime @updatedAt @map("updated_at")

    organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

    @@map("org_settings")
}

/// Exchange rate for multi-currency orgs. One row per currency pair per effective date.
model ExchangeRate {
    id                String   @id @default(cuid())
    orgId             String   @map("org_id")
    baseCurrencyCode  String   @map("base_currency_code")
    quoteCurrencyCode String   @map("quote_currency_code")
    rate              Decimal  @map("rate") @db.Decimal(18, 6)
    effectiveAt       DateTime @map("effective_at")
    createdAt         DateTime @default(now()) @map("created_at")
    createdById       String?  @map("created_by_id")

    organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

    @@index([orgId])
    @@index([orgId, baseCurrencyCode, quoteCurrencyCode, effectiveAt])
    @@map("exchange_rates")
}

// ── Enums (M5) ──

enum TableStatus {
    AVAILABLE
    OCCUPIED
    RESERVED
    CLEANING
}

// ── M5 Models ──

/// A visual layout container for tables within a branch.
model FloorPlan {
    id        String   @id @default(cuid())
    orgId     String   @map("org_id")
    branchId  String   @map("branch_id")
    name      String
    data      Json     @default("{}")
    isActive  Boolean  @default(true) @map("is_active")
    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
    branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
    tables       Table[]

    @@index([orgId])
    @@index([branchId])
    @@map("floor_plans")
}

/// A seating resource within a branch, optionally assigned to a floor plan.
model Table {
    id          String      @id @default(cuid())
    orgId       String      @map("org_id")
    branchId    String      @map("branch_id")
    floorPlanId String?     @map("floor_plan_id")
    label       String
    capacity    Int         @default(4)
    status      TableStatus @default(AVAILABLE)
    isActive    Boolean     @default(true) @map("is_active")
    metadata    Json?
    createdAt   DateTime    @default(now()) @map("created_at")
    updatedAt   DateTime    @updatedAt @map("updated_at")

    organization Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
    branch       Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
    floorPlan    FloorPlan?    @relation(fields: [floorPlanId], references: [id], onDelete: SetNull)
    orders       Order[]
    reservations Reservation[]
    events       Event[]

    @@unique([branchId, label])
    @@index([orgId])
    @@index([branchId])
    @@index([floorPlanId])
    @@map("tables")
}

// ── Enums (M6) ──

enum MenuItemType {
    FOOD
    DRINK
}

enum PrepStation {
    KITCHEN
    BAR
    COLD_KITCHEN
    DESSERT
    NONE
}

// ── M6 Models ──

/// A menu grouping within a branch (e.g., Starters, Mains, Drinks).
model Category {
    id        String   @id @default(cuid())
    orgId     String   @map("org_id")
    branchId  String   @map("branch_id")
    name      String
    sortOrder Int      @default(0) @map("sort_order")
    isActive  Boolean  @default(true) @map("is_active")
    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
    branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
    menuItems    MenuItem[]

    @@unique([branchId, name])
    @@index([orgId])
    @@index([branchId])
    @@map("categories")
}

/// Tax classification for menu items within a branch (e.g., VAT Standard 18%).
model TaxCategory {
    id           String   @id @default(cuid())
    orgId        String   @map("org_id")
    branchId     String   @map("branch_id")
    name         String
    rate         Decimal  @db.Decimal(5, 2)
    efirsTaxCode String?  @map("efirs_tax_code")
    isActive     Boolean  @default(true) @map("is_active")
    createdAt    DateTime @default(now()) @map("created_at")
    updatedAt    DateTime @updatedAt @map("updated_at")

    organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
    branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
    menuItems    MenuItem[]

    @@unique([branchId, name])
    @@index([orgId])
    @@index([branchId])
    @@map("tax_categories")
}

/// A sellable product on the branch menu.
model MenuItem {
    id               String       @id @default(cuid())
    orgId            String       @map("org_id")
    branchId         String       @map("branch_id")
    categoryId       String       @map("category_id")
    taxCategoryId    String?      @map("tax_category_id")
    browseGroupId    String?      @map("browse_group_id")
    browseSubgroupId String?      @map("browse_subgroup_id")
    name             String
    sku              String?
    description      String?
    price            Decimal      @db.Decimal(10, 2)
    itemType         MenuItemType @map("item_type")
    station          PrepStation  @default(NONE)
    sortOrder        Int          @default(0) @map("sort_order")
    isActive         Boolean      @default(true) @map("is_active")
    metadata         Json?
    createdAt        DateTime     @default(now()) @map("created_at")
    updatedAt        DateTime     @updatedAt @map("updated_at")

    organization      Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
    branch            Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
    category          Category            @relation(fields: [categoryId], references: [id], onDelete: Cascade)
    taxCategory       TaxCategory?        @relation(fields: [taxCategoryId], references: [id], onDelete: SetNull)
    browseGroup       MenuBrowseGroup?    @relation(fields: [browseGroupId], references: [id], onDelete: SetNull)
    browseSubgroup    MenuBrowseSubgroup? @relation(fields: [browseSubgroupId], references: [id], onDelete: SetNull)
    servings          MenuItemServing[]
    menuItemOnGroups  MenuItemOnGroup[]
    recipeIngredients RecipeIngredient[]
    orderItems        OrderItem[]

    @@unique([categoryId, name])
    @@index([orgId])
    @@index([branchId])
    @@index([categoryId])
    @@index([taxCategoryId])
    @@index([browseGroupId])
    @@index([browseSubgroupId])
    @@map("menu_items")
}

// ── Enums (M6.1) ──

enum MenuSection {
    FOOD
    DRINKS
}

enum ServingFormat {
    GLASS
    BOTTLE
    JUG
    PINT
    HALF_PINT
    SHOT
    SINGLE
    DOUBLE
    CARAFE
    FLIGHT
    CUP
    CUSTOM
}

// ── M6.1 Models ──

/// POS-facing browse group for waiter navigation (e.g., Starters, Cocktails, Wine).
/// Labels are fully restaurant-configurable — not hardcoded by cuisine.
model MenuBrowseGroup {
    id          String      @id @default(cuid())
    orgId       String      @map("org_id")
    branchId    String      @map("branch_id")
    section     MenuSection
    name        String
    internalKey String?     @map("internal_key")
    sortOrder   Int         @default(0) @map("sort_order")
    isActive    Boolean     @default(true) @map("is_active")
    createdAt   DateTime    @default(now()) @map("created_at")
    updatedAt   DateTime    @updatedAt @map("updated_at")

    organization Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
    branch       Branch               @relation(fields: [branchId], references: [id], onDelete: Cascade)
    subgroups    MenuBrowseSubgroup[]
    menuItems    MenuItem[]

    @@unique([branchId, name])
    @@index([orgId])
    @@index([branchId])
    @@map("menu_browse_groups")
}

/// Optional drilldown within a browse group (e.g., Red/White/Rosé under Wine).
model MenuBrowseSubgroup {
    id          String   @id @default(cuid())
    groupId     String   @map("group_id")
    name        String
    internalKey String?  @map("internal_key")
    sortOrder   Int      @default(0) @map("sort_order")
    isActive    Boolean  @default(true) @map("is_active")
    createdAt   DateTime @default(now()) @map("created_at")
    updatedAt   DateTime @updatedAt @map("updated_at")

    group     MenuBrowseGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
    menuItems MenuItem[]

    @@unique([groupId, name])
    @@index([groupId])
    @@map("menu_browse_subgroups")
}

/// A sellable serving format for a menu item (e.g., Glass, Bottle, Shot, Plate).
/// Uniqueness: one format+label combination per menu item.
model MenuItemServing {
    id         String        @id @default(cuid())
    menuItemId String        @map("menu_item_id")
    format     ServingFormat
    label      String?
    price      Decimal       @db.Decimal(10, 2)
    volumeText String?       @map("volume_text")
    isDefault  Boolean       @default(false) @map("is_default")
    sortOrder  Int           @default(0) @map("sort_order")
    isActive   Boolean       @default(true) @map("is_active")
    metadata   Json?
    createdAt  DateTime      @default(now()) @map("created_at")
    updatedAt  DateTime      @updatedAt @map("updated_at")

    menuItem          MenuItem           @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
    recipeIngredients RecipeIngredient[]
    orderItems        OrderItem[]

    @@unique([menuItemId, format, label])
    @@index([menuItemId])
    @@map("menu_item_servings")
}

// ── M7 Models ──

/// A group of modifier options (e.g., "Cooking Temp", "Extra Toppings", "Size").
/// Branch-scoped. `min`/`max` define selection rules (max=0 means unlimited).
model ModifierGroup {
    id        String   @id @default(cuid())
    orgId     String   @map("org_id")
    branchId  String   @map("branch_id")
    name      String
    min       Int      @default(0)
    max       Int      @default(0)
    required  Boolean  @default(false)
    sortOrder Int      @default(0) @map("sort_order")
    isActive  Boolean  @default(true) @map("is_active")
    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    organization     Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
    branch           Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
    options          ModifierOption[]
    menuItemOnGroups MenuItemOnGroup[]

    @@unique([branchId, name])
    @@index([orgId])
    @@index([branchId])
    @@map("modifier_groups")
}

/// A selectable option within a modifier group (e.g., "Extra Cheese +1500", "Medium Rare +0").
model ModifierOption {
    id         String   @id @default(cuid())
    groupId    String   @map("group_id")
    name       String
    priceDelta Decimal  @default(0) @map("price_delta") @db.Decimal(10, 2)
    sortOrder  Int      @default(0) @map("sort_order")
    isActive   Boolean  @default(true) @map("is_active")
    metadata   Json?
    createdAt  DateTime @default(now()) @map("created_at")
    updatedAt  DateTime @updatedAt @map("updated_at")

    group             ModifierGroup      @relation(fields: [groupId], references: [id], onDelete: Cascade)
    recipeIngredients RecipeIngredient[]

    @@unique([groupId, name])
    @@index([groupId])
    @@map("modifier_options")
}

/// Many-to-many: MenuItem ↔ ModifierGroup assignment.
model MenuItemOnGroup {
    id        String   @id @default(cuid())
    itemId    String   @map("item_id")
    groupId   String   @map("group_id")
    sortOrder Int      @default(0) @map("sort_order")
    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    menuItem      MenuItem      @relation(fields: [itemId], references: [id], onDelete: Cascade)
    modifierGroup ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

    @@unique([itemId, groupId])
    @@index([itemId])
    @@index([groupId])
    @@map("menu_item_on_groups")
}

// ── M8 Models ──

/// Master inventory item used in recipes and stock management.
/// Branch-scoped. Represents a raw material or ingredient.
model InventoryItem {
    id                  String   @id @default(cuid())
    orgId               String   @map("org_id")
    branchId            String   @map("branch_id")
    sku                 String?
    name                String
    unit                String
    category            String?
    theoreticalUnitCost Decimal  @default(0) @map("theoretical_unit_cost") @db.Decimal(10, 3)
    reorderLevel        Decimal  @default(0) @map("reorder_level") @db.Decimal(10, 3)
    reorderQty          Decimal  @default(0) @map("reorder_qty") @db.Decimal(10, 3)
    isActive            Boolean  @default(true) @map("is_active")
    metadata            Json?
    createdAt           DateTime @default(now()) @map("created_at")
    updatedAt           DateTime @updatedAt @map("updated_at")

    organization           Organization            @relation(fields: [orgId], references: [id], onDelete: Cascade)
    branch                 Branch                  @relation(fields: [branchId], references: [id], onDelete: Cascade)
    recipeIngredients      RecipeIngredient[]
    stockBatches           StockBatch[]
    stockAdjustments       StockAdjustment[]
    // M37 — Procurement Suggestions
    procurementSuggestions ProcurementSuggestion[]
    // M38 — Inter-Branch Transfers
    interBranchTransfers   InterBranchTransfer[]

    @@unique([branchId, name])
    @@index([orgId])
    @@index([branchId])
    @@map("inventory_items")
}

/// A single ingredient row in a menu item's recipe.
/// Supports base rows (servingId=null, modifierOptionId=null),
/// serving-specific rows, and modifier-linked rows.
model RecipeIngredient {
    id                String   @id @default(cuid())
    orgId             String   @map("org_id")
    branchId          String   @map("branch_id")
    menuItemId        String   @map("menu_item_id")
    inventoryItemId   String   @map("inventory_item_id")
    menuItemServingId String?  @map("menu_item_serving_id")
    modifierOptionId  String?  @map("modifier_option_id")
    qtyPerUnit        Decimal  @map("qty_per_unit") @db.Decimal(10, 3)
    wastePct          Decimal  @default(0) @map("waste_pct") @db.Decimal(5, 2)
    unit              String
    notes             String?
    createdAt         DateTime @default(now()) @map("created_at")
    updatedAt         DateTime @updatedAt @map("updated_at")

    organization    Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
    branch          Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
    menuItem        MenuItem         @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
    inventoryItem   InventoryItem    @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
    menuItemServing MenuItemServing? @relation(fields: [menuItemServingId], references: [id], onDelete: SetNull)
    modifierOption  ModifierOption?  @relation(fields: [modifierOptionId], references: [id], onDelete: SetNull)

    @@index([orgId])
    @@index([branchId])
    @@index([menuItemId])
    @@index([inventoryItemId])
    @@index([menuItemServingId])
    @@index([modifierOptionId])
    @@map("recipe_ingredients")
}

// ── M9 Models ──

/// A stock batch for FIFO-tracked inventory. Each receiving event or seed creates a batch.
/// `remainingQty` tracks how much is left; FIFO deduction consumes oldest batches first.
model StockBatch {
    id             String    @id @default(cuid())
    orgId          String    @map("org_id")
    branchId       String    @map("branch_id")
    itemId         String    @map("item_id")
    batchNumber    String?   @map("batch_number")
    receivedQty    Decimal   @map("received_qty") @db.Decimal(10, 3)
    remainingQty   Decimal   @map("remaining_qty") @db.Decimal(10, 3)
    unitCost       Decimal   @map("unit_cost") @db.Decimal(10, 2)
    expiryDate     DateTime? @map("expiry_date")
    receivedAt     DateTime  @map("received_at")
    goodsReceiptId String?   @map("goods_receipt_id")
    metadata       Json?
    createdAt      DateTime  @default(now()) @map("created_at")
    updatedAt      DateTime  @updatedAt @map("updated_at")

    organization  Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
    branch        Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
    inventoryItem InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

    @@index([orgId])
    @@index([branchId])
    @@index([itemId])
    @@index([expiryDate])
    @@index([receivedAt])
    @@index([branchId, itemId])
