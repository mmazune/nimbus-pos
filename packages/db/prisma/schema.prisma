/// A POS order. Branch-scoped with lifecycle state machine.
/// orderNumber is unique per branch (e.g. ORD-000001).
model Order {
    id                String      @id @default(cuid())
    orgId             String      @map("org_id")
    branchId          String      @map("branch_id")
    tableId           String?     @map("table_id")
    userId            String      @map("user_id")
    orderNumber       String      @map("order_number")
    status            OrderStatus @default(NEW)
    serviceType       ServiceType @map("service_type")
    subtotal          Decimal     @default(0) @db.Decimal(12, 2)
    tax               Decimal     @default(0) @db.Decimal(12, 2)
    discount          Decimal     @default(0) @db.Decimal(10, 2)
    total             Decimal     @default(0) @db.Decimal(12, 2)
    anomalyFlags      Json?       @map("anomaly_flags")
    notes             String?
    metadata          Json?
    // BG4.B — POS Order Handoff. Nullable self-references so that:
    //   * a child order produced by /api/pos/orders/:id/split-items
    //     records its source via splitFromOrderId
    //   * a source order voided by /api/pos/orders/merge records the
    //     target it was absorbed into via mergedIntoOrderId
    splitFromOrderId  String?     @map("split_from_order_id")
    mergedIntoOrderId String?     @map("merged_into_order_id")
    createdAt         DateTime    @default(now()) @map("created_at")
    updatedAt         DateTime    @updatedAt @map("updated_at")

    organization     Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
    branch           Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
    table            Table?            @relation(fields: [tableId], references: [id], onDelete: SetNull)
    user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
    items            OrderItem[]
    kdsTickets       KdsTicket[]
    discounts        Discount[]
    payments         Payment[]
    paymentIntents   PaymentIntent[]
    refunds          Refund[]
    reservations     Reservation[]
    // M21 — Feedback
    feedbacks        Feedback[]
    feedbackRequests FeedbackRequest[]
    // BG4.B — Order handoff self-relations
    splitFromOrder   Order?            @relation("OrderSplitFrom", fields: [splitFromOrderId], references: [id], onDelete: SetNull)
    splitChildren    Order[]           @relation("OrderSplitFrom")
    mergedIntoOrder  Order?            @relation("OrderMergedInto", fields: [mergedIntoOrderId], references: [id], onDelete: SetNull)
    mergedSources    Order[]           @relation("OrderMergedInto")

    @@unique([branchId, orderNumber])
    @@index([orgId])
    @@index([branchId])
    @@index([tableId])
    @@index([userId])
    @@index([status])
    @@index([createdAt])
    @@index([branchId, status])
    @@index([splitFromOrderId])
    @@index([mergedIntoOrderId])
    @@map("orders")
}

/// A line item on an order, with price/cost snapshot at time of sale.
model OrderItem {
    id                String   @id @default(cuid())
    orderId           String   @map("order_id")
