/// Defines a detection rule for anomalies / anti-theft signals.
/// Each rule specifies a metric, operator, threshold, and window.
model AnomalyRule {
    id                  String            @id @default(cuid())
    orgId               String            @map("org_id")
    branchId            String?           @map("branch_id")
    code                String
    name                String
    type                AnomalyRuleType
    description         String?
    status              AnomalyRuleStatus @default(ACTIVE)
    severity            AnomalySeverity
    metricKey           String            @map("metric_key")
    operator            String
    thresholdValue      Decimal?          @map("threshold_value") @db.Decimal(10, 2)
    windowMinutes       Int?              @map("window_minutes")
    minimumSampleSize   Int?              @map("minimum_sample_size")
    appliesToEntityType RiskEntityType?   @map("applies_to_entity_type")
    config              Json?
    createdById         String            @map("created_by_id")
    updatedById         String?           @map("updated_by_id")
    createdAt           DateTime          @default(now()) @map("created_at")
    updatedAt           DateTime          @updatedAt @map("updated_at")

    organization  Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
    branch        Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
    createdBy     User           @relation("AnomalyRuleCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
    updatedBy     User?          @relation("AnomalyRuleUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
    anomalyEvents AnomalyEvent[]

    @@unique([orgId, code])
    @@index([orgId])
    @@index([branchId])
    @@index([type])
    @@index([status])
    @@index([severity])
    @@index([createdAt])
    @@map("anomaly_rules")
}

