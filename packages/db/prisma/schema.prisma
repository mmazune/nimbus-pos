}

/// Inter-branch transfer request / record with lifecycle state.
model InterBranchTransfer {
    id              String                    @id @default(cuid())
    orgId           String                    @map("org_id")
    fromBranchId    String                    @map("from_branch_id")
    toBranchId      String                    @map("to_branch_id")
    transferType    InterBranchTransferType   @default(STOCK) @map("transfer_type")
    status          InterBranchTransferStatus @default(REQUESTED)
    urgency         TransferUrgency           @default(MEDIUM)
    inventoryItemId String?                   @map("inventory_item_id")
    itemCategory    String?                   @map("item_category")
    quantity        Decimal?                  @db.Decimal(12, 3)
    estimatedValue  Decimal?                  @map("estimated_value") @db.Decimal(14, 2)
    rationale       String
    transferNumber  String                    @map("transfer_number")
    requestedById   String                    @map("requested_by_id")
    approvedById    String?                   @map("approved_by_id")
    approvedAt      DateTime?                 @map("approved_at")
    completedAt     DateTime?                 @map("completed_at")
    rejectionReason String?                   @map("rejection_reason")
    notes           String?
    metadata        Json?
    createdAt       DateTime                  @default(now()) @map("created_at")
    updatedAt       DateTime                  @updatedAt @map("updated_at")

    organization  Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
    fromBranch    Branch         @relation("TransferFromBranch", fields: [fromBranchId], references: [id], onDelete: Cascade)
    toBranch      Branch         @relation("TransferToBranch", fields: [toBranchId], references: [id], onDelete: Cascade)
    inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
    requestedBy   User           @relation("TransferRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
    approvedBy    User?          @relation("TransferApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

    @@unique([orgId, transferNumber])
    @@index([orgId])
    @@index([fromBranchId])
    @@index([toBranchId])
    @@index([status])
    @@index([urgency])
    @@index([inventoryItemId])
    @@index([orgId, status])
    @@index([orgId, fromBranchId, status])
    @@index([orgId, toBranchId, status])
    @@index([orgId, fromBranchId, toBranchId, status])
    @@map("inter_branch_transfers")
}

/// HQ/franchise digest subscription preferences for alerting integration.
model HqDigestSubscription {
    id          String            @id @default(cuid())
    orgId       String            @map("org_id")
    userId      String            @map("user_id")
    channel     String            @default("email")
