{
    "info": {
        "name": "M28 - Accounting Foundation (COA + Cost Centers + Fiscal Periods)",
        "description": "API collection for M28 — Chart of Accounts, Cost Centers, Fiscal Periods, Posting Source Maps, Tax Ledger Configuration",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:3001"
        }
    ],
    "item": [
        {
            "name": "Auth — Login Owner",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('status 201', () => pm.response.to.have.status(201));",
                            "const body = pm.response.json();",
                            "pm.environment.set('accessToken', body.accessToken);",
                            "pm.environment.set('refreshToken', body.refreshToken);"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"email\": \"owner@demo.local\",\n    \"password\": \"Owner#123\"\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/api/auth/login",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "auth",
                        "login"
                    ]
                }
            }
        },
        {
            "name": "Auth — Get Branch ID",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('status 200', () => pm.response.to.have.status(200));",
                            "const body = pm.response.json();",
                            "const bid = body.defaultBranch?.id || body.organizations?.[0]?.branches?.[0]?.id || body.memberships?.[0]?.branchId;",
                            "pm.environment.set('branchId', bid);"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{accessToken}}"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/me",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "me"
                    ]
                }
            }
        },
