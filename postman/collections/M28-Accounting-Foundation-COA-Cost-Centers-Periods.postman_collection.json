                                    "pm.test('has id', () => pm.expect(body.id).to.be.a('string'));",
                                    "pm.test('code matches', () => pm.expect(body.code).to.eql('PM-1000'));",
                                    "pm.test('type is ASSET', () => pm.expect(body.accountType).to.eql('ASSET'));",
