{
    "info": {
        "_postman_id": "m7-menu-modifiers",
        "name": "M7 — Menu Modifier Groups + Options",
        "description": "Nimbus POS — M7 modifier groups, modifier options, item-to-group assignment, and item detail read model.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "auth": {
        "type": "bearer",
        "bearer": [
            {
                "key": "token",
                "value": "{{accessToken}}",
                "type": "string"
            }
        ]
    },
    "item": [
        {
            "name": "Login (Owner)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const json = pm.response.json();",
                            "pm.environment.set('accessToken', json.accessToken);",
                            "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                            "pm.test('Has accessToken', () => pm.expect(json.accessToken).to.be.a('string'));"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "auth": {
                    "type": "noauth"
                },
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"email\": \"owner@demo.local\",\n  \"password\": \"Owner#123\"\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/api/auth/login",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "auth",
                        "login"
                    ]
                }
            }
        },
        {
            "name": "Modifier Groups",
            "item": [
                {
                    "name": "Create Modifier Group",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "const json = pm.response.json();",
                                    "pm.environment.set('modifierGroupId', json.id);",
                                    "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                                    "pm.test('Has id', () => pm.expect(json.id).to.be.a('string'));",
                                    "pm.test('Name matches', () => pm.expect(json.name).to.eql('PM Size'));",
                                    "pm.test('Min is 1', () => pm.expect(json.min).to.eql(1));",
                                    "pm.test('Required is true', () => pm.expect(json.required).to.eql(true));"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "X-Branch-Id",
                                "value": "{{branchId}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"name\": \"PM Size\",\n  \"min\": 1,\n  \"max\": 1,\n  \"required\": true,\n  \"sortOrder\": 0\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/menu/modifier-groups",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "menu",
                                "modifier-groups"
                            ]
