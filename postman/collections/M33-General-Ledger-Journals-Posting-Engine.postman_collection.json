                    "name": "Create Journal Entry",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('status 201', () => pm.response.to.have.status(201));",
                                    "const body = pm.response.json();",
                                    "pm.test('has id', () => pm.expect(body.id).to.be.a('string'));",
                                    "pm.test('status is POSTED', () => pm.expect(body.status).to.eql('POSTED'));",
                                    "pm.test('has journalNumber', () => pm.expect(body.journalNumber).to.be.a('string'));",
                                    "pm.test('has lines array', () => pm.expect(body.lines).to.be.an('array'));",
                                    "pm.environment.set('journalId', body.id);",
                                    "pm.environment.set('journalNumber', body.journalNumber);"
