                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"journalDate\": \"2025-07-01\",\n    \"reference\": \"PM-JNL-001\",\n    \"description\": \"Postman test journal entry\",\n    \"lines\": [\n        {\n            \"accountId\": \"{{accountId}}\",\n            \"direction\": \"DEBIT\",\n            \"amount\": \"500.00\",\n            \"description\": \"Debit side\"\n        },\n        {\n            \"accountId\": \"{{accountId}}\",\n            \"direction\": \"CREDIT\",\n            \"amount\": \"500.00\",\n            \"description\": \"Credit side\"\n        }\n    ]\n}"
