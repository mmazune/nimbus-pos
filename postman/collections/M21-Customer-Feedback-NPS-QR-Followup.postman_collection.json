{
    "info": {
        "name": "M21 — Customer Feedback + NPS + QR Follow-up",
        "description": "Nimbus POS M21: Customer Feedback collection, NPS scoring, QR-based follow-up.\n\n## Endpoints\n- POST /feedback/requests — Create feedback request\n- GET /feedback/requests — List feedback requests\n- PATCH /feedback/requests/:id/cancel — Cancel feedback request\n- GET /feedback/public/token/:token — Public token lookup\n- POST /feedback/public — Public feedback submission\n- GET /feedback — List feedback (paginated, filterable)\n- GET /feedback/:id — Get feedback by ID\n- PATCH /feedback/:id/tag — Tag feedback\n- PATCH /feedback/:id/acknowledge — Acknowledge feedback\n- PATCH /feedback/:id/resolve — Resolve feedback\n- GET /feedback/tags — List tags\n- GET /feedback/nps-summary — NPS summary analytics",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "auth": {
        "type": "bearer",
        "bearer": [
            {
                "key": "token",
                "value": "{{accessToken}}",
                "type": "string"
            }
        ]
    },
    "variable": [
        { "key": "baseUrl", "value": "http://localhost:3001" },
        { "key": "accessToken", "value": "" },
        { "key": "branchId", "value": "" },
        { "key": "feedbackRequestId", "value": "" },
        { "key": "feedbackToken", "value": "" },
        { "key": "feedbackId", "value": "" }
    ],
    "item": [
        {
            "name": "Auth — Login (Owner)",
            "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"email\": \"owner@demo.local\",\n  \"password\": \"Owner#123\"\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/api/auth/login",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "auth", "login"]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const body = pm.response.json();",
                            "pm.environment.set('accessToken', body.accessToken);",
                            "pm.test('Login OK', () => pm.response.to.have.status(200));"
                        ]
                    }
                }
            ]
        },
        {
            "name": "Get /me — Capture branchId",
            "request": {
                "method": "GET",
                "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
                "url": {
                    "raw": "{{baseUrl}}/api/me",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "me"]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const body = pm.response.json();",
                            "const bid = body.defaultBranch?.id || body.memberships?.[0]?.branchId;",
                            "if (bid) pm.environment.set('branchId', bid);",
                            "pm.test('Got branchId', () => pm.expect(bid).to.be.a('string'));"
                        ]
                    }
                }
            ]
        },
        {
            "name": "POST /feedback/requests — Create Feedback Request",
            "request": {
                "method": "POST",
                "header": [
                    { "key": "Content-Type", "value": "application/json" },
                    { "key": "Authorization", "value": "Bearer {{accessToken}}" },
                    { "key": "X-Branch-Id", "value": "{{branchId}}" }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"source\": \"QR\",\n  \"customerName\": \"Postman Test\",\n  \"customerEmail\": \"test@postman.local\"\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/api/feedback/requests",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "feedback", "requests"]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const body = pm.response.json();",
                            "pm.environment.set('feedbackRequestId', body.id);",
                            "pm.environment.set('feedbackToken', body.token);",
                            "pm.test('201 Created', () => pm.response.to.have.status(201));",
                            "pm.test('Has token', () => pm.expect(body.token).to.be.a('string'));",
                            "pm.test('Status PENDING', () => pm.expect(body.status).to.eql('PENDING'));"
                        ]
                    }
                }
            ]
        },
        {
            "name": "GET /feedback/requests — List Requests",
            "request": {
                "method": "GET",
                "header": [
                    { "key": "Authorization", "value": "Bearer {{accessToken}}" },
                    { "key": "X-Branch-Id", "value": "{{branchId}}" }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/feedback/requests",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "feedback", "requests"]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('200 OK', () => pm.response.to.have.status(200));",
                            "pm.test('Is array', () => pm.expect(pm.response.json()).to.be.an('array'));"
                        ]
                    }
                }
            ]
        },
        {
            "name": "GET /feedback/public/token/:token — Public Lookup",
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "{{baseUrl}}/api/feedback/public/token/{{feedbackToken}}",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "feedback", "public", "token", "{{feedbackToken}}"]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const body = pm.response.json();",
                            "pm.test('200 OK', () => pm.response.to.have.status(200));",
                            "pm.test('Has id', () => pm.expect(body.id).to.be.a('string'));",
                            "pm.test('Has branchName', () => pm.expect(body.branchName).to.be.a('string'));"
                        ]
                    }
                }
            ]
        },
        {
            "name": "POST /feedback/public — Submit Feedback",
            "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"token\": \"{{feedbackToken}}\",\n  \"rating\": 5,\n  \"npsScore\": 9,\n  \"comment\": \"Excellent service from Postman test!\",\n  \"customerName\": \"Postman Tester\"\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/api/feedback/public",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "feedback", "public"]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const body = pm.response.json();",
                            "pm.environment.set('feedbackId', body.id);",
                            "pm.test('201 Created', () => pm.response.to.have.status(201));",
                            "pm.test('NPS bucket PROMOTER', () => pm.expect(body.npsBucket).to.eql('PROMOTER'));",
                            "pm.test('Sentiment POSITIVE', () => pm.expect(body.sentiment).to.eql('POSITIVE'));",
                            "pm.test('Status NEW', () => pm.expect(body.status).to.eql('NEW'));"
                        ]
                    }
                }
            ]
        },
        {
            "name": "GET /feedback — List Feedback",
            "request": {
                "method": "GET",
                "header": [
                    { "key": "Authorization", "value": "Bearer {{accessToken}}" },
                    { "key": "X-Branch-Id", "value": "{{branchId}}" }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/feedback",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "feedback"]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const body = pm.response.json();",
                            "pm.test('200 OK', () => pm.response.to.have.status(200));",
                            "pm.test('Has data array', () => pm.expect(body.data).to.be.an('array'));",
                            "pm.test('Has total', () => pm.expect(body.total).to.be.a('number'));"
                        ]
                    }
                }
            ]
        },
        {
            "name": "GET /feedback/:id — Get Feedback Detail",
            "request": {
                "method": "GET",
                "header": [
                    { "key": "Authorization", "value": "Bearer {{accessToken}}" },
                    { "key": "X-Branch-Id", "value": "{{branchId}}" }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/feedback/{{feedbackId}}",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "feedback", "{{feedbackId}}"]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const body = pm.response.json();",
                            "pm.test('200 OK', () => pm.response.to.have.status(200));",
                            "pm.test('Has tags', () => pm.expect(body.tags).to.be.an('array'));",
                            "pm.test('Has feedbackRequest', () => pm.expect(body.feedbackRequest).to.be.an('object'));"
                        ]
                    }
                }
            ]
        },
        {
            "name": "PATCH /feedback/:id/tag — Tag Feedback",
            "request": {
                "method": "PATCH",
                "header": [
                    { "key": "Content-Type", "value": "application/json" },
                    { "key": "Authorization", "value": "Bearer {{accessToken}}" },
                    { "key": "X-Branch-Id", "value": "{{branchId}}" }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"tagKey\": \"SERVICE_QUALITY\",\n  \"tagLabel\": \"Service Quality\"\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/api/feedback/{{feedbackId}}/tag",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "feedback", "{{feedbackId}}", "tag"]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const body = pm.response.json();",
                            "pm.test('200 OK', () => pm.response.to.have.status(200));",
                            "pm.test('Tag key matches', () => pm.expect(body.tagKey).to.eql('SERVICE_QUALITY'));"
                        ]
                    }
                }
            ]
        },
        {
            "name": "GET /feedback/tags — List Tags",
            "request": {
                "method": "GET",
                "header": [
                    { "key": "Authorization", "value": "Bearer {{accessToken}}" },
                    { "key": "X-Branch-Id", "value": "{{branchId}}" }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/feedback/tags",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "feedback", "tags"]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('200 OK', () => pm.response.to.have.status(200));",
                            "pm.test('Is array', () => pm.expect(pm.response.json()).to.be.an('array'));"
                        ]
                    }
                }
            ]
        },
        {
            "name": "PATCH /feedback/:id/acknowledge — Acknowledge",
            "request": {
                "method": "PATCH",
                "header": [
                    { "key": "Authorization", "value": "Bearer {{accessToken}}" },
                    { "key": "X-Branch-Id", "value": "{{branchId}}" }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/feedback/{{feedbackId}}/acknowledge",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "feedback", "{{feedbackId}}", "acknowledge"]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const body = pm.response.json();",
                            "pm.test('200 OK', () => pm.response.to.have.status(200));",
                            "pm.test('Status ACKNOWLEDGED', () => pm.expect(body.status).to.eql('ACKNOWLEDGED'));"
                        ]
                    }
                }
            ]
        },
        {
            "name": "PATCH /feedback/:id/resolve — Resolve",
            "request": {
                "method": "PATCH",
                "header": [
                    { "key": "Content-Type", "value": "application/json" },
                    { "key": "Authorization", "value": "Bearer {{accessToken}}" },
                    { "key": "X-Branch-Id", "value": "{{branchId}}" }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"resolutionNotes\": \"Addressed customer concern via phone call.\"\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/api/feedback/{{feedbackId}}/resolve",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "feedback", "{{feedbackId}}", "resolve"]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const body = pm.response.json();",
                            "pm.test('200 OK', () => pm.response.to.have.status(200));",
                            "pm.test('Status RESOLVED', () => pm.expect(body.status).to.eql('RESOLVED'));"
                        ]
                    }
                }
            ]
        },
        {
            "name": "GET /feedback/nps-summary — NPS Analytics",
            "request": {
                "method": "GET",
                "header": [
                    { "key": "Authorization", "value": "Bearer {{accessToken}}" },
                    { "key": "X-Branch-Id", "value": "{{branchId}}" }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/feedback/nps-summary",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "feedback", "nps-summary"]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const body = pm.response.json();",
                            "pm.test('200 OK', () => pm.response.to.have.status(200));",
                            "pm.test('Has NPS score', () => pm.expect(body.npsScore).to.be.a('number'));",
                            "pm.test('Has promoters', () => pm.expect(body.promoters).to.be.a('number'));",
                            "pm.test('Has detractors', () => pm.expect(body.detractors).to.be.a('number'));"
                        ]
                    }
                }
            ]
        },
        {
            "name": "PATCH /feedback/requests/:id/cancel — Cancel Request",
            "request": {
                "method": "PATCH",
                "header": [
                    { "key": "Authorization", "value": "Bearer {{accessToken}}" },
                    { "key": "X-Branch-Id", "value": "{{branchId}}" }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/feedback/requests/{{feedbackRequestId}}/cancel",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "feedback", "requests", "{{feedbackRequestId}}", "cancel"]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const body = pm.response.json();",
                            "pm.test('200 OK or 409 (already submitted)', () => {",
                            "  pm.expect([200, 409]).to.include(pm.response.code);",
                            "});"
                        ]
                    }
                }
            ]
        }
    ]
}
