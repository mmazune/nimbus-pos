                            "host": ["{{baseUrl}}"],
                            "path": ["api", "workforce", "coverage-rules"]
                        }
                    }
                }
            ]
        },
        {
            "name": "Coverage Gaps",
            "item": [
                {
                    "name": "Get Coverage Gaps",
                    "event": [
