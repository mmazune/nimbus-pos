{
    "info": {
        "_postman_id": "m3_1-quick-pin-login",
        "name": "M3_1-Quick-PIN-Login",
        "description": "M3.1 — Quick PIN Login for POS Desktop. PIN-only login by role tier.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "auth": {
        "type": "bearer",
        "bearer": [
            {
                "key": "token",
                "value": "{{accessToken}}",
                "type": "string"
            }
        ]
    },
    "item": [
        {
            "name": "01 — Login (Owner)",
            "request": {
                "auth": {
                    "type": "noauth"
                },
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"email\": \"owner@demo.local\",\n    \"password\": \"Owner#123\"\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/api/auth/login",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "auth",
                        "login"
                    ]
                }
            },
            "event": [
                {
                    "listen": "prerequest",
                    "script": {
                        "exec": [
                            "// Warm up Neon DB connection (avoids cold-start 500 on first request)",
                            "pm.sendRequest(pm.environment.get('baseUrl') + '/api/health', (err, res) => {",
                            "    console.log('[WARM-UP] /api/health →', res ? res.code : err);",
                            "});",
                            "// Clear stale PIN vars from previous runs",
                            "pm.environment.unset('waiterQuickPin');",
                            "pm.environment.unset('cashierQuickPin');",
                            "pm.environment.unset('managerQuickPin');",
                            "pm.environment.unset('quickPinAccessToken');"
                        ],
                        "type": "text/javascript"
                    }
                },
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const res = pm.response.json();",
                            "pm.test('Login returns 201', () => pm.response.to.have.status(201));",
                            "pm.test('Has tokens', () => {",
                            "    pm.expect(res.accessToken).to.be.a('string');",
                            "    pm.expect(res.refreshToken).to.be.a('string');",
                            "});",
                            "if (res.accessToken) pm.environment.set('accessToken', res.accessToken);",
                            "if (res.refreshToken) pm.environment.set('refreshToken', res.refreshToken);",
                            "if (res.user && res.user.id) pm.environment.set('userId', res.user.id);",
                            "console.log('[01] Owner login status:', pm.response.code, 'accessToken set:', !!pm.environment.get('accessToken'));"
                        ],
                        "type": "text/javascript"
                    }
                }
            ]
        },
        {
            "name": "02 — Get Me (resolve branchId)",
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "{{baseUrl}}/api/me",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "me"
                    ]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const res = pm.response.json();",
                            "pm.test('Me returns 200', () => pm.response.to.have.status(200));",
                            "// Extract branchId from defaultBranch (tenancy context response)",
                            "if (res.defaultBranch && res.defaultBranch.id) {",
                            "    pm.environment.set('branchId', res.defaultBranch.id);",
                            "}",
                            "// Extract orgId from first organization",
                            "if (res.organizations && res.organizations.length > 0) {",
                            "    pm.environment.set('orgId', res.organizations[0].id);",
                            "}",
                            "pm.test('branchId resolved', () => pm.expect(pm.environment.get('branchId')).to.be.a('string').and.not.empty);",
                            "console.log('[02] branchId →', pm.environment.get('branchId'));",
                            "console.log('[02] defaultBranch →', res.defaultBranch ? res.defaultBranch.id : 'NULL');"
                        ],
                        "type": "text/javascript"
                    }
                }
            ]
        },
