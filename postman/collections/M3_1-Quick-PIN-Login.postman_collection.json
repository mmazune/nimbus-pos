        {
            "name": "06 — Issue Quick PIN (Waiter, 6-digit)",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"branchId\": \"{{branchId}}\"\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/api/auth/users/{{waiterUserId}}/issue-quick-pin",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "auth",
                        "users",
                        "{{waiterUserId}}",
                        "issue-quick-pin"
                    ]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const res = pm.response.json();",
                            "pm.test('Issue returns 201', () => pm.response.to.have.status(201));",
                            "pm.test('PIN is 6 digits', () => {",
                            "    pm.expect(res.pinLength).to.equal(6);",
                            "    pm.expect(res.pin).to.match(/^\\d{6}$/);",
                            "});",
                            "pm.test('Tier is LOW_6', () => pm.expect(res.tier).to.equal('LOW_6'));",
                            "if (res.pin) pm.environment.set('waiterQuickPin', res.pin);",
                            "console.log('[06] Issue Waiter PIN status:', pm.response.code, 'pin saved:', pm.environment.get('waiterQuickPin'));"
                        ],
                        "type": "text/javascript"
                    }
                }
            ]
        },
