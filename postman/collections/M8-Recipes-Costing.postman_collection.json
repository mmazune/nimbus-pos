{
    "info": {
        "_postman_id": "m8-recipes-costing",
        "name": "M8 — Recipes + Ingredient Costing",
        "description": "Nimbus POS — M8 inventory items, recipes, and COGS cost breakdown.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "auth": {
        "type": "bearer",
        "bearer": [
            {
                "key": "token",
                "value": "{{accessToken}}",
                "type": "string"
            }
        ]
    },
    "item": [
        {
            "name": "Login (Owner)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const json = pm.response.json();",
                            "pm.environment.set('accessToken', json.accessToken);",
                            "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                            "pm.test('Has accessToken', () => pm.expect(json.accessToken).to.be.a('string'));"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "auth": {
                    "type": "noauth"
                },
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"email\": \"owner@demo.local\",\n  \"password\": \"Owner#123\"\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/api/auth/login",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "auth",
                        "login"
                    ]
                }
            }
        },
        {
            "name": "Inventory Items",
            "item": [
                {
                    "name": "Create Inventory Item",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "const json = pm.response.json();",
                                    "pm.environment.set('inventoryItemId', json.id);",
                                    "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                                    "pm.test('Has id', () => pm.expect(json.id).to.be.a('string'));",
                                    "pm.test('Name matches', () => pm.expect(json.name).to.eql('PM Beef Patty'));",
                                    "pm.test('Unit is kg', () => pm.expect(json.unit).to.eql('kg'));"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "X-Branch-Id",
                                "value": "{{branchId}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"name\": \"PM Beef Patty\",\n  \"unit\": \"kg\",\n  \"category\": \"Protein\",\n  \"theoreticalUnitCost\": \"12.500\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/inventory/items",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "inventory",
                                "items"
                            ]
                        }
                    }
                },
                {
                    "name": "Create Second Inventory Item",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "const json = pm.response.json();",
                                    "pm.environment.set('inventoryItemId2', json.id);",
                                    "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                                    "pm.test('Name matches', () => pm.expect(json.name).to.eql('PM Bun'));"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "X-Branch-Id",
                                "value": "{{branchId}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"name\": \"PM Bun\",\n  \"unit\": \"pcs\",\n  \"category\": \"Bakery\",\n  \"theoreticalUnitCost\": \"0.500\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/inventory/items",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "inventory",
                                "items"
                            ]
                        }
                    }
                },
                {
                    "name": "List Inventory Items",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "const json = pm.response.json();",
                                    "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                                    "pm.test('Is array', () => pm.expect(json).to.be.an('array'));",
                                    "pm.test('Has items', () => pm.expect(json.length).to.be.greaterThan(0));"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "X-Branch-Id",
                                "value": "{{branchId}}"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/inventory/items",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "inventory",
                                "items"
                            ]
                        }
                    }
                },
                {
                    "name": "Get Inventory Item by ID",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "const json = pm.response.json();",
                                    "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                                    "pm.test('ID matches', () => pm.expect(json.id).to.eql(pm.environment.get('inventoryItemId')));"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "X-Branch-Id",
                                "value": "{{branchId}}"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/inventory/items/{{inventoryItemId}}",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "inventory",
                                "items",
                                "{{inventoryItemId}}"
                            ]
                        }
                    }
                },
                {
                    "name": "Update Inventory Item",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "const json = pm.response.json();",
                                    "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                                    "pm.test('Cost updated', () => pm.expect(json.theoreticalUnitCost).to.exist);"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "PATCH",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "X-Branch-Id",
                                "value": "{{branchId}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"theoreticalUnitCost\": \"13.000\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/inventory/items/{{inventoryItemId}}",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "inventory",
                                "items",
                                "{{inventoryItemId}}"
                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "Recipes",
            "item": [
                {
                    "name": "Set Recipe for Menu Item",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "const json = pm.response.json();",
                                    "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                                    "pm.test('Has menuItemId', () => pm.expect(json.menuItemId).to.be.a('string'));",
                                    "pm.test('Has ingredients', () => pm.expect(json.ingredientCount).to.eql(2));"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "X-Branch-Id",
                                "value": "{{branchId}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"ingredients\": [\n    {\n      \"inventoryItemId\": \"{{inventoryItemId}}\",\n      \"qtyPerUnit\": \"0.200\",\n      \"wastePct\": \"5\",\n      \"unit\": \"kg\"\n    },\n    {\n      \"inventoryItemId\": \"{{inventoryItemId2}}\",\n      \"qtyPerUnit\": \"2\",\n      \"unit\": \"pcs\"\n    }\n  ]\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/inventory/recipes/{{menuItemId}}",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "inventory",
                                "recipes",
                                "{{menuItemId}}"
                            ]
                        }
                    }
                },
                {
                    "name": "Get Recipe",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "const json = pm.response.json();",
                                    "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                                    "pm.test('Has menuItem', () => pm.expect(json.menuItem).to.be.an('object'));",
                                    "pm.test('Has baseIngredients', () => pm.expect(json.baseIngredients).to.be.an('array'));"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "X-Branch-Id",
                                "value": "{{branchId}}"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/inventory/recipes/{{menuItemId}}",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "inventory",
                                "recipes",
                                "{{menuItemId}}"
                            ]
                        }
                    }
                },
                {
                    "name": "Get Recipe Cost Breakdown",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "const json = pm.response.json();",
                                    "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                                    "pm.test('Has totalTheoreticalCogs', () => pm.expect(json.totalTheoreticalCogs).to.be.a('string'));",
                                    "pm.test('Has margin', () => pm.expect(json.margin).to.be.a('string'));",
                                    "pm.test('Has rows', () => pm.expect(json.rows).to.be.an('array'));",
                                    "pm.test('Has sellingPrice', () => pm.expect(json.sellingPrice).to.be.a('string'));"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "X-Branch-Id",
                                "value": "{{branchId}}"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/inventory/recipes/{{menuItemId}}/cost",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "inventory",
                                "recipes",
                                "{{menuItemId}}",
                                "cost"
                            ]
                        }
                    }
                }
            ]
        }
    ]
}