      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Correct ID', () => pm.expect(pm.response.json().id).to.equal(pm.environment.get('reservationId')));"
            ]
          }
        }
      ]
    },
