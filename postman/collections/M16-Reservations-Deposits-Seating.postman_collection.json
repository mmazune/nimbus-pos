          "mode": "raw",
          "raw": "{\n  \"notes\": \"Confirmed via Postman\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/reservations/{{reservationId}}/confirm",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "reservations",
            "{{reservationId}}",
            "confirm"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Status CONFIRMED', () => pm.expect(pm.response.json().status).to.equal('CONFIRMED'));"
