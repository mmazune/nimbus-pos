{
    "info":  {
                 "name":  "M16 — Reservations + Deposits + Seating",
                 "description":  "Nimbus POS M16: Reservations lifecycle, deposit tracking, and seating bridge.\n\n## Endpoints\n- POST /reservations — Create reservation\n- GET /reservations — List reservations (paginated, filterable)\n- GET /reservations/upcoming — List upcoming (PENDING/CONFIRMED)\n- GET /reservations/:id — Get reservation by ID\n- PATCH /reservations/:id/confirm — Confirm reservation\n- PATCH /reservations/:id/seat — Seat reservation (optional order creation)\n- PATCH /reservations/:id/cancel — Cancel reservation\n- PATCH /reservations/:id/no-show — Mark as no-show\n- POST /reservations/:id/deposits — Record deposit\n- GET /reservations/:id/deposits — List deposits\n- GET /reservations/:id/events — List events\n- PATCH /reservations/:id/assign-table — Assign table",
                 "schema":  "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
             },
    "auth":  {
                 "type":  "bearer",
                 "bearer":  [
                                {
                                    "key":  "token",
                                    "value":  "{{accessToken}}",
                                    "type":  "string"
                                }
                            ]
             },
    "variable":  [
                     {
                         "key":  "baseUrl",
                         "value":  "http://localhost:3001"
                     },
                     {
                         "key":  "accessToken",
                         "value":  ""
                     },
                     {
                         "key":  "branchId",
                         "value":  ""
                     },
                     {
                         "key":  "reservationId",
                         "value":  ""
                     },
                     {
                         "key":  "tableId",
                         "value":  ""
                     }
                 ],
    "item":  [
                 {
                     "name":  "Auth — Login (Owner)",
                     "request":  {
                                     "method":  "POST",
                                     "header":  [
                                                    {
                                                        "key":  "Content-Type",
                                                        "value":  "application/json"
                                                    }
                                                ],
                                     "body":  {
                                                  "mode":  "raw",
                                                  "raw":  "{\n  \"email\": \"owner@demo.local\",\n  \"password\": \"Owner#123\"\n}"
                                              },
                                     "url":  {
                                                 "raw":  "{{baseUrl}}/api/auth/login",
                                                 "host":  [
                                                              "{{baseUrl}}"
                                                          ],
                                                 "path":  [
                                                              "api",
                                                              "auth",
                                                              "login"
                                                          ]
                                             }
                                 },
                     "event":  [
                                   {
                                       "listen":  "test",
                                       "script":  {
                                                      "exec":  [
                                                                   "const body = pm.response.json();",
                                                                   "pm.environment.set(\u0027accessToken\u0027, body.accessToken);",
                                                                   "pm.test(\u0027Login OK\u0027, () =\u003e pm.response.to.have.status(200));"
                                                               ]
                                                  }
                                   }
                               ]
                 },
                 {
                     "name":  "Auth — Get /me (capture branchId)",
                     "request":  {
                                     "method":  "GET",
                                     "header":  [

                                                ],
                                     "url":  {
                                                 "raw":  "{{baseUrl}}/api/me",
                                                 "host":  [
                                                              "{{baseUrl}}"
                                                          ],
                                                 "path":  [
                                                              "api",
                                                              "me"
                                                          ]
                                             }
                                 },
                     "event":  [
                                   {
                                       "listen":  "test",
                                       "script":  {
                                                      "exec":  [
                                                                   "const body = pm.response.json();",
                                                                   "const bid = body.defaultBranch?.id || body.organizations?.[0]?.branches?.[0]?.id || body.memberships?.[0]?.branchId;",
                                                                   "pm.environment.set(\u0027branchId\u0027, bid);",
                                                                   "pm.test(\u0027Got branchId\u0027, () =\u003e pm.expect(bid).to.be.a(\u0027string\u0027));"
                                                               ]
                                                  }
                                   }
                               ]
                 },
                 {
                     "name":  "Create Reservation",
                     "request":  {
                                     "method":  "POST",
                                     "header":  [
                                                    {
                                                        "key":  "Content-Type",
                                                        "value":  "application/json"
                                                    },
                                                    {
                                                        "key":  "X-Branch-Id",
                                                        "value":  "{{branchId}}"
                                                    }
                                                ],
                                     "body":  {
                                                  "mode":  "raw",
                                                  "raw":  "{\n  \"customerName\": \"Postman Test Guest\",\n  \"partySize\": 4,\n  \"reservationAt\": \"{{$isoTimestamp}}\",\n  \"source\": \"PHONE\",\n  \"notes\": \"Test reservation via Postman\",\n  \"depositRequired\": 50000\n}"
                                              },
                                     "url":  {
                                                 "raw":  "{{baseUrl}}/api/reservations",
                                                 "host":  [
                                                              "{{baseUrl}}"
                                                          ],
                                                 "path":  [
                                                              "api",
                                                              "reservations"
                                                          ]
                                             }
                                 },
                     "event":  [
                                   {
                                       "listen":  "test",
                                       "script":  {
                                                      "exec":  [
                                                                   "const body = pm.response.json();",
                                                                   "pm.environment.set(\u0027reservationId\u0027, body.id);",
                                                                   "pm.test(\u0027Created 201\u0027, () =\u003e pm.response.to.have.status(201));",
                                                                   "pm.test(\u0027Has reservation number\u0027, () =\u003e pm.expect(body.reservationNumber).to.match(/^RES-/));",
                                                                   "pm.test(\u0027Status PENDING\u0027, () =\u003e pm.expect(body.status).to.equal(\u0027PENDING\u0027));"
                                                               ]
                                                  }
                                   }
                               ]
