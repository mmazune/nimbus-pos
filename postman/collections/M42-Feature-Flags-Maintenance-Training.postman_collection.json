    "event": [
        {
            "listen": "prerequest",
            "script": {
                "type": "text/javascript",
                "exec": [
                    "// M42 canonical pre-request (R3/R4/R5/R14/R16/R17).",
                    "const baseUrl = pm.collectionVariables.get('baseUrl') || 'http://localhost:3001';",
                    "const ownerEmail = pm.collectionVariables.get('ownerEmail') || 'owner@demo.local';",
                    "const ownerPassword = pm.collectionVariables.get('ownerPassword') || 'Owner#123';",
                    "const url = pm.request && pm.request.url ? pm.request.url.toString() : '';",
                    "let reqStr = '';",
                    "try { reqStr = JSON.stringify(pm.request); } catch (e) { reqStr = url; }",
                    "const isPublicAuth = /\\/api\\/auth\\/login/.test(url);",
                    "const isHealth = /\\/api\\/health(\\?|$)/.test(url);",
                    "const isPublic = isPublicAuth || isHealth;",
                    "function refsVar(name) { return reqStr.indexOf('{{' + name + '}}') !== -1; }",
                    "function getVar(k) {",
                    "  if (pm.environment && pm.environment.name) {",
                    "    const ev = pm.environment.get(k);",
                    "    if (ev !== undefined && ev !== null && ev !== '') return ev;",
                    "  }",
                    "  return pm.collectionVariables.get(k);",
                    "}",
                    "function setVar(k, v) {",
                    "  if (v === undefined || v === null || v === '') return;",
                    "  pm.collectionVariables.set(k, v);",
                    "  if (pm.environment && pm.environment.name) pm.environment.set(k, v);",
                    "}",
                    "function ensureToken() {",
                    "  return new Promise((resolve) => {",
                    "    const tok = getVar('accessToken');",
                    "    if (isPublic || (tok && tok.length >= 20)) { return resolve(); }",
                    "    pm.sendRequest({",
                    "      url: baseUrl + '/api/auth/login',",
                    "      method: 'POST',",
                    "      header: { 'Content-Type': 'application/json' },",
                    "      body: { mode: 'raw', raw: JSON.stringify({ email: ownerEmail, password: ownerPassword }) }",
                    "    }, (err, res) => {",
                    "      if (!err && res) {",
                    "        try {",
                    "          const j = res.json();",
                    "          if (j.accessToken) setVar('accessToken', j.accessToken);",
                    "          if (j.refreshToken) setVar('refreshToken', j.refreshToken);",
                    "          if (j.user && j.user.organizationId) setVar('orgId', j.user.organizationId);",
                    "        } catch (e) { /* ignore */ }",
                    "      }",
                    "      resolve();",
                    "    });",
                    "  });",
                    "}",
                    "function ensureMeContext() {",
                    "  return new Promise((resolve) => {",
                    "    if (isPublic) return resolve();",
                    "    const needBranch = refsVar('branchId') && !getVar('branchId');",
                    "    const needOrg = refsVar('orgId') && !getVar('orgId');",
                    "    if (!needBranch && !needOrg) return resolve();",
                    "    const tok = getVar('accessToken');",
                    "    if (!tok) return resolve();",
                    "    pm.sendRequest({",
                    "      url: baseUrl + '/api/auth/me',",
                    "      method: 'GET',",
                    "      header: { 'Authorization': 'Bearer ' + tok }",
                    "    }, (err, res) => {",
                    "      if (!err && res) {",
                    "        try {",
                    "          const j = res.json();",
                    "          if (j.context) {",
                    "            if (j.context.defaultOrganizationId) setVar('orgId', j.context.defaultOrganizationId);",
                    "            if (j.context.defaultBranchId) setVar('branchId', j.context.defaultBranchId);",
                    "          }",
                    "          if (Array.isArray(j.memberships) && j.memberships.length) {",
                    "            if (!getVar('orgId')) setVar('orgId', j.memberships[0].organizationId);",
                    "            if (!getVar('branchId')) setVar('branchId', j.memberships[0].branchId);",
                    "          }",
                    "        } catch (e) { /* ignore */ }",
                    "      }",
                    "      resolve();",
                    "    });",
                    "  });",
                    "}",
                    "function ensureInventoryItem() {",
                    "  return new Promise((resolve) => {",
                    "    if (isPublic) return resolve();",
                    "    if (!refsVar('inventoryItemId')) return resolve();",
                    "    if (getVar('inventoryItemId')) return resolve();",
                    "    const tok = getVar('accessToken');",
                    "    const branchId = getVar('branchId');",
                    "    if (!tok || !branchId) return resolve();",
                    "    // R17: list first; create only if list is empty.",
                    "    pm.sendRequest({",
                    "      url: baseUrl + '/api/inventory/items?take=1',",
                    "      method: 'GET',",
                    "      header: { 'Authorization': 'Bearer ' + tok, 'X-Branch-Id': branchId }",
                    "    }, (err, res) => {",
                    "      if (!err && res && res.code === 200) {",
                    "        try {",
                    "          const j = res.json();",
                    "          const items = Array.isArray(j) ? j : (j.items || j.data || []);",
                    "          if (items[0] && items[0].id) { setVar('inventoryItemId', items[0].id); return resolve(); }",
                    "        } catch (e) { /* ignore */ }",
                    "      }",
                    "      pm.sendRequest({",
                    "        url: baseUrl + '/api/inventory/items',",
                    "        method: 'POST',",
                    "        header: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + tok, 'X-Branch-Id': branchId },",
                    "        body: { mode: 'raw', raw: JSON.stringify({ name: 'M42 PM Item ' + Date.now(), unit: 'kg', category: 'Produce', theoreticalUnitCost: '1.000', reorderLevel: '5.000', reorderQty: '20.000' }) }",
                    "      }, (e2, r2) => {",
                    "        if (!e2 && r2) { try { const j2 = r2.json(); if (j2.id) setVar('inventoryItemId', j2.id); } catch (e) { /* ignore */ } }",
                    "        resolve();",
                    "      });",
                    "    });",
                    "  });",
                    "}",
                    "function ensureFlagKey() {",
                    "  return new Promise((resolve) => {",
                    "    if (!refsVar('flagKey')) return resolve();",
                    "    setVar('flagKey', 'pm_m42_' + Date.now() + '_' + Math.floor(Math.random()*1e6));",
                    "    resolve();",
                    "  });",
                    "}",
                    "function ensureWindowCode() {",
                    "  return new Promise((resolve) => {",
                    "    if (!refsVar('windowCode')) return resolve();",
                    "    setVar('windowCode', 'pm-m42-window-' + Date.now() + '-' + Math.floor(Math.random()*1e6));",
                    "    resolve();",
                    "  });",
                    "}",
                    "return ensureToken()",
                    "  .then(ensureMeContext)",
                    "  .then(ensureInventoryItem)",
                    "  .then(ensureFlagKey)",
                    "  .then(ensureWindowCode)",
                    "  .catch((e) => console.log('[m42 prereq] chain error', e && e.message));"
                ]
            }
        }
    ],
    "item": [
