        {
            "name": "C. Maintenance Windows",
            "description": "[STANDALONE] Create SCHEDULED BLOCK_WRITES INVENTORY window, activate, prove inventory blocked (409), then complete.",
            "item": [
                {
                    "name": "POST /api/maintenance-windows (SCHEDULED BLOCK_WRITES INVENTORY)",
                    "event": [
                        {
                            "listen": "prerequest",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "// startsAt 5 min ago, endsAt 60 min from now (so ACTIVE PATCH will block immediately).",
                                    "pm.collectionVariables.set('windowStartsAt', new Date(Date.now() - 5 * 60 * 1000).toISOString());",
                                    "pm.collectionVariables.set('windowEndsAt', new Date(Date.now() + 60 * 60 * 1000).toISOString());"
                                ]
                            }
                        },
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('201 Created', () => pm.response.to.have.status(201));",
                                    "const j = pm.response.json();",
                                    "pm.test('status SCHEDULED', () => pm.expect(j.status).to.eql('SCHEDULED'));",
                                    "pm.test('mode BLOCK_WRITES', () => pm.expect(j.mode).to.eql('BLOCK_WRITES'));",
                                    "pm.test('blocks INVENTORY_WRITES', () => pm.expect(j.blockCategories).to.include('INVENTORY_WRITES'));",
                                    "pm.collectionVariables.set('windowId', j.id);",
                                    "if (pm.environment && pm.environment.name) pm.environment.set('windowId', j.id);"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{accessToken}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"code\": \"{{windowCode}}\",\n  \"title\": \"PM inventory block\",\n  \"message\": \"Inventory writes paused for Postman test.\",\n  \"mode\": \"BLOCK_WRITES\",\n  \"blockCategories\": [\"INVENTORY_WRITES\"],\n  \"startsAt\": \"{{windowStartsAt}}\",\n  \"endsAt\": \"{{windowEndsAt}}\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/maintenance-windows",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "maintenance-windows"
                            ]
                        }
                    }
                },
