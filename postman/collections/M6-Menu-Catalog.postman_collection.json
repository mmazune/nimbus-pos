        {
            "name": "Get Me (resolve branchId)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const json = pm.response.json();",
                            "if (json.memberships && json.memberships.length > 0) {",
                            "  pm.environment.set('branchId', json.memberships[0].branchId);",
                            "  pm.environment.set('orgId', json.memberships[0].organizationId);",
                            "}",
                            "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                            "pm.test('Has memberships', () => pm.expect(json.memberships).to.be.an('array'));"
                        ],
                        "type": "text/javascript"
