                            "pm.test('Matches tillId', () => pm.expect(json.id).to.eql(pm.environment.get('tillId')));"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "X-Branch-Id",
                        "value": "{{branchId}}"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/tills/active",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "tills",
                        "active"
                    ]
                }
            }
        },
        {
            "name": "Get Till by ID",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const json = pm.response.json();",
                            "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                            "pm.test('Correct till', () => pm.expect(json.id).to.eql(pm.environment.get('tillId')));",
                            "pm.test('Has cashMovements', () => pm.expect(json.cashMovements).to.be.an('array'));"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "X-Branch-Id",
