                        "{{tillId}}"
                    ]
                }
            }
        },
        {
            "name": "Safe Drop",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const json = pm.response.json();",
                            "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                            "pm.test('Type is SAFE_DROP', () => pm.expect(json.type).to.eql('SAFE_DROP'));",
                            "pm.test('Amount is 20000', () => pm.expect(parseFloat(json.amount)).to.eql(20000));"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    },
                    {
                        "key": "X-Branch-Id",
                        "value": "{{branchId}}"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{ \"amount\": 20000, \"reason\": \"Postman safe drop test\" }"
                },
                "url": {
                    "raw": "{{baseUrl}}/api/tills/{{tillId}}/safe-drop",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "tills",
                        "{{tillId}}",
                        "safe-drop"
                    ]
                }
            }
        },
