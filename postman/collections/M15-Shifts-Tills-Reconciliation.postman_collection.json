            "name": "Get Till Summary",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const json = pm.response.json();",
                            "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                            "pm.test('Has computedExpectedCash', () => pm.expect(json.computedExpectedCash).to.be.a('string'));"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "X-Branch-Id",
                        "value": "{{branchId}}"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/tills/{{tillId}}/summary",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "tills",
                        "{{tillId}}",
                        "summary"
                    ]
                }
            }
        },
        {
            "name": "Reconcile Till",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const json = pm.response.json();",
                            "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                            "pm.test('Status is RECONCILED', () => pm.expect(json.status).to.eql('RECONCILED'));",
                            "pm.test('Has varianceStatus', () => pm.expect(json.varianceStatus).to.be.oneOf(['MATCHED', 'SHORT', 'OVER']));"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    },
                    {
                        "key": "X-Branch-Id",
                        "value": "{{branchId}}"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{ \"countedCash\": 30000, \"varianceReason\": \"Postman reconciliation test\" }"
                },
                "url": {
                    "raw": "{{baseUrl}}/api/tills/{{tillId}}/reconcile",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "tills",
                        "{{tillId}}",
                        "reconcile"
                    ]
                }
            }
        },
