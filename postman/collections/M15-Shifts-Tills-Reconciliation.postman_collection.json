{
    "info": {
        "_postman_id": "m15-shifts-tills-reconciliation",
        "name": "M15 — Shifts + Till Sessions + Cash Reconciliation",
        "description": "Nimbus POS — M15: Shift lifecycle (open/close), till sessions (open/safe-drop/reconcile), expected cash computation, variance tracking.\n\nWorkflow: Login → Get branch → Open shift → Open till → Safe drop → Get till summary → Reconcile till → Close shift → Get shift summary.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "auth": {
        "type": "bearer",
        "bearer": [
            {
                "key": "token",
                "value": "{{accessToken}}",
                "type": "string"
            }
        ]
    },
    "item": [
        {
            "name": "Login (Owner)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const json = pm.response.json();",
                            "pm.environment.set('accessToken', json.accessToken);",
                            "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                            "pm.test('Has accessToken', () => pm.expect(json.accessToken).to.be.a('string'));"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{ \"email\": \"owner@demo.local\", \"password\": \"Owner#123\" }"
                },
                "url": {
                    "raw": "{{baseUrl}}/api/auth/login",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "auth",
                        "login"
                    ]
                }
            }
        },
        {
            "name": "Get Branch ID",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const json = pm.response.json();",
                            "const branchId = json.defaultBranch?.id || json.organizations?.[0]?.branches?.[0]?.id || json.memberships?.[0]?.branchId;",
                            "pm.environment.set('branchId', branchId);",
                            "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                            "pm.test('Has branchId', () => pm.expect(branchId).to.be.a('string'));"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "{{baseUrl}}/api/me",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "me"
                    ]
                }
            }
        },
        {
            "name": "Open Shift",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const json = pm.response.json();",
                            "pm.environment.set('shiftId', json.id);",
                            "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                            "pm.test('Shift is OPEN', () => pm.expect(json.status).to.eql('OPEN'));",
                            "pm.test('Has shiftNumber', () => pm.expect(json.shiftNumber).to.match(/^SHF-/));"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    },
                    {
                        "key": "X-Branch-Id",
                        "value": "{{branchId}}"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{ \"notes\": \"Postman test shift\" }"
                },
                "url": {
                    "raw": "{{baseUrl}}/api/shifts/open",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "shifts",
                        "open"
                    ]
                }
            }
        },
        {
            "name": "Get Active Shift",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const json = pm.response.json();",
                            "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                            "pm.test('Shift is OPEN', () => pm.expect(json.status).to.eql('OPEN'));",
                            "pm.test('Matches shiftId', () => pm.expect(json.id).to.eql(pm.environment.get('shiftId')));"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "X-Branch-Id",
                        "value": "{{branchId}}"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/shifts/active",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "shifts",
                        "active"
                    ]
                }
            }
        },
        {
            "name": "Get Shift by ID",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const json = pm.response.json();",
                            "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                            "pm.test('Correct shift', () => pm.expect(json.id).to.eql(pm.environment.get('shiftId')));"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "X-Branch-Id",
                        "value": "{{branchId}}"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/shifts/{{shiftId}}",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "shifts",
                        "{{shiftId}}"
                    ]
                }
            }
        },
        {
            "name": "Open Till",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const json = pm.response.json();",
                            "pm.environment.set('tillId', json.id);",
                            "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                            "pm.test('Till is OPEN', () => pm.expect(json.status).to.eql('OPEN'));",
                            "pm.test('TillCode matches', () => pm.expect(json.tillCode).to.eql('TILL-PM'));",
                            "pm.test('OpeningFloat set', () => pm.expect(parseFloat(json.openingFloat)).to.eql(50000));"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    },
                    {
                        "key": "X-Branch-Id",
                        "value": "{{branchId}}"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{ \"tillCode\": \"TILL-PM\", \"openingFloat\": 50000 }"
                },
                "url": {
                    "raw": "{{baseUrl}}/api/tills/open",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "tills",
                        "open"
                    ]
                }
            }
        },
        {
            "name": "Get Active Till",
            "event": [
                {
                    "listen": "test",
