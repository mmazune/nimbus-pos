{
    "info": {
        "_postman_id": "m13-1-mtn-native-manual-reference",
        "name": "M13.1 — MTN Native Request-to-Pay + Manual Reference Fallback",
        "description": "Nimbus POS — M13.1: MTN MOMO native RequestToPay integration, manual reference payments (offline fallback), payment intent status, SSE stream, auto-settle.\n\nWorkflow: Login → Get branch → Create order → Advance to SERVED → Create MTN intent → Get intent → Get intent status → Cancel intent → Create manual-reference → List manual-references → Get order payments with balance → Webhook test → Close order.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "auth": {
        "type": "bearer",
        "bearer": [
            {
                "key": "token",
                "value": "{{accessToken}}",
                "type": "string"
            }
        ]
    },
    "item": [
        {
            "name": "Login (Owner)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const json = pm.response.json();",
                            "pm.environment.set('accessToken', json.accessToken);",
                            "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                            "pm.test('Has accessToken', () => pm.expect(json.accessToken).to.be.a('string'));"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "auth": {
                    "type": "noauth"
                },
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"email\": \"owner@demo.local\",\n  \"password\": \"Owner#123\"\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/api/auth/login",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "auth",
                        "login"
                    ]
                }
            }
        },
        {
            "name": "Get Me (Branch ID)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const json = pm.response.json();",
                            "const branchId = json.defaultBranch?.id || json.organizations?.[0]?.branches?.[0]?.id || json.memberships?.[0]?.branchId;",
                            "pm.environment.set('branchId', branchId);",
                            "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                            "pm.test('Has branchId', () => pm.expect(branchId).to.be.a('string'));"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "GET",
                "url": {
                    "raw": "{{baseUrl}}/api/me",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "me"
                    ]
                }
            }
        },
