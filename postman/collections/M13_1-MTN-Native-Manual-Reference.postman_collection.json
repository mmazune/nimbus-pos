                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"orderId\": \"{{orderId}}\",\n  \"method\": \"MOMO\",\n  \"amount\": 5000,\n  \"externalTransactionId\": \"MTN-PM-REF-001\",\n  \"payerPhone\": \"256700000000\",\n  \"note\": \"Customer showed SMS confirmation on phone\"\n}"
                },
                "url": {
