                            "pm.test('Intent ID matches', () => pm.expect(json.id).to.eql(pm.environment.get('intentId')));",
                            "pm.test('Has provider', () => pm.expect(json.provider).to.eql('MTN'));"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "X-Branch-Id",
                        "value": "{{branchId}}"
                    }
