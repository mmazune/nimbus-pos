        {
            "name": "Create MTN Payment Intent",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const json = pm.response.json();",
                            "pm.environment.set('intentId', json.id);",
                            "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                            "pm.test('Status is REQUIRES_ACTION', () => pm.expect(json.status).to.eql('REQUIRES_ACTION'));",
                            "pm.test('Provider is MTN', () => pm.expect(json.provider).to.eql('MTN'));",
                            "pm.test('Has externalId', () => pm.expect(json.externalId).to.be.a('string'));"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    },
                    {
                        "key": "X-Branch-Id",
                        "value": "{{branchId}}"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"orderId\": \"{{orderId}}\",\n  \"provider\": \"MTN\",\n  \"amount\": 10000,\n  \"phoneNumber\": \"+256700000000\"\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/api/payments/intents",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "payments",
                        "intents"
                    ]
                }
            }
        },
