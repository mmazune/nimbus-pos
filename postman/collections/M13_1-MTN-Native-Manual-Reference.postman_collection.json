        {
            "name": "Create Manual Reference Payment",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const json = pm.response.json();",
                            "pm.environment.set('manualPaymentId', json.payment?.id);",
                            "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                            "pm.test('captureMode is MANUAL_REFERENCE', () => pm.expect(json.payment.captureMode).to.eql('MANUAL_REFERENCE'));",
                            "pm.test('verificationStatus is UNVERIFIED', () => pm.expect(json.payment.verificationStatus).to.eql('UNVERIFIED'));",
                            "pm.test('Has remainingBalance', () => pm.expect(json.remainingBalance).to.be.a('string'));"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    },
