{
    "info": {
        "_postman_id": "m5-floor-plans-tables",
        "name": "M5 — Floor Plans + Tables",
        "description": "Nimbus POS — M5 Floor Plans + Tables milestone. Branch-scoped floor plan and table management.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "auth": {
        "type": "bearer",
        "bearer": [
            {
                "key": "token",
                "value": "{{accessToken}}",
                "type": "string"
            }
        ]
    },
    "item": [
        {
            "name": "Login (Owner)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const json = pm.response.json();",
                            "pm.environment.set('accessToken', json.accessToken);",
                            "pm.environment.set('refreshToken', json.refreshToken);",
                            "pm.environment.set('userId', json.user?.id || '');",
                            "",
                            "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                            "pm.test('Has accessToken', () => pm.expect(json.accessToken).to.be.a('string'));"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "auth": { "type": "noauth" },
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"email\": \"owner@demo.local\",\n  \"password\": \"Owner#123\"\n}"
                },
                "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
            }
        },
        {
            "name": "Login (Waiter) — for permission denial",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const json = pm.response.json();",
                            "pm.environment.set('waiterAccessToken', json.accessToken);",
                            "pm.test('Status is 201', () => pm.response.to.have.status(201));"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "auth": { "type": "noauth" },
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"email\": \"waiter@demo.local\",\n  \"password\": \"Waiter#123\"\n}"
                },
                "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
            }
        },
        {
            "name": "Get Me (resolve branchId)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const json = pm.response.json();",
                            "if (json.memberships && json.memberships.length > 0) {",
                            "  pm.environment.set('branchId', json.memberships[0].branchId);",
                            "  pm.environment.set('orgId', json.memberships[0].organizationId);",
                            "}",
                            "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                            "pm.test('Has memberships', () => pm.expect(json.memberships).to.be.an('array'));"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "GET",
                "header": [],
                "url": { "raw": "{{baseUrl}}/api/me", "host": ["{{baseUrl}}"], "path": ["api", "me"] }
            }
        },
        {
            "name": "Get Floor Plans",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const json = pm.response.json();",
                            "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                            "pm.test('Returns array', () => pm.expect(json).to.be.an('array'));",
                            "if (json.length > 0) {",
                            "  pm.environment.set('floorPlanId', json[0].id);",
                            "  pm.test('First floor plan has name', () => pm.expect(json[0].name).to.be.a('string'));",
                            "}"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "GET",
                "header": [{ "key": "X-Branch-Id", "value": "{{branchId}}" }],
                "url": { "raw": "{{baseUrl}}/api/floor-plans", "host": ["{{baseUrl}}"], "path": ["api", "floor-plans"] }
            }
        },
        {
            "name": "Create Floor Plan",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const json = pm.response.json();",
                            "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                            "pm.test('Has id', () => pm.expect(json.id).to.be.a('string'));",
                            "pm.test('Name matches', () => pm.expect(json.name).to.eql('Postman Test Floor'));",
                            "pm.environment.set('floorPlanId', json.id);"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    { "key": "Content-Type", "value": "application/json" },
                    { "key": "X-Branch-Id", "value": "{{branchId}}" }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"name\": \"Postman Test Floor\",\n  \"data\": { \"layout\": \"freeform\", \"width\": 500, \"height\": 400 }\n}"
                },
                "url": { "raw": "{{baseUrl}}/api/floor-plans", "host": ["{{baseUrl}}"], "path": ["api", "floor-plans"] }
            }
        },
        {
            "name": "Get Floor Plan by ID",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const json = pm.response.json();",
                            "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                            "pm.test('Has correct ID', () => pm.expect(json.id).to.eql(pm.environment.get('floorPlanId')));"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "GET",
                "header": [{ "key": "X-Branch-Id", "value": "{{branchId}}" }],
                "url": { "raw": "{{baseUrl}}/api/floor-plans/{{floorPlanId}}", "host": ["{{baseUrl}}"], "path": ["api", "floor-plans", "{{floorPlanId}}"] }
            }
        },
        {
            "name": "Update Floor Plan",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const json = pm.response.json();",
                            "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                            "pm.test('Name updated', () => pm.expect(json.name).to.eql('Postman Updated Floor'));"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "PATCH",
                "header": [
                    { "key": "Content-Type", "value": "application/json" },
                    { "key": "X-Branch-Id", "value": "{{branchId}}" }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"name\": \"Postman Updated Floor\"\n}"
                },
                "url": { "raw": "{{baseUrl}}/api/floor-plans/{{floorPlanId}}", "host": ["{{baseUrl}}"], "path": ["api", "floor-plans", "{{floorPlanId}}"] }
            }
        },
        {
            "name": "Create Table",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const json = pm.response.json();",
                            "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                            "pm.test('Has id', () => pm.expect(json.id).to.be.a('string'));",
                            "pm.test('Label matches', () => pm.expect(json.label).to.eql('PM-T1'));",
                            "pm.test('Status is AVAILABLE', () => pm.expect(json.status).to.eql('AVAILABLE'));",
                            "pm.environment.set('tableId', json.id);"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    { "key": "Content-Type", "value": "application/json" },
                    { "key": "X-Branch-Id", "value": "{{branchId}}" }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"label\": \"PM-T1\",\n  \"capacity\": 4,\n  \"floorPlanId\": \"{{floorPlanId}}\"\n}"
                },
                "url": { "raw": "{{baseUrl}}/api/tables", "host": ["{{baseUrl}}"], "path": ["api", "tables"] }
            }
        },
        {
            "name": "Get Tables",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const json = pm.response.json();",
                            "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                            "pm.test('Returns array', () => pm.expect(json).to.be.an('array'));",
                            "pm.test('Has at least 1 table', () => pm.expect(json.length).to.be.greaterThan(0));"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "GET",
                "header": [{ "key": "X-Branch-Id", "value": "{{branchId}}" }],
                "url": { "raw": "{{baseUrl}}/api/tables", "host": ["{{baseUrl}}"], "path": ["api", "tables"] }
            }
        },
        {
            "name": "Get Table by ID",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const json = pm.response.json();",
                            "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                            "pm.test('Correct ID', () => pm.expect(json.id).to.eql(pm.environment.get('tableId')));"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "GET",
                "header": [{ "key": "X-Branch-Id", "value": "{{branchId}}" }],
                "url": { "raw": "{{baseUrl}}/api/tables/{{tableId}}", "host": ["{{baseUrl}}"], "path": ["api", "tables", "{{tableId}}"] }
            }
        },
        {
            "name": "Update Table",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const json = pm.response.json();",
                            "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                            "pm.test('Capacity updated', () => pm.expect(json.capacity).to.eql(8));"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "PATCH",
                "header": [
                    { "key": "Content-Type", "value": "application/json" },
                    { "key": "X-Branch-Id", "value": "{{branchId}}" }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"capacity\": 8\n}"
                },
                "url": { "raw": "{{baseUrl}}/api/tables/{{tableId}}", "host": ["{{baseUrl}}"], "path": ["api", "tables", "{{tableId}}"] }
            }
        },
        {
            "name": "Update Table Status",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const json = pm.response.json();",
                            "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                            "pm.test('Status changed to OCCUPIED', () => pm.expect(json.status).to.eql('OCCUPIED'));"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "PATCH",
                "header": [
                    { "key": "Content-Type", "value": "application/json" },
                    { "key": "X-Branch-Id", "value": "{{branchId}}" }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"status\": \"OCCUPIED\"\n}"
                },
                "url": { "raw": "{{baseUrl}}/api/tables/{{tableId}}/status", "host": ["{{baseUrl}}"], "path": ["api", "tables", "{{tableId}}", "status"] }
            }
        },
        {
            "name": "Floor Availability",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const json = pm.response.json();",
                            "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                            "pm.test('Has summary', () => pm.expect(json.summary).to.be.an('object'));",
                            "pm.test('Has total', () => pm.expect(json.summary.total).to.be.a('number'));",
                            "pm.test('Has tables array', () => pm.expect(json.tables).to.be.an('array'));"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "GET",
                "header": [{ "key": "X-Branch-Id", "value": "{{branchId}}" }],
                "url": { "raw": "{{baseUrl}}/api/floor/availability", "host": ["{{baseUrl}}"], "path": ["api", "floor", "availability"] }
            }
        },
        {
            "name": "Permission Denial — Waiter Create Floor Plan → 403",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Status is 403', () => pm.response.to.have.status(403));"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "auth": {
                    "type": "bearer",
                    "bearer": [{ "key": "token", "value": "{{waiterAccessToken}}", "type": "string" }]
                },
                "method": "POST",
                "header": [
                    { "key": "Content-Type", "value": "application/json" },
                    { "key": "X-Branch-Id", "value": "{{branchId}}" }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"name\": \"Denied Floor\"\n}"
                },
                "url": { "raw": "{{baseUrl}}/api/floor-plans", "host": ["{{baseUrl}}"], "path": ["api", "floor-plans"] }
            }
        },
        {
            "name": "Missing Branch Header → 400",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Status is 400', () => pm.response.to.have.status(400));"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "GET",
                "header": [],
                "url": { "raw": "{{baseUrl}}/api/floor-plans", "host": ["{{baseUrl}}"], "path": ["api", "floor-plans"] }
            }
        },
        {
            "name": "Invalid Status Enum → 400",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Status is 400', () => pm.response.to.have.status(400));"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "PATCH",
                "header": [
                    { "key": "Content-Type", "value": "application/json" },
                    { "key": "X-Branch-Id", "value": "{{branchId}}" }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"status\": \"NOT_A_STATUS\"\n}"
                },
                "url": { "raw": "{{baseUrl}}/api/tables/{{tableId}}/status", "host": ["{{baseUrl}}"], "path": ["api", "tables", "{{tableId}}", "status"] }
            }
        }
    ]
}
