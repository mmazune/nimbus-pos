        {
            "name": "Auth — Login Owner",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test(\u0027status 201\u0027, () =\u003e pm.response.to.have.status(201));",
                            "const body = pm.response.json();",
                            "pm.test(\u0027has accessToken\u0027, () =\u003e pm.expect(body.accessToken).to.be.a(\u0027string\u0027));",
                            "pm.collectionVariables.set(\u0027accessToken\u0027, body.accessToken);",
                            "pm.collectionVariables.set(\u0027refreshToken\u0027, body.refreshToken);",
                            "if (typeof pm.environment !== \u0027undefined\u0027 \u0026\u0026 pm.environment.has(\u0027accessToken\u0027)) {",
                            "    pm.environment.set(\u0027accessToken\u0027, body.accessToken);",
                            "    pm.environment.set(\u0027refreshToken\u0027, body.refreshToken);",
                            "}"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"email\": \"owner@demo.local\",\n    \"password\": \"Owner#123\"\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/api/auth/login",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "auth",
                        "login"
                    ]
                }
            }
        },
        {
            "name": "Auth — Get Branch ID",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test(\u0027status 200\u0027, () =\u003e pm.response.to.have.status(200));",
                            "const body = pm.response.json();",
                            "const orgs = body.organizations || [];",
                            "pm.test(\u0027has organizations\u0027, () =\u003e pm.expect(orgs).to.be.an(\u0027array\u0027).with.length.greaterThan(0));",
                            "if (orgs.length \u003e 0) {",
                            "    const org = orgs[0];",
                            "    const setVar = (k, v) =\u003e {",
                            "        pm.collectionVariables.set(k, v);",
                            "        try { pm.environment.set(k, v); } catch(e) {}",
                            "    };",
                            "    setVar(\u0027orgId\u0027, org.id);",
                            "    const branches = org.branches || [];",
                            "    if (branches.length \u003e 0) {",
                            "        setVar(\u0027branchId\u0027, branches[0].id);",
                            "        setVar(\u0027mainBranchId\u0027, branches[0].id);",
                            "    }",
                            "    if (branches.length \u003e 1) {",
                            "        setVar(\u0027downtownBranchId\u0027, branches[1].id);",
                            "    }",
                            "    pm.test(\u0027found 2+ branches\u0027, () =\u003e pm.expect(branches.length).to.be.at.least(2));",
                            "}"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{accessToken}}"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/me",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "me"
                    ]
                }
            }
        },
