        {
            "name": "H. Reliability / Idempotency Checks",
            "item": [
                {
                    "name": "POST /api/exports (Idempotency-Key first CSV)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "// C-01: this pair used format PDF, which the reports service satisfied with a",
                                    "// plain-text file. The replay behaviour under test is format-agnostic, so it now",
                                    "// runs on CSV; the withdrawn PDF contract is asserted in the request below.",
                                    "pm.test('200 OK', () => pm.response.to.have.status(200));",
                                    "const body = pm.response.json();",
                                    "pm.test('Has exportId', () => pm.expect(body.export.exportId).to.match(/^reports:/));",
                                    "pm.collectionVariables.set('bg6ExportIdReplay', body.export.exportId);",
                                    "if (pm.environment && pm.environment.name) pm.environment.set('bg6ExportIdReplay', body.export.exportId);"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            { "key": "Content-Type", "value": "application/json" },
                            { "key": "Authorization", "value": "Bearer {{accessToken}}" },
                            { "key": "X-Branch-Id", "value": "{{branchId}}" },
                            { "key": "Idempotency-Key", "value": "{{bg6IdemKey}}" }
                        ],
                        "body": { "mode": "raw", "raw": "{\n  \"sourceDomain\": \"reports\",\n  \"reportRunId\": \"{{bg6ReportRunId}}\",\n  \"format\": \"CSV\"\n}" },
                        "url": { "raw": "{{baseUrl}}/api/exports", "host": ["{{baseUrl}}"], "path": ["api", "exports"] }
                    }
                },
                {
                    "name": "POST /api/exports ([501] PDF withdrawn - C-01)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "// C-01 (NG-01 / MP0-03): the export facade delegates to ReportsService.createExport,",
                                    "// so it must not be a back door to the withdrawn fake-PDF path.",
                                    "pm.test('501 Not Implemented', () => pm.response.to.have.status(501));",
                                    "const body = pm.response.json();",
                                    "pm.test('Message names the missing renderer', () => pm.expect(body.message).to.match(/PDF renderer/));"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
