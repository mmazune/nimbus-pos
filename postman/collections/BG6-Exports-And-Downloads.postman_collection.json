                                    "const body = pm.response.json();",
                                    "pm.test('Has accessToken', () => pm.expect(body.accessToken).to.be.a('string'));",
                                    "pm.collectionVariables.set('accessToken', body.accessToken);",
                                    "if (pm.environment && pm.environment.name) pm.environment.set('accessToken', body.accessToken);"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [{ "key": "Content-Type", "value": "application/json" }],
                        "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{ownerEmail}}\",\n  \"password\": \"{{ownerPassword}}\"\n}" },
                        "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
                    }
