    "event": [
        {
            "listen": "prerequest",
            "script": {
                "type": "text/javascript",
                "exec": [
                    "// BG4.A canonical pre-request (R3/R4/R5/R12/R14/R16). Mirrors BG3.",
                    "const baseUrl = pm.collectionVariables.get('baseUrl') || 'http://localhost:3001';",
                    "const ownerEmail = pm.collectionVariables.get('ownerEmail') || 'owner@demo.local';",
                    "const ownerPassword = pm.collectionVariables.get('ownerPassword') || 'Owner#123';",
                    "const url = pm.request && pm.request.url ? pm.request.url.toString() : '';",
                    "const isPublicAuth = /\\/api\\/auth\\/(login|forgot-password|reset-password|invitations\\/accept|quick-pin-login)/.test(url);",
                    "const isHealth = /\\/api\\/health(\\?|$)/.test(url);",
                    "const isPublic = isPublicAuth || isHealth;",
                    "function getVar(k) {",
                    "  if (pm.environment && pm.environment.name) {",
                    "    const ev = pm.environment.get(k);",
                    "    if (ev !== undefined && ev !== null && ev !== '') return ev;",
                    "  }",
                    "  return pm.collectionVariables.get(k);",
                    "}",
                    "function setVar(k, v) {",
                    "  if (v === undefined || v === null || v === '') return;",
                    "  pm.collectionVariables.set(k, v);",
                    "  if (pm.environment && pm.environment.name) pm.environment.set(k, v);",
                    "}",
                    "function ensureSuffix() {",
                    "  const reqName = (pm.info && pm.info.requestName) || '';",
                    "  const isFirstRequest = reqName === 'Login Owner';",
                    "  if (isFirstRequest || !getVar('bg4aSuffix')) {",
                    "    const s = String(Date.now()) + '-' + Math.floor(Math.random()*1e4);",
                    "    setVar('bg4aSuffix', s);",
                    "    setVar('idemKeyReprint', 'bg4a-rprint-' + s);",
                    "    setVar('idemKeySend', 'bg4a-send-' + s);",
                    "  }",
                    "}",
                    "function ensureToken() {",
                    "  return new Promise((resolve) => {",
                    "    const tok = getVar('accessToken');",
                    "    if (isPublic || (tok && tok.length >= 20)) return resolve();",
                    "    pm.sendRequest({",
                    "      url: baseUrl + '/api/auth/login',",
                    "      method: 'POST',",
                    "      header: { 'Content-Type': 'application/json' },",
                    "      body: { mode: 'raw', raw: JSON.stringify({ email: ownerEmail, password: ownerPassword }) }",
                    "    }, (err, res) => {",
                    "      if (!err && res) {",
                    "        try {",
                    "          const j = res.json();",
                    "          if (j.accessToken) setVar('accessToken', j.accessToken);",
                    "          if (j.refreshToken) setVar('refreshToken', j.refreshToken);",
                    "          if (j.user && j.user.organizationId) setVar('orgId', j.user.organizationId);",
                    "        } catch (e) { /* ignore */ }",
                    "      }",
                    "      resolve();",
                    "    });",
                    "  });",
                    "}",
                    "function ensureMeContext() {",
                    "  return new Promise((resolve) => {",
                    "    if (isPublic) return resolve();",
                    "    if (getVar('branchId') && getVar('orgId')) return resolve();",
                    "    const tok = getVar('accessToken');",
                    "    if (!tok) return resolve();",
                    "    pm.sendRequest({",
                    "      url: baseUrl + '/api/auth/me',",
                    "      method: 'GET',",
                    "      header: { 'Authorization': 'Bearer ' + tok }",
                    "    }, (err, res) => {",
                    "      if (!err && res) {",
                    "        try {",
                    "          const j = res.json();",
                    "          if (j.context) {",
                    "            if (j.context.defaultOrganizationId) setVar('orgId', j.context.defaultOrganizationId);",
                    "            if (j.context.defaultBranchId) setVar('branchId', j.context.defaultBranchId);",
                    "          }",
                    "          if (Array.isArray(j.memberships) && j.memberships.length) {",
                    "            if (!getVar('orgId')) setVar('orgId', j.memberships[0].organizationId);",
                    "            if (!getVar('branchId')) setVar('branchId', j.memberships[0].branchId);",
                    "          }",
                    "        } catch (e) { /* ignore */ }",
                    "      }",
                    "      resolve();",
                    "    });",
                    "  });",
                    "}",
                    "function ensureChefToken() {",
                    "  return new Promise((resolve) => {",
                    "    if (isPublic) return resolve();",
                    "    const tok = getVar('chefToken');",
                    "    if (tok && tok.length >= 20) return resolve();",
                    "    const chefEmail = getVar('chefEmail') || 'chef@demo.local';",
                    "    const chefPassword = getVar('chefPassword') || 'Chef#123';",
                    "    pm.sendRequest({",
                    "      url: baseUrl + '/api/auth/login',",
                    "      method: 'POST',",
                    "      header: { 'Content-Type': 'application/json' },",
                    "      body: { mode: 'raw', raw: JSON.stringify({ email: chefEmail, password: chefPassword }) }",
                    "    }, (err, res) => {",
                    "      if (!err && res) {",
                    "        try {",
                    "          const j = res.json();",
                    "          if (j.accessToken) setVar('chefToken', j.accessToken);",
                    "        } catch (e) { /* ignore */ }",
                    "      }",
                    "      resolve();",
                    "    });",
                    "  });",
                    "}",
                    "function ensureClosedOrder() {",
                    "  return new Promise((resolve) => {",
                    "    if (isPublic) return resolve();",
                    "    if (getVar('receiptOrderId')) return resolve();",
                    "    const tok = getVar('accessToken');",
                    "    const branch = getVar('branchId');",
                    "    if (!tok || !branch) return resolve();",
                    "    pm.sendRequest({",
                    "      url: baseUrl + '/api/pos/orders?status=CLOSED&pageSize=1',",
                    "      method: 'GET',",
                    "      header: { 'Authorization': 'Bearer ' + tok, 'X-Branch-Id': branch }",
                    "    }, (err, res) => {",
                    "      if (!err && res) {",
                    "        try {",
                    "          const j = res.json();",
                    "          const arr = Array.isArray(j) ? j : (j.data || j.items || []);",
                    "          if (arr.length && arr[0].id) setVar('receiptOrderId', arr[0].id);",
                    "        } catch (e) { /* ignore */ }",
                    "      }",
                    "      resolve();",
                    "    });",
                    "  });",
                    "}",
                    "ensureSuffix();",
                    "return ensureToken().then(ensureMeContext).then(ensureChefToken).then(ensureClosedOrder).catch((e) => console.log('[bg4a prereq] chain error', e && e.message));"
                ]
            }
        }
    ],
    "item": [
        {
            "name": "00 Read Me",
            "item": [
                {
                    "name": "README - variables, run order, locked rules",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/api/health",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "health"
                            ]
                        },
                        "description": "⚠️ **Re-import required after any script change.**\n\n## Run order\n1. **A. Auth & Context Baseline** — login owner + canonical /api/auth/me + login chef.\n2. **B. Receipt Read & History** — GET /api/receipts/:id and /:id/history (read + pagination).\n3. **C. Receipt Reprint** — POST /:id/reprint (200) + idempotency replay.\n4. **D. Receipt Send (PENDING — no live adapter)** — POST /:id/send (202, supported:false) + idempotency replay (same deliveryId).\n5. **E. Permission Denial — Chef** — chef → 403 on read/reprint/send.\n6. **F. Edge Cases** — unknown receipt id → 404, unknown channel → 400.\n\n## Auto-populated variables\n- `accessToken`, `chefToken`, `orgId`, `branchId` (from login + /api/auth/me).\n- `bg4aSuffix`, `idemKeyReprint`, `idemKeySend` (per-run).\n- `receiptOrderId` (auto-resolved via GET /api/pos/orders?status=CLOSED&pageSize=1). If your dev DB has no closed orders, run BG3 or the BG4.A e2e first to create one.\n\n## Locked rules verified\n- /api/auth/me canonical.\n- New `pos:receipt:*` perms on Owner/Manager/Cashier/Waiter; chef denied.\n- BG3 facade reused for reprint/send (idempotency optional, category=null).\n- Send returns 202 + `{ status:'PENDING', supported:false, reason:'NO_LIVE_DELIVERY_ADAPTER' }`. No real outbound delivery.\n- No schema change; receipt id == order id."
                    }
                }
            ]
        },
