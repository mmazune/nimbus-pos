                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/receipts/{{receiptOrderId}}/send",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "receipts",
                                "{{receiptOrderId}}",
                                "send"
                            ]
                        }
                    }
                },
                {
                    "name": "POST /api/receipts/:id/send (replay same Idempotency-Key) -> same deliveryId",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('202 Accepted (replay)', () => pm.response.to.have.status(202));",
                                    "const b = pm.response.json();",
                                    "const envActive = pm.environment && pm.environment.name;",
                                    "const expectedDelivery = pm.collectionVariables.get('lastDeliveryId') || (envActive ? pm.environment.get('lastDeliveryId') : '');",
                                    "pm.test('deliveryId matches first call', () => pm.expect(b.deliveryId).to.eql(expectedDelivery));",
                                    "pm.test('still PENDING', () => pm.expect(b.status).to.eql('PENDING'));"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
