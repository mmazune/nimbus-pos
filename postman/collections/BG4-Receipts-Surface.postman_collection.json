        {
            "name": "D. Receipt Send (PENDING - no live adapter)",
            "item": [
                {
                    "name": "POST /api/receipts/:id/send (email, with Idempotency-Key) -> 202",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('202 Accepted', () => pm.response.to.have.status(202));",
                                    "const b = pm.response.json();",
                                    "pm.test('action RECEIPT_SENT', () => pm.expect(b.action).to.eql('RECEIPT_SENT'));",
                                    "pm.test('status PENDING', () => pm.expect(b.status).to.eql('PENDING'));",
                                    "pm.test('supported is false', () => pm.expect(b.supported).to.eql(false));",
                                    "pm.test('reason NO_LIVE_DELIVERY_ADAPTER', () => pm.expect(b.reason).to.eql('NO_LIVE_DELIVERY_ADAPTER'));",
                                    "pm.test('deliveryId is a string', () => pm.expect(b.deliveryId).to.be.a('string'));",
                                    "const envActive = pm.environment && pm.environment.name;",
                                    "if (b.deliveryId) { pm.collectionVariables.set('lastDeliveryId', b.deliveryId); if (envActive) pm.environment.set('lastDeliveryId', b.deliveryId); }"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{accessToken}}"
                            },
                            {
                                "key": "X-Branch-Id",
                                "value": "{{branchId}}"
                            },
                            {
                                "key": "Idempotency-Key",
                                "value": "{{idemKeySend}}"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
