            "value": ""
        }
    ],
    "event": [
        {
            "listen": "prerequest",
            "script": {
                "type": "text/javascript",
                "exec": [
                    "// M41 canonical pre-request — mirrors M40 helper. R4/R5/R14/R16.",
                    "const baseUrl = pm.collectionVariables.get('baseUrl') || 'http://localhost:3001';",
                    "const ownerEmail = pm.collectionVariables.get('ownerEmail') || 'owner@demo.local';",
                    "const ownerPassword = pm.collectionVariables.get('ownerPassword') || 'Owner#123';",
                    "const url = pm.request && pm.request.url ? pm.request.url.toString() : '';",
                    "let reqStr = '';",
                    "try { reqStr = JSON.stringify(pm.request); } catch (e) { reqStr = url; }",
                    "const isPublicAuth = /\\/api\\/auth\\/login/.test(url);",
                    "const isHealth = /\\/api\\/health(\\?|$)/.test(url);",
                    "const isPublic = isPublicAuth || isHealth;",
                    "function refsVar(name) { return reqStr.indexOf('{{' + name + '}}') !== -1; }",
                    "function getVar(k) {",
                    "  if (pm.environment && pm.environment.name) {",
                    "    const ev = pm.environment.get(k);",
                    "    if (ev !== undefined && ev !== null && ev !== '') return ev;",
                    "  }",
                    "  return pm.collectionVariables.get(k);",
                    "}",
                    "function setVar(k, v) {",
                    "  if (v === undefined || v === null || v === '') return;",
                    "  pm.collectionVariables.set(k, v);",
                    "  if (pm.environment && pm.environment.name) pm.environment.set(k, v);",
                    "}",
                    "function ensureToken() {",
                    "  return new Promise((resolve) => {",
                    "    const tok = getVar('accessToken');",
                    "    if (isPublic || (tok && tok.length >= 20)) { return resolve(); }",
                    "    pm.sendRequest({",
                    "      url: baseUrl + '/api/auth/login',",
                    "      method: 'POST',",
                    "      header: { 'Content-Type': 'application/json' },",
                    "      body: { mode: 'raw', raw: JSON.stringify({ email: ownerEmail, password: ownerPassword }) }",
                    "    }, (err, res) => {",
                    "      if (!err && res) {",
                    "        try {",
                    "          const j = res.json();",
                    "          if (j.accessToken) setVar('accessToken', j.accessToken);",
                    "          if (j.refreshToken) setVar('refreshToken', j.refreshToken);",
                    "          if (j.user && j.user.organizationId) setVar('orgId', j.user.organizationId);",
                    "        } catch (e) { console.log('[m41 prereq] auto-login parse error', e && e.message); }",
                    "      } else if (err) { console.log('[m41 prereq] auto-login transport error', err && err.message); }",
                    "      resolve();",
                    "    });",
                    "  });",
                    "}",
                    "function ensureMeContext() {",
                    "  return new Promise((resolve) => {",
                    "    if (isPublic) return resolve();",
                    "    const needBranch = refsVar('branchId') && !getVar('branchId');",
                    "    const needOrg = refsVar('orgId') && !getVar('orgId');",
                    "    if (!needBranch && !needOrg) return resolve();",
                    "    const tok = getVar('accessToken');",
                    "    if (!tok) { return resolve(); }",
                    "    pm.sendRequest({",
                    "      url: baseUrl + '/api/auth/me',",
                    "      method: 'GET',",
                    "      header: { 'Authorization': 'Bearer ' + tok }",
                    "    }, (err, res) => {",
                    "      if (!err && res) {",
                    "        try {",
                    "          const j = res.json();",
                    "          if (j.context) {",
                    "            if (j.context.defaultOrganizationId) setVar('orgId', j.context.defaultOrganizationId);",
                    "            if (j.context.defaultBranchId) setVar('branchId', j.context.defaultBranchId);",
                    "          }",
                    "          if (Array.isArray(j.memberships) && j.memberships.length) {",
                    "            if (!getVar('orgId')) setVar('orgId', j.memberships[0].organizationId);",
                    "            if (!getVar('branchId')) setVar('branchId', j.memberships[0].branchId);",
                    "          }",
                    "        } catch (e) { /* ignore */ }",
                    "      }",
                    "      resolve();",
                    "    });",
                    "  });",
                    "}",
                    "function ensureClientMutationId() {",
                    "  return new Promise((resolve) => {",
                    "    if (!refsVar('clientMutationId')) return resolve();",
                    "    if (getVar('clientMutationId')) return resolve();",
                    "    setVar('clientMutationId', 'm41-pm-' + Date.now() + '-' + Math.floor(Math.random()*1e6));",
                    "    resolve();",
                    "  });",
                    "}",
                    "function ensureIdempotencyKey() {",
                    "  return new Promise((resolve) => {",
                    "    if (!refsVar('idempotencyKey')) return resolve();",
                    "    if (getVar('idempotencyKey')) return resolve();",
                    "    setVar('idempotencyKey', 'm41-pm-key-' + Date.now() + '-' + Math.floor(Math.random()*1e6));",
                    "    resolve();",
                    "  });",
                    "}",
                    "return ensureToken()",
                    "  .then(ensureMeContext)",
                    "  .then(ensureClientMutationId)",
                    "  .then(ensureIdempotencyKey)",
                    "  .catch((e) => console.log('[m41 prereq] chain error', e && e.message));"
                ]
            }
        }
    ],
    "item": [
        {
            "name": "00 Read Me",
            "item": [
                {
                    "name": "README - variables, run order, re-import warning",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/api/health",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "health"
                            ]
                        },
                        "description": "RE-IMPORT REQUIRED after any script change (R8). Postman caches scripts at import time.\n\nThis collection is STANDALONE-resilient (R3, R4, R5, R14, R16). Collection-level pre-request:\n1. Auto-logs in owner@demo.local when accessToken is missing (skipped on /api/auth/login and /api/health).\n2. Calls /api/auth/me when {{orgId}} or {{branchId}} is referenced and empty.\n3. Generates a fresh {{clientMutationId}} and {{idempotencyKey}} when they are referenced and empty (so each run produces a brand new SyncJob).\n\nFolder run order:\n- A. Auth & Context [STANDALONE]\n- B. Idempotent Write Contract Demo [STANDALONE] - illustrative; the actual generic IdempotencyService is a backend primitive used inside services. Folder B exercises POST /idempotency/inspect for an existing key (seeded).\n- C. Sync Replay [STANDALONE] - submits a GENERIC_REPLAY job and demonstrates same-key idempotency (resubmit returns the same jobId).\n- D. Sync Jobs [STANDALONE] - lists jobs, fetches one by id.\n- E. Retry [STANDALONE] - retry on SUCCEEDED returns 409 (locked rule).\n- F. Conflicts [STANDALONE] - lists OPEN conflicts (seeded RESERVATION_CONFIRM) and resolves with SERVER_TRUTH_KEPT.\n\nLocked decisions verified:\n- Same clientMutationId returns the same job.\n- Retry on SUCCEEDED is a 409.\n- Conflict resolution writes audit and transitions to RESOLVED/DISMISSED.\n- chef@demo.local cannot POST /sync/replay (folder C includes a 403 case)."
                    }
                }
            ]
        },
