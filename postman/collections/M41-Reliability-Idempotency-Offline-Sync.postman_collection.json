        {
            "name": "D. Sync Jobs",
            "description": "[STANDALONE] Folder pre-request auto-resolves syncJobId via list-first if missing (R17).",
            "event": [
                {
                    "listen": "prerequest",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "const baseUrl = pm.collectionVariables.get('baseUrl') || 'http://localhost:3001';",
                            "function getVar(k){ if(pm.environment&&pm.environment.name){const v=pm.environment.get(k); if(v)return v;} return pm.collectionVariables.get(k); }",
                            "function setVar(k,v){ pm.collectionVariables.set(k,v); if(pm.environment&&pm.environment.name) pm.environment.set(k,v); }",
                            "if (getVar('syncJobId')) return;",
                            "const tok = getVar('accessToken');",
                            "if (!tok) return;",
                            "return new Promise((resolve)=>{",
                            "  pm.sendRequest({ url: baseUrl + '/api/sync/jobs?limit=1', method:'GET', header: { 'Authorization':'Bearer '+tok } }, (err,res)=>{",
                            "    if(!err && res){ try { const arr = res.json(); if(Array.isArray(arr)&&arr.length){ setVar('syncJobId', arr[0].id); } } catch(e){} }",
                            "    resolve();",
                            "  });",
                            "});"
                        ]
                    }
                }
            ],
            "item": [
