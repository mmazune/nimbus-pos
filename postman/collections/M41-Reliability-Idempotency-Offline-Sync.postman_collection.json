                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('200 OK', () => pm.response.to.have.status(200));",
                                    "const j = pm.response.json();",
                                    "pm.test('attempts present', () => pm.expect(j).to.have.property('attempts'));",
                                    "pm.test('conflicts present', () => pm.expect(j).to.have.property('conflicts'));"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{accessToken}}"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/sync/jobs/{{syncJobId}}",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "sync",
                                "jobs",
                                "{{syncJobId}}"
                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "E. Retry",
            "description": "[STANDALONE] Retry on a SUCCEEDED job is 409 (locked rule).",
            "event": [
                {
                    "listen": "prerequest",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "const baseUrl = pm.collectionVariables.get('baseUrl') || 'http://localhost:3001';",
                            "function getVar(k){ if(pm.environment&&pm.environment.name){const v=pm.environment.get(k); if(v)return v;} return pm.collectionVariables.get(k); }",
                            "function setVar(k,v){ pm.collectionVariables.set(k,v); if(pm.environment&&pm.environment.name) pm.environment.set(k,v); }",
                            "if (getVar('succeededJobId')) return;",
                            "const tok = getVar('accessToken');",
                            "if (!tok) return;",
                            "return new Promise((resolve)=>{",
                            "  pm.sendRequest({ url: baseUrl + '/api/sync/jobs?status=SUCCEEDED&limit=1', method:'GET', header: { 'Authorization':'Bearer '+tok } }, (err,res)=>{",
                            "    if(!err && res){ try { const arr = res.json(); if(Array.isArray(arr)&&arr.length){ setVar('succeededJobId', arr[0].id); } } catch(e){} }",
                            "    resolve();",
                            "  });",
                            "});"
                        ]
                    }
                }
            ],
            "item": [
                {
                    "name": "POST /sync/jobs/:id/retry (SUCCEEDED -> 409)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('409 Conflict', () => pm.response.to.have.status(409));"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{accessToken}}"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/sync/jobs/{{succeededJobId}}/retry",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "sync",
                                "jobs",
                                "{{succeededJobId}}",
                                "retry"
                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "F. Conflicts",
            "description": "[STANDALONE] Folder prereq auto-resolves conflictId via list OPEN (R17). Resolves with SERVER_TRUTH_KEPT.",
            "event": [
                {
                    "listen": "prerequest",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "const baseUrl = pm.collectionVariables.get('baseUrl') || 'http://localhost:3001';",
                            "function getVar(k){ if(pm.environment&&pm.environment.name){const v=pm.environment.get(k); if(v)return v;} return pm.collectionVariables.get(k); }",
                            "function setVar(k,v){ pm.collectionVariables.set(k,v); if(pm.environment&&pm.environment.name) pm.environment.set(k,v); }",
                            "if (getVar('conflictId')) return;",
                            "const tok = getVar('accessToken');",
                            "if (!tok) return;",
                            "return new Promise((resolve)=>{",
                            "  pm.sendRequest({ url: baseUrl + '/api/sync/conflicts?status=OPEN&limit=1', method:'GET', header: { 'Authorization':'Bearer '+tok } }, (err,res)=>{",
                            "    if(!err && res){ try { const arr = res.json(); if(Array.isArray(arr)&&arr.length){ setVar('conflictId', arr[0].id); } } catch(e){} }",
                            "    resolve();",
                            "  });",
                            "});"
                        ]
                    }
                }
            ],
            "item": [
                {
                    "name": "GET /sync/conflicts?status=OPEN",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('200 OK', () => pm.response.to.have.status(200));",
                                    "pm.test('array', () => pm.expect(pm.response.json()).to.be.an('array'));"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{accessToken}}"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/sync/conflicts?status=OPEN",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "sync",
                                "conflicts"
                            ],
                            "query": [
                                {
                                    "key": "status",
                                    "value": "OPEN"
                                }
                            ]
                        }
                    }
                },
                {
                    "name": "PATCH /sync/conflicts/:id/resolve (SERVER_TRUTH_KEPT)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "if (pm.response.code === 404 || pm.response.code === 409) { pm.test('skipped (no open conflict)', () => true); return; }",
                                    "pm.test('200 OK', () => pm.response.to.have.status(200));",
                                    "const j = pm.response.json();",
                                    "pm.test('status RESOLVED or DISMISSED', () => pm.expect(['RESOLVED','DISMISSED']).to.include(j.status));"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "PATCH",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{accessToken}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"resolution\": \"SERVER_TRUTH_KEPT\",\n  \"note\": \"Postman M41 auto-resolve\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/sync/conflicts/{{conflictId}}/resolve",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "sync",
                                "conflicts",
                                "{{conflictId}}",
                                "resolve"
                            ]
                        }
                    }
                }
            ]
        }
    ]
