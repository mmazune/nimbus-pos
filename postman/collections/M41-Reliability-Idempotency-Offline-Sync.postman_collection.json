            "name": "C. Sync Replay",
            "description": "[STANDALONE] Submits a GENERIC_REPLAY batch. The collection-level prereq generates `clientMutationId` and `idempotencyKey` when empty. Run twice to see same-key idempotency: the second run returns the same `jobId`.",
            "item": [
                {
                    "name": "POST /sync/replay (GENERIC_REPLAY -> SUCCEEDED)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('200 OK', () => pm.response.to.have.status(200));",
                                    "const j = pm.response.json();",
                                    "pm.test('accepted = 1', () => pm.expect(j.accepted).to.eql(1));",
                                    "pm.test('status = SUCCEEDED', () => pm.expect(j.results[0].status).to.eql('SUCCEEDED'));",
                                    "pm.collectionVariables.set('syncJobId', j.results[0].jobId);",
                                    "pm.collectionVariables.set('succeededJobId', j.results[0].jobId);",
                                    "if (pm.environment && pm.environment.name) {",
                                    "  pm.environment.set('syncJobId', j.results[0].jobId);",
                                    "  pm.environment.set('succeededJobId', j.results[0].jobId);",
                                    "}"
                                ]
                            }
                        }
                    ],
