{
    "info": {
        "name": "M17 — Events + Booking Portal + Ticketing",
        "description": "Nimbus POS M17: Events lifecycle, booking portal, ticket classes, bookings, ticket issuance, and check-in.\n\n## Endpoints\n- POST /events — Create event (DRAFT)\n- GET /events — List events (paginated, filterable)\n- GET /events/upcoming — List upcoming events\n- GET /events/portal/:portalKey — Public portal view\n- GET /events/:id — Get event by ID\n- PATCH /events/:id — Update DRAFT event\n- PATCH /events/:id/publish — Publish event\n- PATCH /events/:id/close — Close event\n- POST /events/:id/ticket-classes — Create ticket class\n- GET /events/:id/ticket-classes — List ticket classes\n- POST /events/:id/bookings — Create booking\n- GET /events/:id/bookings — List bookings\n- GET /events/bookings/:bookingId — Get booking\n- PATCH /events/bookings/:bookingId/cancel — Cancel booking\n- POST /events/bookings/:bookingId/tickets/issue — Issue tickets\n- POST /events/tickets/:ticketId/check-in — Check in ticket",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "auth": {
        "type": "bearer",
        "bearer": [
            {
                "key": "token",
                "value": "{{accessToken}}",
                "type": "string"
            }
        ]
    },
    "variable": [
        { "key": "baseUrl", "value": "http://localhost:3000/api" },
        { "key": "accessToken", "value": "" },
        { "key": "branchId", "value": "" },
        { "key": "eventId", "value": "" },
        { "key": "ticketClassId", "value": "" },
        { "key": "bookingId", "value": "" },
        { "key": "ticketId", "value": "" },
        { "key": "portalKey", "value": "" }
    ],
    "item": [
        {
            "name": "Auth — Login (Owner)",
            "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"email\": \"owner@demo.local\",\n  \"password\": \"Owner#123\"\n}"
                },
                "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const body = pm.response.json();",
                            "pm.collectionVariables.set('accessToken', body.accessToken);",
                            "pm.test('Login OK', () => pm.response.to.have.status(200));"
                        ]
                    }
                }
            ]
        },
        {
            "name": "Auth — Get /me (capture branchId)",
            "request": {
                "method": "GET",
                "header": [],
                "url": { "raw": "{{baseUrl}}/me", "host": ["{{baseUrl}}"], "path": ["me"] }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const body = pm.response.json();",
                            "const bid = body.defaultBranch?.id || body.organizations?.[0]?.branches?.[0]?.id || body.memberships?.[0]?.branchId;",
                            "pm.collectionVariables.set('branchId', bid);",
                            "pm.test('Got branchId', () => pm.expect(bid).to.be.a('string'));"
                        ]
                    }
                }
            ]
        },
        {
            "name": "Create Event (DRAFT)",
            "request": {
                "method": "POST",
                "header": [
                    { "key": "Content-Type", "value": "application/json" },
                    { "key": "X-Branch-Id", "value": "{{branchId}}" }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"title\": \"Postman Jazz Night\",\n  \"description\": \"Live jazz with cocktails\",\n  \"startsAt\": \"2026-04-15T19:00:00.000Z\",\n  \"endsAt\": \"2026-04-15T23:00:00.000Z\",\n  \"capacity\": 150,\n  \"venueNotes\": \"Main dining room\"\n}"
                },
                "url": { "raw": "{{baseUrl}}/events", "host": ["{{baseUrl}}"], "path": ["events"] }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const body = pm.response.json();",
                            "pm.collectionVariables.set('eventId', body.id);",
                            "pm.test('Created DRAFT event', () => {",
                            "  pm.response.to.have.status(201);",
                            "  pm.expect(body.status).to.eql('DRAFT');",
                            "  pm.expect(body.eventNumber).to.match(/^EVT-/);",
                            "});"
                        ]
                    }
                }
            ]
        },
        {
            "name": "Get Event by ID",
            "request": {
                "method": "GET",
                "header": [
                    { "key": "X-Branch-Id", "value": "{{branchId}}" }
                ],
                "url": { "raw": "{{baseUrl}}/events/{{eventId}}", "host": ["{{baseUrl}}"], "path": ["events", "{{eventId}}"] }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Got event', () => {",
                            "  pm.response.to.have.status(200);",
                            "  pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('eventId'));",
                            "});"
                        ]
                    }
                }
            ]
        },
        {
            "name": "Update DRAFT Event",
            "request": {
                "method": "PATCH",
                "header": [
                    { "key": "Content-Type", "value": "application/json" },
                    { "key": "X-Branch-Id", "value": "{{branchId}}" }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"title\": \"Postman Jazz Night — Updated\",\n  \"venueNotes\": \"Main hall, VIP section reserved\"\n}"
                },
                "url": { "raw": "{{baseUrl}}/events/{{eventId}}", "host": ["{{baseUrl}}"], "path": ["events", "{{eventId}}"] }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Updated event', () => {",
                            "  pm.response.to.have.status(200);",
                            "  pm.expect(pm.response.json().title).to.include('Updated');",
                            "});"
                        ]
                    }
                }
            ]
        },
        {
            "name": "Create Ticket Class",
            "request": {
                "method": "POST",
                "header": [
                    { "key": "Content-Type", "value": "application/json" },
                    { "key": "X-Branch-Id", "value": "{{branchId}}" }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"name\": \"General Admission\",\n  \"type\": \"GENERAL\",\n  \"price\": 25000,\n  \"capacity\": 120\n}"
                },
                "url": { "raw": "{{baseUrl}}/events/{{eventId}}/ticket-classes", "host": ["{{baseUrl}}"], "path": ["events", "{{eventId}}", "ticket-classes"] }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const body = pm.response.json();",
                            "pm.collectionVariables.set('ticketClassId', body.id);",
                            "pm.test('Created ticket class', () => {",
                            "  pm.response.to.have.status(201);",
                            "  pm.expect(body.name).to.eql('General Admission');",
                            "});"
                        ]
                    }
                }
            ]
        },
        {
            "name": "List Ticket Classes",
            "request": {
                "method": "GET",
                "header": [
                    { "key": "X-Branch-Id", "value": "{{branchId}}" }
                ],
                "url": { "raw": "{{baseUrl}}/events/{{eventId}}/ticket-classes", "host": ["{{baseUrl}}"], "path": ["events", "{{eventId}}", "ticket-classes"] }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Listed ticket classes', () => {",
                            "  pm.response.to.have.status(200);",
                            "  pm.expect(pm.response.json()).to.be.an('array');",
                            "});"
                        ]
                    }
                }
            ]
        },
        {
            "name": "Publish Event",
            "request": {
                "method": "PATCH",
                "header": [
                    { "key": "Content-Type", "value": "application/json" },
                    { "key": "X-Branch-Id", "value": "{{branchId}}" }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"slug\": \"postman-jazz-night\"\n}"
                },
                "url": { "raw": "{{baseUrl}}/events/{{eventId}}/publish", "host": ["{{baseUrl}}"], "path": ["events", "{{eventId}}", "publish"] }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const body = pm.response.json();",
                            "pm.collectionVariables.set('portalKey', body.portalKey);",
                            "pm.test('Published event', () => {",
                            "  pm.response.to.have.status(200);",
                            "  pm.expect(body.status).to.eql('PUBLISHED');",
                            "  pm.expect(body.portalKey).to.be.a('string');",
                            "});"
                        ]
                    }
                }
            ]
        },
        {
            "name": "Portal — Get Event by Portal Key",
            "request": {
                "method": "GET",
                "header": [
                    { "key": "X-Branch-Id", "value": "{{branchId}}" }
                ],
                "url": { "raw": "{{baseUrl}}/events/portal/{{portalKey}}", "host": ["{{baseUrl}}"], "path": ["events", "portal", "{{portalKey}}"] }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Portal view OK', () => {",
                            "  pm.response.to.have.status(200);",
                            "  const body = pm.response.json();",
                            "  pm.expect(body.title).to.be.a('string');",
                            "  pm.expect(body.ticketClasses).to.be.an('array');",
                            "});"
                        ]
                    }
                }
            ]
        },
        {
            "name": "Create Booking",
            "request": {
                "method": "POST",
                "header": [
                    { "key": "Content-Type", "value": "application/json" },
                    { "key": "X-Branch-Id", "value": "{{branchId}}" }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"ticketClassId\": \"{{ticketClassId}}\",\n  \"customerName\": \"Postman Booking Guest\",\n  \"customerPhone\": \"+256700123456\",\n  \"customerEmail\": \"guest@postman.test\",\n  \"quantity\": 2\n}"
                },
                "url": { "raw": "{{baseUrl}}/events/{{eventId}}/bookings", "host": ["{{baseUrl}}"], "path": ["events", "{{eventId}}", "bookings"] }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const body = pm.response.json();",
                            "pm.collectionVariables.set('bookingId', body.id);",
                            "pm.test('Created booking', () => {",
                            "  pm.response.to.have.status(201);",
                            "  pm.expect(body.bookingNumber).to.match(/^BKG-/);",
                            "  pm.expect(body.status).to.eql('CONFIRMED');",
                            "});"
                        ]
                    }
                }
            ]
        },
        {
            "name": "Get Booking by ID",
            "request": {
                "method": "GET",
                "header": [
                    { "key": "X-Branch-Id", "value": "{{branchId}}" }
                ],
                "url": { "raw": "{{baseUrl}}/events/bookings/{{bookingId}}", "host": ["{{baseUrl}}"], "path": ["events", "bookings", "{{bookingId}}"] }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Got booking', () => {",
                            "  pm.response.to.have.status(200);",
                            "  pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('bookingId'));",
                            "});"
                        ]
                    }
                }
            ]
        },
        {
            "name": "List Bookings for Event",
            "request": {
                "method": "GET",
                "header": [
                    { "key": "X-Branch-Id", "value": "{{branchId}}" }
                ],
                "url": { "raw": "{{baseUrl}}/events/{{eventId}}/bookings", "host": ["{{baseUrl}}"], "path": ["events", "{{eventId}}", "bookings"] }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Listed bookings', () => {",
                            "  pm.response.to.have.status(200);",
                            "  pm.expect(pm.response.json()).to.be.an('array');",
                            "});"
                        ]
                    }
                }
            ]
        },
        {
            "name": "Issue Tickets for Booking",
            "request": {
                "method": "POST",
                "header": [
                    { "key": "Content-Type", "value": "application/json" },
                    { "key": "X-Branch-Id", "value": "{{branchId}}" }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"holderName\": \"Postman Ticket Holder\"\n}"
                },
                "url": { "raw": "{{baseUrl}}/events/bookings/{{bookingId}}/tickets/issue", "host": ["{{baseUrl}}"], "path": ["events", "bookings", "{{bookingId}}", "tickets", "issue"] }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const body = pm.response.json();",
                            "if (Array.isArray(body) && body.length > 0) {",
                            "  pm.collectionVariables.set('ticketId', body[0].id);",
                            "}",
                            "pm.test('Issued tickets', () => {",
                            "  pm.response.to.have.status(201);",
                            "  pm.expect(body).to.be.an('array');",
                            "  pm.expect(body[0].ticketNumber).to.match(/^TKT-/);",
                            "});"
                        ]
                    }
                }
            ]
        },
        {
            "name": "Check In Ticket",
            "request": {
                "method": "POST",
                "header": [
                    { "key": "Content-Type", "value": "application/json" },
                    { "key": "X-Branch-Id", "value": "{{branchId}}" }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"message\": \"Welcome to Jazz Night!\"\n}"
                },
                "url": { "raw": "{{baseUrl}}/events/tickets/{{ticketId}}/check-in", "host": ["{{baseUrl}}"], "path": ["events", "tickets", "{{ticketId}}", "check-in"] }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Checked in ticket', () => {",
                            "  pm.response.to.have.status(201);",
                            "  const body = pm.response.json();",
                            "  pm.expect(body.status).to.eql('CHECKED_IN');",
                            "});"
                        ]
                    }
                }
            ]
        },
        {
            "name": "Cancel Booking",
            "request": {
                "method": "PATCH",
                "header": [
                    { "key": "Content-Type", "value": "application/json" },
                    { "key": "X-Branch-Id", "value": "{{branchId}}" }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"reason\": \"Change of plans\"\n}"
                },
                "url": { "raw": "{{baseUrl}}/events/bookings/{{bookingId}}/cancel", "host": ["{{baseUrl}}"], "path": ["events", "bookings", "{{bookingId}}", "cancel"] }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Cancelled booking', () => {",
                            "  pm.response.to.have.status(200);",
                            "  pm.expect(pm.response.json().status).to.eql('CANCELLED');",
                            "});"
                        ]
                    }
                }
            ]
        },
        {
            "name": "List Events (Paginated)",
            "request": {
                "method": "GET",
                "header": [
                    { "key": "X-Branch-Id", "value": "{{branchId}}" }
                ],
                "url": { "raw": "{{baseUrl}}/events?page=1&pageSize=10", "host": ["{{baseUrl}}"], "path": ["events"], "query": [{ "key": "page", "value": "1" }, { "key": "pageSize", "value": "10" }] }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Listed events', () => {",
                            "  pm.response.to.have.status(200);",
                            "  const body = pm.response.json();",
                            "  pm.expect(body.data).to.be.an('array');",
                            "  pm.expect(body.total).to.be.a('number');",
                            "});"
                        ]
                    }
                }
            ]
        },
        {
            "name": "List Upcoming Events",
            "request": {
                "method": "GET",
                "header": [
                    { "key": "X-Branch-Id", "value": "{{branchId}}" }
                ],
                "url": { "raw": "{{baseUrl}}/events/upcoming", "host": ["{{baseUrl}}"], "path": ["events", "upcoming"] }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Got upcoming events', () => {",
                            "  pm.response.to.have.status(200);",
                            "  pm.expect(pm.response.json()).to.be.an('array');",
                            "});"
                        ]
                    }
                }
            ]
        },
        {
            "name": "Close Event",
            "request": {
                "method": "PATCH",
                "header": [
                    { "key": "Content-Type", "value": "application/json" },
                    { "key": "X-Branch-Id", "value": "{{branchId}}" }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"reason\": \"Event concluded successfully\"\n}"
                },
                "url": { "raw": "{{baseUrl}}/events/{{eventId}}/close", "host": ["{{baseUrl}}"], "path": ["events", "{{eventId}}", "close"] }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Closed event', () => {",
                            "  pm.response.to.have.status(200);",
                            "  pm.expect(pm.response.json().status).to.eql('CLOSED');",
                            "});"
                        ]
                    }
                }
            ]
        }
    ]
}