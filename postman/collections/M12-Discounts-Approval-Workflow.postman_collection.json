{
    "info": {
        "_postman_id": "m12-discounts-approval-workflow",
        "name": "M12 — Discounts + Approval Workflow",
        "description": "Nimbus POS — M12 Discounts + Approval Workflow: Request discount, auto-approve vs pending, manager approve/reject, PIN verification, list discounts.\n\nWorkflow: Login (waiter) → Create order → Add items → Request small discount (auto-approve) → Login (owner/manager) → Request large discount (pending) → Approve → Reject → List order discounts → Get pending → Get detail.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "auth": {
        "type": "bearer",
        "bearer": [
            {
                "key": "token",
                "value": "{{accessToken}}",
                "type": "string"
            }
        ]
    },
    "item": [
        {
            "name": "Login (Waiter)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const json = pm.response.json();",
                            "pm.environment.set('waiterToken', json.accessToken);",
                            "pm.environment.set('accessToken', json.accessToken);",
                            "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                            "pm.test('Has accessToken', () => pm.expect(json.accessToken).to.be.a('string'));"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "auth": {
                    "type": "noauth"
                },
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"email\": \"waiter@demo.local\",\n  \"password\": \"Waiter#123\"\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/api/auth/login",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "auth",
                        "login"
                    ]
                }
            }
        },
        {
            "name": "Get Branch ID",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const json = pm.response.json();",
                            "var allBranches = []; var orgs = json.organizations || []; for (var i = 0; i < orgs.length; i++) { var bs = orgs[i].branches || []; for (var j = 0; j < bs.length; j++) allBranches.push(bs[j]); }",
                            "var mainBranch = null; for (var k = 0; k < allBranches.length; k++) { if (allBranches[k].code === 'MAIN') { mainBranch = allBranches[k]; break; } }",
                            "var branchId = mainBranch ? mainBranch.id : (json.defaultBranch ? json.defaultBranch.id : (allBranches.length > 0 ? allBranches[0].id : null));",
                            "console.log('[Get Branch ID] branches:', allBranches.length, '| picked:', branchId, '| code:', mainBranch ? mainBranch.code : 'fallback');",
                            "pm.environment.set('branchId', branchId);",
                            "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                            "pm.test('Has branchId', () => pm.expect(branchId).to.be.a('string'));"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{waiterToken}}"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/me",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "me"
                    ]
                }
            }
        },
