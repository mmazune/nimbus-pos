{
    "info": {
        "name": "M26 - Payroll Engine + Pay Runs + Payslips",
        "description": "API collection for M26 — Pay Components, Payroll Adjustments, Pay Runs (DRAFT→APPROVED→PAID), Pay Slips",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:3001"
        }
    ],
    "item": [
        {
            "name": "Pay Components",
            "item": [
                {
                    "name": "Create Pay Component (Earning)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "if (pm.response.code === 201) {",
                                    "    const body = pm.response.json();",
                                    "    pm.environment.set('payComponentId', body.id);",
                                    "    pm.test('status 201', () => pm.response.to.have.status(201));",
                                    "    pm.test('has id', () => pm.expect(body.id).to.be.a('string'));",
                                    "    pm.test('componentType is EARNING', () => pm.expect(body.componentType).to.eql('EARNING'));",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            { "key": "Content-Type", "value": "application/json" },
                            { "key": "Authorization", "value": "Bearer {{accessToken}}" },
                            { "key": "X-Branch-Id", "value": "{{branchId}}" }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"code\": \"PM-BASIC\",\n    \"name\": \"Postman Basic Salary\",\n    \"componentType\": \"EARNING\",\n    \"taxable\": true,\n    \"defaultAmount\": 500000\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/payroll/components",
                            "host": ["{{baseUrl}}"],
                            "path": ["api", "payroll", "components"]
                        }
                    }
                },
                {
                    "name": "Create Pay Component (Deduction)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "if (pm.response.code === 201) {",
                                    "    const body = pm.response.json();",
                                    "    pm.environment.set('deductionComponentId', body.id);",
                                    "    pm.test('status 201', () => pm.response.to.have.status(201));",
                                    "    pm.test('type DEDUCTION', () => pm.expect(body.componentType).to.eql('DEDUCTION'));",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            { "key": "Content-Type", "value": "application/json" },
                            { "key": "Authorization", "value": "Bearer {{accessToken}}" },
                            { "key": "X-Branch-Id", "value": "{{branchId}}" }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"code\": \"PM-NSSF\",\n    \"name\": \"Postman NSSF Deduction\",\n    \"componentType\": \"DEDUCTION\",\n    \"taxable\": false,\n    \"defaultAmount\": 25000\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/payroll/components",
                            "host": ["{{baseUrl}}"],
                            "path": ["api", "payroll", "components"]
                        }
                    }
                },
                {
                    "name": "List Pay Components",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('status 200', () => pm.response.to.have.status(200));",
                                    "pm.test('is array', () => pm.expect(pm.response.json()).to.be.an('array'));"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "header": [
                            { "key": "Authorization", "value": "Bearer {{accessToken}}" },
                            { "key": "X-Branch-Id", "value": "{{branchId}}" }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/payroll/components",
                            "host": ["{{baseUrl}}"],
                            "path": ["api", "payroll", "components"]
                        }
                    }
                }
            ]
        },
        {
            "name": "Payroll Adjustments",
            "item": [
                {
                    "name": "Create Payroll Adjustment (Bonus)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "if (pm.response.code === 201) {",
                                    "    const body = pm.response.json();",
                                    "    pm.environment.set('adjustmentId', body.id);",
                                    "    pm.test('status 201', () => pm.response.to.have.status(201));",
                                    "    pm.test('has id', () => pm.expect(body.id).to.be.a('string'));",
                                    "    pm.test('type BONUS', () => pm.expect(body.adjustmentType).to.eql('BONUS'));",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            { "key": "Content-Type", "value": "application/json" },
                            { "key": "Authorization", "value": "Bearer {{accessToken}}" },
                            { "key": "X-Branch-Id", "value": "{{branchId}}" }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"employeeId\": \"{{employeeId}}\",\n    \"adjustmentType\": \"BONUS\",\n    \"amount\": 100000,\n    \"effectiveDate\": \"2025-04-15\",\n    \"notes\": \"Performance bonus\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/payroll/adjustments",
                            "host": ["{{baseUrl}}"],
                            "path": ["api", "payroll", "adjustments"]
                        }
                    }
                },
                {
                    "name": "List Payroll Adjustments",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('status 200', () => pm.response.to.have.status(200));",
                                    "const body = pm.response.json();",
                                    "pm.test('has data', () => pm.expect(body.data).to.be.an('array'));",
                                    "pm.test('has total', () => pm.expect(body.total).to.be.a('number'));"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "header": [
                            { "key": "Authorization", "value": "Bearer {{accessToken}}" },
                            { "key": "X-Branch-Id", "value": "{{branchId}}" }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/payroll/adjustments",
                            "host": ["{{baseUrl}}"],
                            "path": ["api", "payroll", "adjustments"]
                        }
                    }
                }
            ]
        },
        {
            "name": "Pay Runs",
            "item": [
                {
                    "name": "Build Pay Run",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "if (pm.response.code === 201) {",
                                    "    const body = pm.response.json();",
                                    "    pm.environment.set('payRunId', body.id);",
                                    "    pm.test('status 201', () => pm.response.to.have.status(201));",
                                    "    pm.test('status DRAFT', () => pm.expect(body.status).to.eql('DRAFT'));",
                                    "    pm.test('has paySlips', () => pm.expect(body.paySlips).to.be.an('array'));",
                                    "    if (body.paySlips && body.paySlips.length > 0) {",
                                    "        pm.environment.set('paySlipId', body.paySlips[0].id);",
                                    "    }",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            { "key": "Content-Type", "value": "application/json" },
                            { "key": "Authorization", "value": "Bearer {{accessToken}}" },
                            { "key": "X-Branch-Id", "value": "{{branchId}}" }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"name\": \"Postman April 2025\",\n    \"periodStart\": \"2098-04-01\",\n    \"periodEnd\": \"2098-04-30\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/payroll/runs/build",
                            "host": ["{{baseUrl}}"],
                            "path": ["api", "payroll", "runs", "build"]
                        }
                    }
                },
                {
                    "name": "Approve Pay Run",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('status 200', () => pm.response.to.have.status(200));",
                                    "pm.test('status APPROVED', () => pm.expect(pm.response.json().status).to.eql('APPROVED'));"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "PATCH",
                        "header": [
                            { "key": "Content-Type", "value": "application/json" },
                            { "key": "Authorization", "value": "Bearer {{accessToken}}" },
                            { "key": "X-Branch-Id", "value": "{{branchId}}" }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"notes\": \"Approved via Postman\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/payroll/runs/{{payRunId}}/approve",
                            "host": ["{{baseUrl}}"],
                            "path": ["api", "payroll", "runs", "{{payRunId}}", "approve"]
                        }
                    }
                },
                {
                    "name": "Pay Pay Run",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('status 200', () => pm.response.to.have.status(200));",
                                    "pm.test('status PAID', () => pm.expect(pm.response.json().status).to.eql('PAID'));"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "PATCH",
                        "header": [
                            { "key": "Content-Type", "value": "application/json" },
                            { "key": "Authorization", "value": "Bearer {{accessToken}}" },
                            { "key": "X-Branch-Id", "value": "{{branchId}}" }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"notes\": \"Paid via Postman\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/payroll/runs/{{payRunId}}/pay",
                            "host": ["{{baseUrl}}"],
                            "path": ["api", "payroll", "runs", "{{payRunId}}", "pay"]
                        }
                    }
                },
                {
                    "name": "List Pay Runs",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('status 200', () => pm.response.to.have.status(200));",
                                    "const body = pm.response.json();",
                                    "pm.test('has data', () => pm.expect(body.data).to.be.an('array'));",
                                    "pm.test('has total', () => pm.expect(body.total).to.be.a('number'));"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "header": [
                            { "key": "Authorization", "value": "Bearer {{accessToken}}" },
                            { "key": "X-Branch-Id", "value": "{{branchId}}" }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/payroll/runs",
                            "host": ["{{baseUrl}}"],
                            "path": ["api", "payroll", "runs"]
                        }
                    }
                },
                {
                    "name": "Get Pay Run by ID",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('status 200', () => pm.response.to.have.status(200));",
                                    "const body = pm.response.json();",
                                    "pm.test('has paySlips', () => pm.expect(body.paySlips).to.be.an('array'));"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "header": [
                            { "key": "Authorization", "value": "Bearer {{accessToken}}" },
                            { "key": "X-Branch-Id", "value": "{{branchId}}" }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/payroll/runs/{{payRunId}}",
                            "host": ["{{baseUrl}}"],
                            "path": ["api", "payroll", "runs", "{{payRunId}}"]
                        }
                    }
                }
            ]
        },
        {
            "name": "Pay Slips",
            "item": [
                {
                    "name": "List Pay Slips",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('status 200', () => pm.response.to.have.status(200));",
                                    "const body = pm.response.json();",
                                    "pm.test('has data', () => pm.expect(body.data).to.be.an('array'));"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "header": [
                            { "key": "Authorization", "value": "Bearer {{accessToken}}" },
                            { "key": "X-Branch-Id", "value": "{{branchId}}" }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/payroll/slips",
                            "host": ["{{baseUrl}}"],
                            "path": ["api", "payroll", "slips"]
                        }
                    }
                },
                {
                    "name": "List Pay Slips by Pay Run",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('status 200', () => pm.response.to.have.status(200));"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "header": [
                            { "key": "Authorization", "value": "Bearer {{accessToken}}" },
                            { "key": "X-Branch-Id", "value": "{{branchId}}" }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/payroll/slips?payRunId={{payRunId}}",
                            "host": ["{{baseUrl}}"],
                            "path": ["api", "payroll", "slips"],
                            "query": [
                                { "key": "payRunId", "value": "{{payRunId}}" }
                            ]
                        }
                    }
                },
                {
                    "name": "Get Pay Slip by ID",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('status 200', () => pm.response.to.have.status(200));",
                                    "const body = pm.response.json();",
                                    "pm.test('has componentSnapshot', () => pm.expect(body.componentSnapshot).to.be.an('object'));"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "header": [
                            { "key": "Authorization", "value": "Bearer {{accessToken}}" },
                            { "key": "X-Branch-Id", "value": "{{branchId}}" }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/payroll/slips/{{paySlipId}}",
                            "host": ["{{baseUrl}}"],
                            "path": ["api", "payroll", "slips", "{{paySlipId}}"]
                        }
                    }
                }
            ]
        }
    ]
}
