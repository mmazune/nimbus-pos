{
    "info": {
        "name": "M35 - Accounts Receivable + Invoicing + Direct Bill",
        "description": "API collection for M35 — AR customer accounts, invoices (create, list, get), receipts with allocations, aging summary, and AR credit notes.\n\nManual checklist:\n1. Run Auth — Login Owner\n2. Run Auth — Get Branch ID\n3. Create Customer Account → captures {{arAccountId}}\n4. Create Invoice 1 (ISSUED) → captures {{arInvoiceId}}\n5. Create Invoice 2 (for receipt test) → captures {{arInvoiceId2}}\n6. Create Receipt (partial) against invoice 2 → captures {{arReceiptId}}\n7. Verify Invoice 2 status → PARTIALLY_PAID\n8. Get Aging Summary\n9. Create AR Credit Note (without invoice)\n10. Create AR Credit Note (linked to invoice 1)",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:3001"
        }
    ],
    "item": [
        {
            "name": "Auth — Login Owner",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('status 201', () => pm.response.to.have.status(201));",
                            "const body = pm.response.json();",
                            "pm.environment.set('accessToken', body.accessToken);",
                            "pm.environment.set('refreshToken', body.refreshToken);"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"email\": \"owner@demo.local\",\n    \"password\": \"Owner#123\"\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/api/auth/login",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "auth", "login"]
                }
            }
        },
        {
            "name": "Auth — Get Branch ID",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('status 200', () => pm.response.to.have.status(200));",
                            "const body = pm.response.json();",
                            "const bid = body.defaultBranch?.id || body.organizations?.[0]?.branches?.[0]?.id || body.memberships?.[0]?.branchId;",
                            "pm.environment.set('branchId', bid);"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "GET",
                "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
                "url": {
                    "raw": "{{baseUrl}}/api/me",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "me"]
                }
            }
        },
