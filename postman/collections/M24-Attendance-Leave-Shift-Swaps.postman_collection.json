            "name": "List Leave Requests",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "X-Branch-Id",
                        "value": "{{branchId}}"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/hr/leave?take=10",
                    "host": [
                        "{{baseUrl}}"
                    ],
