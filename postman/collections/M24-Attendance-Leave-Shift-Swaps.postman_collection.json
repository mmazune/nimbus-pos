                },
                "url": {
                    "raw": "{{baseUrl}}/api/hr/shift-swaps",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "hr",
                        "shift-swaps"
                    ]
                }
            },
            "event": [
                {
