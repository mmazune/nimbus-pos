                        "leave"
                    ],
                    "query": [
                        {
                            "key": "take",
                            "value": "10"
                        }
                    ]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('200 OK', () => pm.response.to.have.status(200));",
                            "const json = pm.response.json();",
                            "pm.test('Has data + total', () => { pm.expect(json).to.have.property('data'); pm.expect(json).to.have.property('total'); });"
                        ]
                    }
