                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"employeeId\": \"{{employeeId1}}\",\n  \"leaveType\": \"ANNUAL\",\n  \"startsAt\": \"2026-07-01\",\n  \"endsAt\": \"2026-07-05\",\n  \"reason\": \"Annual vacation\"\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/api/hr/leave",
                    "host": [
