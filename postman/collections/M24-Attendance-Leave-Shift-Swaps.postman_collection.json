                        "value": "{{branchId}}"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"status\": \"APPROVED\",\n  \"reviewNotes\": \"Approved by manager\"\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/api/hr/leave/{{leaveRequestId}}/review",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "hr",
                        "leave",
                        "{{leaveRequestId}}",
                        "review"
                    ]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('200 OK', () => pm.response.to.have.status(200));",
                            "pm.test('Approved', () => pm.expect(pm.response.json().status).to.eql('APPROVED'));"
                        ]
                    }
