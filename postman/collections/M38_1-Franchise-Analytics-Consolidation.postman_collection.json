          "listen": "test",
          "script": {
            "exec": [
              "const resp = pm.response.json();",
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Has portfolioAverage', () => pm.expect(resp.portfolioAverage).to.be.an('object'));",
              "pm.test('Has bestBranch', () => pm.expect(resp.bestBranch).to.be.an('object'));",
              "pm.test('Has worstBranch', () => pm.expect(resp.worstBranch).to.be.an('object'));",
              "pm.test('Branches have vsPortfolio', () => {",
              "  resp.branches.forEach(b => pm.expect(b.vsPortfolio).to.be.an('object'));",
              "});"
            ],
            "type": "text/javascript"
