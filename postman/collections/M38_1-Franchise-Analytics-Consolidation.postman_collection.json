    {
      "name": "Scorecards - GET",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const resp = pm.response.json();",
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Has branches', () => pm.expect(resp.branches).to.be.an('array'));",
              "pm.test('7 domains per branch', () => {",
              "  resp.branches.forEach(b => pm.expect(b.domains.length).to.eql(7));",
              "});",
              "pm.test('Tiers are valid', () => {",
              "  resp.branches.forEach(b => b.domains.forEach(d => {",
              "    pm.expect(['STRONG', 'WATCH', 'AT_RISK']).to.include(d.tier);",
              "  }));",
              "});"
            ],
            "type": "text/javascript"
          }
        }
