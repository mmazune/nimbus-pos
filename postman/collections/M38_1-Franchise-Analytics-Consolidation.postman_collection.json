{
  "info": {
    "_postman_id": "m38-1-franchise-analytics-consolidation",
    "name": "M38.1 - Franchise Analytics + Consolidation",
    "description": "Franchise Analytics and Consolidation endpoints for M38.1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001",
      "type": "default"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "default"
    },
    {
      "key": "branchId",
      "value": "",
      "type": "default"
    }
  ],
  "item": [
    {
      "name": "Auth - Login Owner",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const resp = pm.response.json();",
              "pm.test('Status 201', () => pm.response.to.have.status(201));",
              "pm.test('Has accessToken', () => pm.expect(resp.accessToken).to.be.a('string'));",
              "pm.collectionVariables.set('accessToken', resp.accessToken);",
              "try { pm.environment.set('accessToken', resp.accessToken); } catch(e) {}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{ \"email\": \"owner@demo.local\", \"password\": \"Owner#123\" }"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        }
      }
    },
    {
      "name": "Consolidated Finance - GET",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const resp = pm.response.json();",
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Has consolidated', () => pm.expect(resp.consolidated).to.be.an('object'));",
              "pm.test('Has branches', () => pm.expect(resp.branches).to.be.an('array'));",
              "pm.test('Has calculationBasis', () => pm.expect(resp.calculationBasis).to.be.an('object'));",
              "if (resp.branches.length > 0) {",
              "  pm.collectionVariables.set('branchId', resp.branches[0].branchId);",
              "  try { pm.environment.set('branchId', resp.branches[0].branchId); } catch(e) {}",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/franchise/consolidated-finance?windowType=MONTHLY",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "franchise",
            "consolidated-finance"
          ],
          "query": [
            {
              "key": "windowType",
              "value": "MONTHLY"
            }
          ]
        }
      }
    },
    {
      "name": "Consolidated Finance - Generate Snapshot",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const resp = pm.response.json();",
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Status COMPLETED', () => pm.expect(resp.status).to.eql('COMPLETED'));",
              "pm.test('Has runId', () => pm.expect(resp.runId).to.be.a('string'));",
              "pm.test('Has metricsCount', () => pm.expect(resp.metricsCount).to.be.at.least(1));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/franchise/consolidated-finance/generate",
