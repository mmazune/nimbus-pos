                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"event_type\": \"payment.completed\",\n  \"external_id\": \"EXT-POSTMAN-MTN-001\",\n  \"status\": \"SUCCESSFUL\",\n  \"amount\": 50000\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/api/webhooks/mtn",
