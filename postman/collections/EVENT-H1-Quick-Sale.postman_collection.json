              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "400: cash tendered below the total",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Branch-Id",
                "value": "{{branchId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/pos/quick-sale",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "pos",
                "quick-sale"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientSaleId\": \"{{clientSaleId}}-bad2\",\n  \"tillCode\": \"{{tillCode}}\",\n  \"soldAt\": \"2026-11-21T21:14:00+03:00\",\n  \"lines\": [\n    {\n      \"sku\": \"{{itemSku}}\",\n      \"quantity\": 2\n    }\n  ],\n  \"payment\": {\n    \"method\": \"CASH\",\n    \"tenderedAmount\": 1\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "401 (no token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Branch-Id",
                "value": "{{branchId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/pos/quick-sale",
