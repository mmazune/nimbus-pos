              "raw": "{\n  \"clientSaleId\": \"{{clientSaleId}}-bad3\",\n  \"tillCode\": \"{{tillCode}}\",\n  \"soldAt\": \"2026-11-21T21:14:00+03:00\",\n  \"lines\": [\n    {\n      \"sku\": \"{{itemSku}}\",\n      \"quantity\": 2\n    }\n  ],\n  \"payment\": {\n    \"method\": \"CASH\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
