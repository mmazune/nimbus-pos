{
    "info": {
        "name": "M0 — Repo Bootstrap",
        "description": "Nimbus POS M0 milestone — bootstrap health check.\nAuth is not implemented yet; no login flows included.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "Health Check",
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "{{baseUrl}}/api/health",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "health"
                    ]
                },
                "description": "Returns API health status. No authentication required."
            },
            "response": [],
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test('Status code is 200', function () {",
                            "  pm.response.to.have.status(200);",
                            "});",
                            "",
                            "pm.test('Response has status ok', function () {",
                            "  var json = pm.response.json();",
                            "  pm.expect(json.status).to.eql('ok');",
                            "  pm.expect(json.service).to.eql('nimbus-pos-api');",
                            "  pm.expect(json.timestamp).to.be.a('string');",
                            "});"
                        ]
                    }
                }
            ]
        }
    ]
}