                        "key": "x-branch-id",
                        "value": "{{branchId}}"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/reports/{{reportRunId}}",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "reports",
                        "{{reportRunId}}"
                    ]
                }
            }
        },
        {
            "name": "10 — Create CSV Export",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const body = pm.response.json();",
                            "pm.environment.set('exportArtifactId', body.id);",
                            "pm.test('Status 201', () => pm.response.to.have.status(201));",
                            "pm.test('Status is READY', () => pm.expect(body.status).to.eql('READY'));",
                            "pm.test('Format is CSV', () => pm.expect(body.format).to.eql('CSV'));"
                        ]
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    },
                    {
                        "key": "Authorization",
                        "value": "Bearer {{accessToken}}"
                    },
                    {
                        "key": "x-branch-id",
                        "value": "{{branchId}}"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\"reportRunId\":\"{{reportRunId}}\",\"format\":\"CSV\"}"
                },
                "url": {
                    "raw": "{{baseUrl}}/api/reports/export",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "reports",
                        "export"
                    ]
                }
            }
        },
