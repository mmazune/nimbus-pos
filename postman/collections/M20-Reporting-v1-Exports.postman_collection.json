        {
            "name": "08 — List Reports",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const body = pm.response.json();",
                            "pm.test('Status 200', () => pm.response.to.have.status(200));",
                            "pm.test('Has data array', () => pm.expect(body.data).to.be.an('array'));",
                            "pm.test('Has total', () => pm.expect(body.total).to.be.a('number'));",
                            "pm.test('Has page', () => pm.expect(body.page).to.be.a('number'));"
                        ]
                    }
                }
            ],
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{accessToken}}"
                    },
                    {
                        "key": "x-branch-id",
                        "value": "{{branchId}}"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/reports?page=1&pageSize=10",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "reports"
                    ],
                    "query": [
                        {
                            "key": "page",
                            "value": "1"
                        },
                        {
                            "key": "pageSize",
                            "value": "10"
                        }
                    ]
                }
            }
        },
        {
            "name": "09 — Get Report By ID",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
