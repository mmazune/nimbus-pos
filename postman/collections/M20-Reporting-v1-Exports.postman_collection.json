            "name": "11 — Download Export",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Status 200', () => pm.response.to.have.status(200));",
                            "pm.test('Content-Type is CSV', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('text/csv'));",
                            "pm.test('Has attachment header', () => pm.expect(pm.response.headers.get('Content-Disposition')).to.include('attachment'));"
                        ]
                    }
                }
            ],
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{accessToken}}"
