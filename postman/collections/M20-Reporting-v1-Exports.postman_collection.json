{
    "info": {
        "name": "M20 — Reporting v1 + Exports",
        "_postman_id": "m20-reporting-v1-exports",
        "description": "M20 Reporting v1 & Exports. Covers shift-end, daily-sales, payment-mix, top-items, stock-variance, anomaly-summary reports, CSV/PDF export generation, report listing, and artifact download.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:3001"
        },
        {
            "key": "accessToken",
            "value": ""
        },
        {
            "key": "branchId",
            "value": ""
        },
        {
            "key": "reportRunId",
            "value": ""
        },
        {
            "key": "exportArtifactId",
            "value": ""
        },
        {
            "key": "chefAccessToken",
            "value": ""
        }
    ],
    "auth": {
        "type": "bearer",
        "bearer": [
            {
                "key": "token",
                "value": "{{accessToken}}"
            }
        ]
    },
    "item": [
        {
            "name": "00 — Login (Owner)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const body = pm.response.json();",
                            "pm.environment.set('accessToken', body.accessToken);",
                            "pm.test('Login OK', () => pm.response.to.have.status(201));"
                        ]
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\"email\":\"owner@demo.local\",\"password\":\"Owner#123\"}"
                },
                "url": {
                    "raw": "{{baseUrl}}/api/auth/login",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "auth",
                        "login"
                    ]
                }
            }
        },
        {
            "name": "01 — Get Branch ID",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const body = pm.response.json();",
                            "const bid = body.defaultBranch?.id || body.organizations?.[0]?.branches?.[0]?.id || body.branches?.[0]?.id || body.memberships?.[0]?.branchId;",
                            "pm.environment.set('branchId', bid);",
                            "pm.test('Branch resolved', () => pm.expect(bid).to.be.a('string'));"
                        ]
                    }
                }
            ],
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{accessToken}}"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/me",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "me"
                    ]
                }
            }
        },
        {
            "name": "02 — Generate Shift-End Report",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const body = pm.response.json();",
                            "pm.environment.set('reportRunId', body.id);",
                            "pm.test('Status 201', () => pm.response.to.have.status(201));",
                            "pm.test('Report type is SHIFT_END', () => pm.expect(body.reportType).to.eql('SHIFT_END'));",
                            "pm.test('Status is COMPLETED', () => pm.expect(body.status).to.eql('COMPLETED'));",
                            "pm.test('Has summary', () => pm.expect(body.summary).to.be.an('object'));"
                        ]
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    },
                    {
                        "key": "Authorization",
                        "value": "Bearer {{accessToken}}"
                    },
                    {
                        "key": "x-branch-id",
                        "value": "{{branchId}}"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\"reportWindow\":\"DAY\"}"
                },
                "url": {
                    "raw": "{{baseUrl}}/api/reports/shift-end",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "reports",
                        "shift-end"
                    ]
                }
            }
        },
