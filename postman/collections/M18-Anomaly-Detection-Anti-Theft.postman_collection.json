{
    "info":  {
                 "name":  "M18 — Anomaly Detection + Anti-Theft Signals",
                 "_postman_id":  "m18-anomaly-anti-theft",
                 "description":  "M18 Anomaly Detection \u0026 Anti-Theft Signals. Covers anomaly rules CRUD, anomaly events (list/acknowledge/resolve), risk dashboard, staff risk snapshots, thresholds, and recalculate.",
                 "schema":  "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
             },
    "variable":  [
                     {
                         "key":  "baseUrl",
                         "value":  "http://localhost:3001"
                     },
                     {
                         "key":  "accessToken",
                         "value":  ""
                     },
                     {
                         "key":  "branchId",
                         "value":  ""
                     },
                     {
                         "key":  "ruleId",
                         "value":  ""
                     },
                     {
                         "key":  "anomalyId",
                         "value":  ""
                     },
                     {
                         "key":  "thresholdId",
                         "value":  ""
                     }
                 ],
    "auth":  {
                 "type":  "bearer",
                 "bearer":  [
                                {
                                    "key":  "token",
                                    "value":  "{{accessToken}}"
                                }
                            ]
             },
    "item":  [
                 {
                     "name":  "00 — Login (Owner)",
                     "event":  [
                                   {
                                       "listen":  "test",
                                       "script":  {
                                                      "exec":  [
                                                                   "const body = pm.response.json();",
                                                                   "pm.environment.set(\u0027accessToken\u0027, body.accessToken);",
                                                                   "pm.test(\u0027Login OK\u0027, () =\u003e pm.response.to.have.status(200));"
                                                               ]
                                                  }
                                   }
                               ],
                     "request":  {
                                     "method":  "POST",
                                     "header":  [
                                                    {
                                                        "key":  "Content-Type",
                                                        "value":  "application/json"
                                                    }
                                                ],
                                     "body":  {
                                                  "mode":  "raw",
                                                  "raw":  "{\"email\":\"owner@demo.local\",\"password\":\"Owner#123\"}"
                                              },
                                     "url":  {
                                                 "raw":  "{{baseUrl}}/api/auth/login",
                                                 "host":  [
                                                              "{{baseUrl}}"
                                                          ],
                                                 "path":  [
                                                              "api",
                                                              "auth",
                                                              "login"
                                                          ]
                                             }
                                 }
                 },
                 {
                     "name":  "01 — Get Branch ID",
                     "event":  [
                                   {
                                       "listen":  "test",
                                       "script":  {
                                                      "exec":  [
                                                                   "const body = pm.response.json();",
                                                                   "const bid = body.defaultBranch?.id || body.organizations?.[0]?.branches?.[0]?.id || body.memberships?.[0]?.branchId;",
                                                                   "pm.environment.set(\u0027branchId\u0027, bid);",
                                                                   "pm.test(\u0027Got branchId\u0027, () =\u003e pm.expect(bid).to.be.a(\u0027string\u0027));"
                                                               ]
                                                  }
                                   }
                               ],
                     "request":  {
                                     "method":  "GET",
                                     "url":  {
                                                 "raw":  "{{baseUrl}}/api/me",
                                                 "host":  [
                                                              "{{baseUrl}}"
                                                          ],
                                                 "path":  [
                                                              "api",
                                                              "me"
                                                          ]
                                             }
                                 }
                 },
                 {
                     "name":  "02 — Create Anomaly Rule",
                     "event":  [
                                   {
                                       "listen":  "test",
                                       "script":  {
                                                      "exec":  [
                                                                   "const body = pm.response.json();",
                                                                   "pm.environment.set(\u0027ruleId\u0027, body.id);",
                                                                   "pm.test(\u0027Rule created\u0027, () =\u003e { pm.response.to.have.status(201); pm.expect(body.code).to.eql(\u0027PM-VOID-01\u0027); });"
                                                               ]
                                                  }
                                   }
                               ],
                     "request":  {
                                     "method":  "POST",
                                     "header":  [
                                                    {
                                                        "key":  "Content-Type",
                                                        "value":  "application/json"
                                                    },
                                                    {
                                                        "key":  "X-Branch-Id",
                                                        "value":  "{{branchId}}"
                                                    }
                                                ],
                                     "body":  {
                                                  "mode":  "raw",
                                                  "raw":  "{\"code\":\"PM-VOID-01\",\"name\":\"Postman Void Spike\",\"type\":\"VOID_SPIKE\",\"severity\":\"HIGH\",\"metricKey\":\"order.void.count_per_staff\",\"operator\":\"\u003e=\",\"thresholdValue\":5,\"windowMinutes\":60}"
                                              },
                                     "url":  {
                                                 "raw":  "{{baseUrl}}/api/analytics/anomaly-rules",
                                                 "host":  [
                                                              "{{baseUrl}}"
                                                          ],
                                                 "path":  [
                                                              "api",
                                                              "analytics",
                                                              "anomaly-rules"
                                                          ]
                                             }
                                 }
                 },
                 {
                     "name":  "03 — List Anomaly Rules",
                     "event":  [
                                   {
                                       "listen":  "test",
                                       "script":  {
                                                      "exec":  [
                                                                   "pm.test(\u0027Rules list OK\u0027, () =\u003e { pm.response.to.have.status(200); pm.expect(pm.response.json()).to.be.an(\u0027array\u0027); });"
                                                               ]
                                                  }
                                   }
                               ],
                     "request":  {
                                     "method":  "GET",
                                     "header":  [
                                                    {
                                                        "key":  "X-Branch-Id",
                                                        "value":  "{{branchId}}"
                                                    }
                                                ],
                                     "url":  {
                                                 "raw":  "{{baseUrl}}/api/analytics/anomaly-rules",
                                                 "host":  [
                                                              "{{baseUrl}}"
                                                          ],
                                                 "path":  [
                                                              "api",
                                                              "analytics",
                                                              "anomaly-rules"
                                                          ]
                                             }
                                 }
                 },
                 {
                     "name":  "04 — Get Rule by ID",
                     "event":  [
                                   {
                                       "listen":  "test",
                                       "script":  {
                                                      "exec":  [
                                                                   "pm.test(\u0027Rule retrieved\u0027, () =\u003e { pm.response.to.have.status(200); pm.expect(pm.response.json().id).to.eql(pm.environment.get(\u0027ruleId\u0027)); });"
                                                               ]
                                                  }
                                   }
                               ],
                     "request":  {
                                     "method":  "GET",
                                     "header":  [
                                                    {
                                                        "key":  "X-Branch-Id",
                                                        "value":  "{{branchId}}"
                                                    }
                                                ],
                                     "url":  {
                                                 "raw":  "{{baseUrl}}/api/analytics/anomaly-rules/{{ruleId}}",
                                                 "host":  [
                                                              "{{baseUrl}}"
                                                          ],
                                                 "path":  [
                                                              "api",
                                                              "analytics",
                                                              "anomaly-rules",
                                                              "{{ruleId}}"
                                                          ]
                                             }
                                 }
                 },
