{
    "info": {
        "name": "M22 — Documents + Uploads + Attachments",
        "description": "Nimbus POS M22: Document storage, file uploads, checksum deduplication, document linking, and storage provider configuration.\n\n## Endpoints\n- POST /documents/upload — Upload a document\n- GET /documents — List documents (paginated, filterable)\n- GET /documents/:id — Get document by ID\n- GET /documents/:id/download — Download document file\n- DELETE /documents/:id — Soft-delete a document\n- POST /documents/:id/link — Link document to a business record\n- GET /documents/:id/links — Get links for a document\n- PATCH /documents/:id/metadata — Update document metadata\n- GET /documents/storage-config — Get storage provider configs\n- PATCH /documents/storage-config/:providerType — Update storage config",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "auth": {
        "type": "bearer",
        "bearer": [
            {
                "key": "token",
                "value": "{{accessToken}}",
                "type": "string"
            }
        ]
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:3001"
        },
        {
            "key": "accessToken",
            "value": ""
        },
        {
            "key": "branchId",
            "value": ""
        },
        {
            "key": "documentId",
            "value": ""
        },
        {
            "key": "linkId",
            "value": ""
        }
    ],
    "item": [
        {
            "name": "Auth — Login (Owner)",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"email\": \"owner@demo.local\",\n  \"password\": \"Owner#123\"\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/api/auth/login",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "auth", "login"]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const json = pm.response.json();",
                            "pm.environment.set('accessToken', json.accessToken);",
                            "pm.test('Login OK', () => pm.response.to.have.status(201));"
                        ]
                    }
                }
            ]
        },
        {
            "name": "Auth — Get Branch ID",
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "{{baseUrl}}/api/me",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "me"]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const json = pm.response.json();",
                            "const bid = json.defaultBranch?.id || json.organizations?.[0]?.branches?.[0]?.id || json.branches?.[0]?.id || json.memberships?.[0]?.branchId;",
                            "pm.environment.set('branchId', bid);",
                            "pm.test('Got branch ID', () => pm.expect(bid).to.be.a('string'));"
                        ]
                    }
                }
            ]
        },
        {
            "name": "Upload Document (RECEIPT)",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "X-Branch-Id",
                        "value": "{{branchId}}"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": ""
                },
                "url": {
                    "raw": "{{baseUrl}}/api/documents/upload",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "documents", "upload"]
                }
            },
            "event": [
                {
                    "listen": "prerequest",
                    "script": {
                        "exec": [
                            "// Collection Runner cannot attach binary files via formdata src.",
                            "// Build a raw multipart body inline and send via pm.sendRequest.",
                            "const boundary = '----PostmanM22UploadBoundary';",
                            "const nl = '\\r\\n';",
                            "const parts = [",
                            "  '--' + boundary,",
                            "  'Content-Disposition: form-data; name=\"documentType\"',",
                            "  '',",
                            "  'RECEIPT',",
                            "  '--' + boundary,",
                            "  'Content-Disposition: form-data; name=\"file\"; filename=\"pm-test-receipt.pdf\"',",
                            "  'Content-Type: application/octet-stream',",
                            "  '',",
                            "  'Postman M22 test receipt file content for upload verification',",
                            "  '--' + boundary + '--'",
                            "];",
                            "pm.sendRequest({",
                            "  url: pm.variables.get('baseUrl') + '/api/documents/upload',",
                            "  method: 'POST',",
                            "  header: {",
                            "    'Authorization': 'Bearer ' + pm.environment.get('accessToken'),",
                            "    'X-Branch-Id': pm.environment.get('branchId'),",
                            "    'Content-Type': 'multipart/form-data; boundary=----PostmanM22UploadBoundary'",
                            "  },",
                            "  body: { mode: 'raw', raw: parts.join(nl) }",
                            "}, function(err, res) {",
                            "  if (err) { console.error('Upload prereq error:', err); return; }",
                            "  const json = res.json();",
                            "  pm.environment.set('_uploadCode', String(res.code));",
                            "  if (json.document && json.document.id) {",
                            "    pm.environment.set('documentId', json.document.id);",
                            "  }",
                            "});"
                        ]
                    }
                },
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const code = parseInt(pm.environment.get('_uploadCode') || '0');",
                            "const docId = pm.environment.get('documentId');",
                            "pm.test('Upload OK', () => pm.expect(code).to.equal(201));",
                            "pm.test('Has document', () => pm.expect(docId).to.be.a('string').and.not.empty);"
                        ]
                    }
                }
            ]
        },
        {
            "name": "List Documents",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "X-Branch-Id",
                        "value": "{{branchId}}"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/documents?skip=0&take=10",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "documents"],
                    "query": [
                        { "key": "skip", "value": "0" },
                        { "key": "take", "value": "10" }
                    ]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const json = pm.response.json();",
                            "pm.test('List OK', () => pm.response.to.have.status(200));",
                            "pm.test('Has data array', () => pm.expect(json.data).to.be.an('array'));",
                            "pm.test('Has total', () => pm.expect(json.total).to.be.a('number'));"
                        ]
                    }
                }
            ]
        },
        {
            "name": "List Documents — Filter by Type",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "X-Branch-Id",
                        "value": "{{branchId}}"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/documents?documentType=RECEIPT",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "documents"],
                    "query": [
                        { "key": "documentType", "value": "RECEIPT" }
                    ]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Filter OK', () => pm.response.to.have.status(200));"
                        ]
                    }
                }
            ]
        },
        {
            "name": "Get Document by ID",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "X-Branch-Id",
                        "value": "{{branchId}}"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/documents/{{documentId}}",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "documents", "{{documentId}}"]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const json = pm.response.json();",
                            "pm.test('Get OK', () => pm.response.to.have.status(200));",
                            "pm.test('Has id', () => pm.expect(json.id).to.equal(pm.environment.get('documentId')));",
                            "pm.test('Has links', () => pm.expect(json.links).to.be.an('array'));"
                        ]
                    }
                }
            ]
        },
        {
            "name": "Download Document",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "X-Branch-Id",
                        "value": "{{branchId}}"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/documents/{{documentId}}/download",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "documents", "{{documentId}}", "download"]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Download OK', () => pm.response.to.have.status(200));",
                            "pm.test('Has content-disposition', () => pm.expect(pm.response.headers.get('Content-Disposition')).to.include('attachment'));"
                        ]
                    }
                }
            ]
        },
        {
            "name": "Link Document to Order",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    },
                    {
                        "key": "X-Branch-Id",
                        "value": "{{branchId}}"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"linkType\": \"ORDER\",\n  \"linkedRecordId\": \"demo-order-id\",\n  \"linkedRecordLabel\": \"Order #PM-001\"\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/api/documents/{{documentId}}/link",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "documents", "{{documentId}}", "link"]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const json = pm.response.json();",
                            "if (json.id) pm.environment.set('linkId', json.id);",
                            "pm.test('Link OK', () => pm.response.to.have.status(201));",
                            "pm.test('Has linkType', () => pm.expect(json.linkType).to.equal('ORDER'));"
                        ]
                    }
                }
            ]
        },
        {
            "name": "Get Document Links",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "X-Branch-Id",
                        "value": "{{branchId}}"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/documents/{{documentId}}/links",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "documents", "{{documentId}}", "links"]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const json = pm.response.json();",
                            "pm.test('Links OK', () => pm.response.to.have.status(200));",
                            "pm.test('Is array', () => pm.expect(json).to.be.an('array'));",
                            "pm.test('Has at least one link', () => pm.expect(json.length).to.be.above(0));"
                        ]
                    }
                }
            ]
        },
        {
            "name": "Update Document Metadata",
            "request": {
                "method": "PATCH",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    },
                    {
                        "key": "X-Branch-Id",
                        "value": "{{branchId}}"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"metadata\": {\n    \"tag\": \"finance\",\n    \"priority\": \"high\"\n  }\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/api/documents/{{documentId}}/metadata",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "documents", "{{documentId}}", "metadata"]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Metadata update OK', () => pm.response.to.have.status(200));"
                        ]
                    }
                }
            ]
        },
        {
            "name": "Get Storage Config",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "X-Branch-Id",
                        "value": "{{branchId}}"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/documents/storage-config",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "documents", "storage-config"]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const json = pm.response.json();",
                            "pm.test('Config OK', () => pm.response.to.have.status(200));",
                            "pm.test('Is array', () => pm.expect(json).to.be.an('array'));"
                        ]
                    }
                }
            ]
        },
        {
            "name": "Update Storage Config (LOCAL)",
            "request": {
                "method": "PATCH",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    },
                    {
                        "key": "X-Branch-Id",
                        "value": "{{branchId}}"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"enabled\": true,\n  \"basePath\": \"/uploads\"\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/api/documents/storage-config/LOCAL",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "documents", "storage-config", "LOCAL"]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Config update OK', () => pm.response.to.have.status(200));"
                        ]
                    }
                }
            ]
        },
        {
            "name": "Delete Document (soft)",
            "request": {
                "method": "DELETE",
                "header": [
                    {
                        "key": "X-Branch-Id",
                        "value": "{{branchId}}"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/documents/{{documentId}}",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "documents", "{{documentId}}"]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const json = pm.response.json();",
                            "pm.test('Delete OK', () => pm.response.to.have.status(200));",
                            "pm.test('Status DELETED', () => pm.expect(json.status).to.equal('DELETED'));"
                        ]
                    }
                }
            ]
        }
    ]
}
