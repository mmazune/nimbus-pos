{
  "info": {
    "name": "M4 — Org Settings",
    "_postman_id": "m4-org-settings-collection",
    "description": "Nimbus POS — M4 Org Settings + Configuration endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Login (Owner)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const res = pm.response.json();",
              "pm.environment.set('accessToken', res.accessToken);",
              "pm.environment.set('refreshToken', res.refreshToken);",
              "pm.environment.set('userId', res.user.id);",
              "pm.test('Login successful', () => { pm.response.to.have.status(201); });",
              "pm.test('Has accessToken', () => { pm.expect(res.accessToken).to.be.a('string'); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"owner@demo.local\",\n  \"password\": \"Owner#123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "login"]
        }
      }
    },
    {
      "name": "Login (Waiter — no settings:manage)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const res = pm.response.json();",
              "pm.environment.set('waiterAccessToken', res.accessToken);",
              "pm.test('Login successful', () => { pm.response.to.have.status(201); });"
            ],
            "type": "text/javascript"
          }
        }
