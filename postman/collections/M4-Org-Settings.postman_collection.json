        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"waiter@demo.local\",\n  \"password\": \"Waiter#123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "login"]
        }
      }
    },
    {
      "name": "Get Settings",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const res = pm.response.json();",
              "pm.test('Status 200', () => { pm.response.to.have.status(200); });",
              "pm.test('Has id', () => { pm.expect(res.id).to.be.a('string'); });",
              "pm.test('Has currency', () => { pm.expect(res.currency).to.be.a('string'); });",
              "pm.test('Has vatPercent', () => { pm.expect(res.vatPercent).to.not.be.undefined; });",
              "pm.test('Has rounding', () => { pm.expect(res.rounding).to.not.be.null; });",
              "pm.test('Has taxMatrix', () => { pm.expect(res.taxMatrix).to.not.be.null; });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/settings",
          "host": ["{{baseUrl}}"],
          "path": ["api", "settings"]
        }
      }
    },
