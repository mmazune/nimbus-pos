{
    "info": {
        "name": "M36 - Bank Reconciliation + Period Close (Simplified)",
        "description": "Simplified M36 collection � bank accounts, bank statement import, manual bank entries, reconciliation (create/get/match/skip/complete), period close with retained earnings, and period lock.\n\nManual checklist:\n1. Auth Login Owner\n2. Auth Get Branch ID\n3. Create Bank Account\n4. List Bank Accounts\n5. Import Bank Statement\n6. List / Get Bank Statements\n7. Create Manual Bank Entry\n8. Create Reconciliation\n9. List / Get Reconciliation\n10. Match Statement Line\n11. Skip Statement Line\n12. Complete Reconciliation\n13. List Period Close Runs\n14. Create Test Fiscal Period (unique dates — auto-captures ID)\n15. Close Fiscal Period\n16. Lock Fiscal Period",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:3001"
        }
    ],
    "item": [
        {
            "name": "Auth � Login Owner",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('status 201', () => pm.response.to.have.status(201));",
                            "const body = pm.response.json();",
                            "pm.environment.set('accessToken', body.accessToken);",
                            "pm.environment.set('refreshToken', body.refreshToken);"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"email\": \"owner@demo.local\",\n    \"password\": \"Owner#123\"\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/api/auth/login",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "auth",
                        "login"
                    ]
                }
            }
        },
