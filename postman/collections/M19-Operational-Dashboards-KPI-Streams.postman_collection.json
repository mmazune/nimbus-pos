{
    "info": {
        "name": "M19 — Operational Dashboards + KPI Streams",
        "_postman_id": "m19-operational-dashboards-kpi-streams",
        "description": "M19 Operational Dashboards & KPI Streams. Covers owner dashboard, manager dashboard, today summary, payment mix, open orders, low stock, KPI snapshots, KPI refresh, and live metric SSE stream.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        { "key": "baseUrl", "value": "http://localhost:3001" },
        { "key": "accessToken", "value": "" },
        { "key": "branchId", "value": "" },
        { "key": "snapshotId", "value": "" },
        { "key": "chefAccessToken", "value": "" }
    ],
    "auth": {
        "type": "bearer",
        "bearer": [
            { "key": "token", "value": "{{accessToken}}" }
        ]
    },
    "item": [
        {
            "name": "00 — Login (Owner)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const body = pm.response.json();",
                            "pm.environment.set('accessToken', body.accessToken);",
                            "pm.test('Login OK', () => pm.response.to.have.status(200));"
                        ]
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\"email\":\"owner@demo.local\",\"password\":\"Owner#123\"}"
                },
                "url": {
                    "raw": "{{baseUrl}}/api/auth/login",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "auth", "login"]
                }
            }
        },
        {
            "name": "01 — Get Branch ID",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const body = pm.response.json();",
                            "const bid = body.defaultBranch?.id || body.organizations?.[0]?.branches?.[0]?.id || body.memberships?.[0]?.branchId;",
                            "pm.environment.set('branchId', bid);",
                            "pm.test('Got branchId', () => pm.expect(bid).to.be.a('string'));"
                        ]
                    }
                }
            ],
            "request": {
                "method": "GET",
                "url": {
                    "raw": "{{baseUrl}}/api/me",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "me"]
                }
            }
        },
        {
            "name": "02 — Owner Dashboard",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const body = pm.response.json();",
                            "pm.test('Status 200', () => pm.response.to.have.status(200));",
                            "pm.test('Has today', () => pm.expect(body.today).to.be.an('object'));",
                            "pm.test('Has mtd', () => pm.expect(body.mtd).to.be.an('object'));",
                            "pm.test('Has paymentMix', () => pm.expect(body.paymentMix).to.be.an('object'));",
                            "pm.test('Has anomalySummary', () => pm.expect(body.anomalySummary).to.be.an('object'));",
                            "pm.test('Has calculatedAt', () => pm.expect(body.calculatedAt).to.be.a('string'));"
                        ]
                    }
                }
            ],
            "request": {
                "method": "GET",
                "header": [
                    { "key": "x-branch-id", "value": "{{branchId}}" }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/dash/owner",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "dash", "owner"]
                }
            }
        },
        {
            "name": "03 — Manager Dashboard",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const body = pm.response.json();",
                            "pm.test('Status 200', () => pm.response.to.have.status(200));",
                            "pm.test('Has today', () => pm.expect(body.today).to.be.an('object'));",
                            "pm.test('Has shiftSummary', () => pm.expect(body.shiftSummary).to.be.an('object'));",
                            "pm.test('Has openOrders', () => pm.expect(body).to.have.property('openOrders'));",
                            "pm.test('Has calculatedAt', () => pm.expect(body.calculatedAt).to.be.a('string'));"
                        ]
                    }
                }
            ],
            "request": {
                "method": "GET",
                "header": [
                    { "key": "x-branch-id", "value": "{{branchId}}" }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/dash/manager",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "dash", "manager"]
                }
            }
        },
        {
            "name": "04 — Today Summary",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const body = pm.response.json();",
                            "pm.test('Status 200', () => pm.response.to.have.status(200));",
                            "pm.test('Has date', () => pm.expect(body.date).to.be.a('string'));",
                            "pm.test('Has grossSales', () => pm.expect(body).to.have.property('grossSales'));",
                            "pm.test('Has netSales', () => pm.expect(body).to.have.property('netSales'));",
                            "pm.test('Has paymentMix', () => pm.expect(body.paymentMix).to.be.an('object'));",
                            "pm.test('Has openOrders', () => pm.expect(body).to.have.property('openOrders'));",
                            "pm.test('Has closedOrders', () => pm.expect(body).to.have.property('closedOrders'));",
                            "pm.test('Has calculatedAt', () => pm.expect(body.calculatedAt).to.be.a('string'));"
                        ]
                    }
                }
            ],
            "request": {
                "method": "GET",
                "header": [
                    { "key": "x-branch-id", "value": "{{branchId}}" }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/dash/today-summary",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "dash", "today-summary"]
                }
            }
        },
        {
            "name": "05 — Payment Mix",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const body = pm.response.json();",
                            "pm.test('Status 200', () => pm.response.to.have.status(200));",
                            "pm.test('Has cash', () => pm.expect(body).to.have.property('cash'));",
                            "pm.test('Has card', () => pm.expect(body).to.have.property('card'));",
                            "pm.test('Has momo', () => pm.expect(body).to.have.property('momo'));",
                            "pm.test('Has total', () => pm.expect(body).to.have.property('total'));",
                            "pm.test('Has date', () => pm.expect(body.date).to.be.a('string'));"
                        ]
                    }
                }
            ],
            "request": {
                "method": "GET",
                "header": [
                    { "key": "x-branch-id", "value": "{{branchId}}" }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/dash/payment-mix",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "dash", "payment-mix"]
                }
            }
        },
        {
            "name": "06 — Open Orders",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const body = pm.response.json();",
                            "pm.test('Status 200', () => pm.response.to.have.status(200));",
                            "pm.test('Has count', () => pm.expect(body).to.have.property('count'));",
                            "pm.test('Has orders array', () => pm.expect(body.orders).to.be.an('array'));"
                        ]
                    }
                }
            ],
            "request": {
                "method": "GET",
                "header": [
                    { "key": "x-branch-id", "value": "{{branchId}}" }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/dash/open-orders",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "dash", "open-orders"]
                }
            }
        },
        {
            "name": "07 — Low Stock",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const body = pm.response.json();",
                            "pm.test('Status 200', () => pm.response.to.have.status(200));",
                            "pm.test('Has count', () => pm.expect(body).to.have.property('count'));",
                            "pm.test('Has items array', () => pm.expect(body.items).to.be.an('array'));"
                        ]
                    }
                }
            ],
            "request": {
                "method": "GET",
                "header": [
                    { "key": "x-branch-id", "value": "{{branchId}}" }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/dash/low-stock",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "dash", "low-stock"]
                }
            }
        },
        {
            "name": "08 — KPI Snapshots",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const body = pm.response.json();",
                            "pm.test('Status 200', () => pm.response.to.have.status(200));",
                            "pm.test('Is array', () => pm.expect(body).to.be.an('array'));"
                        ]
                    }
                }
            ],
            "request": {
                "method": "GET",
                "header": [
                    { "key": "x-branch-id", "value": "{{branchId}}" }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/dash/snapshots",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "dash", "snapshots"]
                }
            }
        },
        {
            "name": "09 — KPI Refresh (TODAY)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const body = pm.response.json();",
                            "pm.test('Status 201', () => pm.response.to.have.status(201));",
                            "pm.test('Has id', () => pm.expect(body.id).to.be.a('string'));",
                            "pm.test('scopeType is BRANCH', () => pm.expect(body.scopeType).to.eql('BRANCH'));",
                            "pm.test('metricWindow is TODAY', () => pm.expect(body.metricWindow).to.eql('TODAY'));",
                            "pm.environment.set('snapshotId', body.id);"
                        ]
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    { "key": "Content-Type", "value": "application/json" },
                    { "key": "x-branch-id", "value": "{{branchId}}" }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\"scopeType\":\"BRANCH\",\"metricWindow\":\"TODAY\"}"
                },
                "url": {
                    "raw": "{{baseUrl}}/api/dash/kpi/refresh",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "dash", "kpi", "refresh"]
                }
            }
        },
        {
            "name": "10 — KPI Refresh (MTD)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const body = pm.response.json();",
                            "pm.test('Status 201', () => pm.response.to.have.status(201));",
                            "pm.test('metricWindow is MTD', () => pm.expect(body.metricWindow).to.eql('MTD'));"
                        ]
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    { "key": "Content-Type", "value": "application/json" },
                    { "key": "x-branch-id", "value": "{{branchId}}" }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\"scopeType\":\"OWNER\",\"metricWindow\":\"MTD\"}"
                },
                "url": {
                    "raw": "{{baseUrl}}/api/dash/kpi/refresh",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "dash", "kpi", "refresh"]
                }
            }
        },
        {
            "name": "11 — Login (Chef — denied)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const body = pm.response.json();",
                            "pm.environment.set('chefAccessToken', body.accessToken);",
                            "pm.test('Login OK', () => pm.response.to.have.status(200));"
                        ]
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\"email\":\"chef@demo.local\",\"password\":\"Chef#123\"}"
                },
                "url": {
                    "raw": "{{baseUrl}}/api/auth/login",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "auth", "login"]
                }
            }
        },
        {
            "name": "12 — Owner Dashboard — Chef 403",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Status 403', () => pm.response.to.have.status(403));"
                        ]
                    }
                }
            ],
            "request": {
                "method": "GET",
                "header": [
                    { "key": "x-branch-id", "value": "{{branchId}}" },
                    { "key": "Authorization", "value": "Bearer {{chefAccessToken}}" }
                ],
                "auth": { "type": "noauth" },
                "url": {
                    "raw": "{{baseUrl}}/api/dash/owner",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "dash", "owner"]
                }
            }
        },
        {
            "name": "13 — KPI Refresh — Chef 403",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Status 403', () => pm.response.to.have.status(403));"
                        ]
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    { "key": "Content-Type", "value": "application/json" },
                    { "key": "x-branch-id", "value": "{{branchId}}" },
                    { "key": "Authorization", "value": "Bearer {{chefAccessToken}}" }
                ],
                "auth": { "type": "noauth" },
                "body": {
                    "mode": "raw",
                    "raw": "{\"scopeType\":\"BRANCH\",\"metricWindow\":\"TODAY\"}"
                },
                "url": {
                    "raw": "{{baseUrl}}/api/dash/kpi/refresh",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "dash", "kpi", "refresh"]
                }
            }
        },
        {
            "name": "14 — Missing Branch Header — 400/403",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Status 400 or 403', () => pm.expect([400, 403]).to.include(pm.response.code));"
                        ]
                    }
                }
            ],
            "request": {
                "method": "GET",
                "url": {
                    "raw": "{{baseUrl}}/api/dash/owner",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "dash", "owner"]
                }
            }
        },
        {
            "name": "15 — Unauthenticated — 401",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Status 401', () => pm.response.to.have.status(401));"
                        ]
                    }
                }
            ],
            "request": {
                "method": "GET",
                "auth": { "type": "noauth" },
                "url": {
                    "raw": "{{baseUrl}}/api/dash/owner",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "dash", "owner"]
                }
            }
        }
    ]
}
