{
    "info": {
        "name": "M3-Tenancy",
        "_postman_id": "nimbus-m3-tenancy",
        "description": "M3 — Multi-Tenancy Core: Organization, Branch, Membership, Branch Context Guard",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "auth": {
        "type": "bearer",
        "bearer": [
            {
                "key": "token",
                "value": "{{accessToken}}",
                "type": "string"
            }
        ]
    },
    "item": [
        {
            "name": "1. Login (Owner)",
            "request": {
                "auth": {
                    "type": "noauth"
                },
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"email\": \"owner@demo.local\",\n  \"password\": \"Owner#123\"\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/api/auth/login",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "auth",
                        "login"
                    ]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "const res = pm.response.json();",
                            "pm.test('Login returns 201', () => pm.response.to.have.status(201));",
                            "pm.test('Has accessToken', () => pm.expect(res.accessToken).to.be.a('string'));",
                            "if (res.accessToken) pm.environment.set('accessToken', res.accessToken);",
                            "if (res.refreshToken) pm.environment.set('refreshToken', res.refreshToken);",
                            "if (res.user && res.user.id) pm.environment.set('userId', res.user.id);"
                        ]
                    }
                }
            ],
            "response": []
        },
        {
            "name": "2. GET /me (tenancy context)",
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "{{baseUrl}}/api/me",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "me"
                    ]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "const res = pm.response.json();",
                            "pm.test('Me returns 200', () => pm.response.to.have.status(200));",
                            "pm.test('Has organizations', () => pm.expect(res.organizations).to.be.an('array'));",
                            "pm.test('Has defaultBranch', () => pm.expect(res.defaultBranch).to.not.be.undefined);",
                            "pm.test('Has roles', () => pm.expect(res.roles).to.be.an('array'));",
                            "pm.test('Has permissions', () => pm.expect(res.permissions).to.be.an('array'));",
                            "// Save waiter role ID for membership creation later",
                            "if (res.roles && res.roles.length > 0) {",
                            "  pm.environment.set('waiterRoleId', res.roles[0].id);",
                            "}"
                        ]
                    }
                }
            ],
            "response": []
        },
        {
            "name": "3. Create Org",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"name\": \"Postman Test Org\",\n  \"slug\": \"{{_orgSlug}}\",\n  \"legalName\": \"Postman Test LLC\"\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/api/orgs",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "orgs"
                    ]
                }
            },
            "event": [
                {
                    "listen": "prerequest",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "const ts = Date.now().toString(36);",
                            "pm.variables.set('_orgSlug', 'pm-org-' + ts);",
                            "pm.variables.set('_branchCode', 'PM' + ts.slice(-4).toUpperCase());"
                        ]
                    }
                },
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "const res = pm.response.json();",
                            "pm.test('Create org returns 201', () => pm.response.to.have.status(201));",
                            "pm.test('Has org id', () => pm.expect(res.id).to.be.a('string'));",
                            "if (res.id) pm.environment.set('orgId', res.id);"
                        ]
                    }
                }
            ],
            "response": []
        },
        {
            "name": "4. Create Branch",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"name\": \"Postman Branch\",\n  \"code\": \"{{_branchCode}}\",\n  \"timezone\": \"America/New_York\",\n  \"currencyCode\": \"USD\"\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/api/orgs/{{orgId}}/branches",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "orgs",
                        "{{orgId}}",
                        "branches"
                    ]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "const res = pm.response.json();",
                            "pm.test('Create branch returns 201', () => pm.response.to.have.status(201));",
                            "pm.test('Has branch id', () => pm.expect(res.id).to.be.a('string'));",
                            "pm.test('Branch name matches', () => pm.expect(res.name).to.eql('Postman Branch'));",
                            "if (res.id) pm.environment.set('branchId', res.id);"
                        ]
                    }
                }
            ],
            "response": []
        },
        {
            "name": "5. List Branches",
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "{{baseUrl}}/api/branches",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "branches"
                    ]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "const res = pm.response.json();",
                            "pm.test('List branches returns 200', () => pm.response.to.have.status(200));",
                            "pm.test('Is array', () => pm.expect(res).to.be.an('array'));"
                        ]
                    }
                }
            ],
            "response": []
        },
        {
            "name": "6. Get Branch",
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "{{baseUrl}}/api/branches/{{branchId}}",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "branches",
                        "{{branchId}}"
                    ]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test('Returns 200 or 403', () => {",
                            "  pm.expect(pm.response.code).to.be.oneOf([200, 403]);",
                            "});"
                        ]
                    }
                }
            ],
            "response": []
        },
        {
            "name": "7. Login (Waiter — for second user)",
            "request": {
                "auth": {
                    "type": "noauth"
                },
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"email\": \"waiter@demo.local\",\n  \"password\": \"Waiter#123\"\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/api/auth/login",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "auth",
                        "login"
                    ]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "const res = pm.response.json();",
                            "pm.test('Waiter login returns 201', () => pm.response.to.have.status(201));",
                            "if (res.user && res.user.id) pm.environment.set('secondUserId', res.user.id);",
                            "if (res.accessToken) pm.environment.set('secondAccessToken', res.accessToken);",
                            "// Get waiter role id from roles",
                            "if (res.user && res.user.roles && res.user.roles.length > 0) {",
                            "  pm.environment.set('waiterRoleId', res.user.roles[0].id);",
                            "}"
                        ]
                    }
                }
            ],
            "response": []
        },
        {
            "name": "8. Create Membership (add waiter to branch)",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"userId\": \"{{secondUserId}}\",\n  \"roleId\": \"{{waiterRoleId}}\",\n  \"isDefaultBranch\": true\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/api/orgs/{{orgId}}/branches/{{branchId}}/memberships",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "orgs",
                        "{{orgId}}",
                        "branches",
                        "{{branchId}}",
                        "memberships"
                    ]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "const res = pm.response.json();",
                            "pm.test('Create membership returns 201 or 409', () => pm.expect(pm.response.code).to.be.oneOf([201, 409]));",
                            "if (pm.response.code === 201) pm.test('Has membership id', () => pm.expect(res.id).to.be.a('string'));"
                        ]
                    }
                }
            ],
            "response": []
        },
        {
            "name": "9. List Memberships",
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "{{baseUrl}}/api/orgs/{{orgId}}/branches/{{branchId}}/memberships",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "orgs",
                        "{{orgId}}",
                        "branches",
                        "{{branchId}}",
                        "memberships"
                    ]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "const res = pm.response.json();",
                            "pm.test('List memberships returns 200', () => pm.response.to.have.status(200));",
                            "pm.test('Is array', () => pm.expect(res).to.be.an('array'));"
                        ]
                    }
                }
            ],
            "response": []
        },
        {
            "name": "10. Branch-test without X-Branch-Id → 400",
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "{{baseUrl}}/api/branch-test",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "branch-test"
                    ]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test('Returns 400 without X-Branch-Id', () => pm.response.to.have.status(400));"
                        ]
                    }
                }
            ],
            "response": []
        },
        {
            "name": "11. Branch-test with non-member → 403",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "X-Branch-Id",
                        "value": "{{branchId}}"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/branch-test",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "branch-test"
                    ]
                },
                "description": "Uses the owner token but a branchId where the second user was just added. Switch to secondAccessToken to test non-member denial. (Manual: login as cashier, use Downtown Branch ID)"
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "// This tests the guard with a valid branch and member — should return 200",
                            "// To test 403, manually switch to secondAccessToken and use a branch where user has no membership",
                            "pm.test('Returns 200 or 403', () => {",
                            "  pm.expect(pm.response.code).to.be.oneOf([200, 403]);",
                            "});"
                        ]
                    }
                }
            ],
            "response": []
        }
    ]
}