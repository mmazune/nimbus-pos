{
    "info": {
        "name": "M20.1 — Reporting Depth Expansion + Finalization",
        "_postman_id": "m20-1-reporting-depth-finalization",
        "description": "M20.1 Reporting Depth Expansion. 18 new report endpoints (sales-by-category, sales-by-hour, open-closed-orders, discounts-summary, voids-summary, refunds-summary, cash-variance, cash-movements, wastage-summary, low-stock, reservation-summary, reservation-deposits, reservation-no-shows, event-summary, event-bookings, event-checkins, high-risk-actors, staff-operations) + GET /catalog.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        { "key": "baseUrl", "value": "http://localhost:3001" },
        { "key": "accessToken", "value": "" },
        { "key": "branchId", "value": "" },
        { "key": "chefAccessToken", "value": "" },
        { "key": "reportRunId", "value": "" },
        { "key": "exportArtifactId", "value": "" }
    ],
    "auth": {
        "type": "bearer",
        "bearer": [{ "key": "token", "value": "{{accessToken}}" }]
    },
    "item": [
        {
            "name": "00 — Login (Owner)",
            "event": [{ "listen": "test", "script": { "exec": [
                "const body = pm.response.json();",
                "pm.environment.set('accessToken', body.accessToken);",
                "pm.test('Login OK', () => pm.response.to.have.status(201));"
            ] } }],
            "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\"email\":\"owner@demo.local\",\"password\":\"Owner#123\"}" },
                "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api","auth","login"] }
            }
        },
        {
            "name": "00b — Login (Chef — no report perms)",
            "event": [{ "listen": "test", "script": { "exec": [
                "const body = pm.response.json();",
                "pm.environment.set('chefAccessToken', body.accessToken);",
                "pm.test('Login OK', () => pm.response.to.have.status(201));"
            ] } }],
            "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\"email\":\"chef@demo.local\",\"password\":\"Chef#123\"}" },
                "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api","auth","login"] }
            }
        },
        {
            "name": "00c — Get Branch ID",
            "event": [{ "listen": "test", "script": { "exec": [
                "const body = pm.response.json();",
                "const bid = body.defaultBranch?.id || body.organizations?.[0]?.branches?.[0]?.id || body.memberships?.[0]?.branchId;",
                "pm.environment.set('branchId', bid);",
                "pm.test('Branch extracted', () => pm.expect(bid).to.be.a('string'));"
            ] } }],
            "request": {
                "method": "GET",
                "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
                "url": { "raw": "{{baseUrl}}/api/me", "host": ["{{baseUrl}}"], "path": ["api","me"] }
            }
        },
        {
            "name": "01 — GET Report Catalog",
            "event": [{ "listen": "test", "script": { "exec": [
                "pm.test('200 OK', () => pm.response.to.have.status(200));",
                "const body = pm.response.json();",
                "pm.test('Array with 20+ entries', () => pm.expect(body.length).to.be.greaterThan(20));",
                "pm.test('Entry has key/title/status', () => { pm.expect(body[0].key).to.be.a('string'); pm.expect(body[0].title).to.be.a('string'); pm.expect(body[0].status).to.be.a('string'); });"
            ] } }],
            "request": {
                "method": "GET",
                "header": [
                    { "key": "Authorization", "value": "Bearer {{accessToken}}" },
                    { "key": "x-branch-id", "value": "{{branchId}}" }
                ],
                "url": { "raw": "{{baseUrl}}/api/reports/catalog", "host": ["{{baseUrl}}"], "path": ["api","reports","catalog"] }
            }
        },
