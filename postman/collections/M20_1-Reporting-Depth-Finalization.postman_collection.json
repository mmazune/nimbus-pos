            "name": "02 — Sales by Category",
            "event": [{ "listen": "test", "script": { "exec": [
                "pm.test('201 Created', () => pm.response.to.have.status(201));",
                "const body = pm.response.json();",
                "pm.test('SALES_BY_CATEGORY', () => pm.expect(body.reportType).to.eql('SALES_BY_CATEGORY'));",
                "pm.test('COMPLETED', () => pm.expect(body.status).to.eql('COMPLETED'));",
                "pm.environment.set('reportRunId', body.id);"
