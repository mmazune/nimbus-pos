{
    "info": {
        "_postman_id": "m10-pos-orders",
        "name": "M10 — POS Orders",
        "description": "Nimbus POS — M10 POS Orders: Create, lifecycle, state machine transitions, line items.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "auth": {
        "type": "bearer",
        "bearer": [
            {
                "key": "token",
                "value": "{{accessToken}}",
                "type": "string"
            }
        ]
    },
    "item": [
        {
            "name": "Login (Owner)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const json = pm.response.json();",
                            "pm.environment.set('accessToken', json.accessToken);",
                            "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                            "pm.test('Has accessToken', () => pm.expect(json.accessToken).to.be.a('string'));"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "auth": { "type": "noauth" },
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"email\": \"owner@demo.local\",\n  \"password\": \"Owner#123\"\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/api/auth/login",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "auth", "login"]
                }
            }
        },
        {
            "name": "Create Dine-In Order",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const json = pm.response.json();",
                            "pm.environment.set('orderId', json.id);",
                            "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                            "pm.test('Status is NEW', () => pm.expect(json.status).to.eql('NEW'));",
                            "pm.test('ServiceType is DINE_IN', () => pm.expect(json.serviceType).to.eql('DINE_IN'));",
                            "pm.test('OrderNumber format', () => pm.expect(json.orderNumber).to.match(/^ORD-\\d{6}$/));"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    { "key": "Content-Type", "value": "application/json" },
                    { "key": "X-Branch-Id", "value": "{{branchId}}" }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"serviceType\": \"DINE_IN\",\n  \"tableId\": \"{{tableId}}\"\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/api/pos/orders",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "pos", "orders"]
                }
            }
        },
        {
            "name": "Create Takeaway Order",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const json = pm.response.json();",
                            "pm.environment.set('takeawayOrderId', json.id);",
                            "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                            "pm.test('ServiceType is TAKEAWAY', () => pm.expect(json.serviceType).to.eql('TAKEAWAY'));",
                            "pm.test('No tableId', () => pm.expect(json.tableId).to.be.null);"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    { "key": "Content-Type", "value": "application/json" },
                    { "key": "X-Branch-Id", "value": "{{branchId}}" }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"serviceType\": \"TAKEAWAY\"\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/api/pos/orders",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "pos", "orders"]
                }
            }
        },
        {
            "name": "List Orders",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const json = pm.response.json();",
                            "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                            "pm.test('Has data array', () => pm.expect(json.data).to.be.an('array'));",
                            "pm.test('Has total', () => pm.expect(json.total).to.be.a('number'));"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "GET",
                "header": [{ "key": "X-Branch-Id", "value": "{{branchId}}" }],
                "url": {
                    "raw": "{{baseUrl}}/api/pos/orders",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "pos", "orders"]
                }
            }
        },
        {
            "name": "Get Order by ID",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const json = pm.response.json();",
                            "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                            "pm.test('Has items array', () => pm.expect(json.items).to.be.an('array'));",
                            "pm.test('Has user info', () => pm.expect(json.user).to.be.an('object'));"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "GET",
                "header": [{ "key": "X-Branch-Id", "value": "{{branchId}}" }],
                "url": {
                    "raw": "{{baseUrl}}/api/pos/orders/{{orderId}}",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "pos", "orders", "{{orderId}}"]
                }
            }
        },
        {
            "name": "Add Order Item",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const json = pm.response.json();",
                            "pm.environment.set('orderItemId', json.id);",
                            "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                            "pm.test('Has menuItemId', () => pm.expect(json.menuItemId).to.be.a('string'));",
                            "pm.test('Quantity is 2', () => pm.expect(json.quantity).to.eql(2));"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    { "key": "Content-Type", "value": "application/json" },
                    { "key": "X-Branch-Id", "value": "{{branchId}}" }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"menuItemId\": \"{{menuItemId}}\",\n  \"quantity\": 2\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/api/pos/orders/{{orderId}}/items",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "pos", "orders", "{{orderId}}", "items"]
                }
            }
        },
        {
            "name": "Update Order Item",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const json = pm.response.json();",
                            "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                            "pm.test('Quantity updated to 3', () => pm.expect(json.quantity).to.eql(3));"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "PATCH",
                "header": [
                    { "key": "Content-Type", "value": "application/json" },
                    { "key": "X-Branch-Id", "value": "{{branchId}}" }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"quantity\": 3\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/api/pos/orders/{{orderId}}/items/{{orderItemId}}",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "pos", "orders", "{{orderId}}", "items", "{{orderItemId}}"]
                }
            }
        },
        {
            "name": "Delete Order Item",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "DELETE",
                "header": [{ "key": "X-Branch-Id", "value": "{{branchId}}" }],
                "url": {
                    "raw": "{{baseUrl}}/api/pos/orders/{{orderId}}/items/{{orderItemId}}",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "pos", "orders", "{{orderId}}", "items", "{{orderItemId}}"]
                }
            }
        },
        {
            "name": "Send Order (NEW → SENT)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const json = pm.response.json();",
                            "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                            "pm.test('Order status is SENT', () => pm.expect(json.status).to.eql('SENT'));"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    { "key": "Content-Type", "value": "application/json" },
                    { "key": "X-Branch-Id", "value": "{{branchId}}" }
                ],
                "body": { "mode": "raw", "raw": "{}" },
                "url": {
                    "raw": "{{baseUrl}}/api/pos/orders/{{orderId}}/send",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "pos", "orders", "{{orderId}}", "send"]
                }
            }
        },
        {
            "name": "Mark In-Kitchen (SENT → IN_KITCHEN)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const json = pm.response.json();",
                            "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                            "pm.test('Order status is IN_KITCHEN', () => pm.expect(json.status).to.eql('IN_KITCHEN'));"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    { "key": "Content-Type", "value": "application/json" },
                    { "key": "X-Branch-Id", "value": "{{branchId}}" }
                ],
                "body": { "mode": "raw", "raw": "{}" },
                "url": {
                    "raw": "{{baseUrl}}/api/pos/orders/{{orderId}}/in-kitchen",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "pos", "orders", "{{orderId}}", "in-kitchen"]
                }
            }
        },
        {
            "name": "Mark Ready (IN_KITCHEN → READY)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const json = pm.response.json();",
                            "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                            "pm.test('Order status is READY', () => pm.expect(json.status).to.eql('READY'));"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    { "key": "Content-Type", "value": "application/json" },
                    { "key": "X-Branch-Id", "value": "{{branchId}}" }
                ],
                "body": { "mode": "raw", "raw": "{}" },
                "url": {
                    "raw": "{{baseUrl}}/api/pos/orders/{{orderId}}/ready",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "pos", "orders", "{{orderId}}", "ready"]
                }
            }
        },
        {
            "name": "Mark Served (READY → SERVED)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const json = pm.response.json();",
                            "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                            "pm.test('Order status is SERVED', () => pm.expect(json.status).to.eql('SERVED'));"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    { "key": "Content-Type", "value": "application/json" },
                    { "key": "X-Branch-Id", "value": "{{branchId}}" }
                ],
                "body": { "mode": "raw", "raw": "{}" },
                "url": {
                    "raw": "{{baseUrl}}/api/pos/orders/{{orderId}}/mark-served",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "pos", "orders", "{{orderId}}", "mark-served"]
                }
            }
        },
        {
            "name": "Close Order (SERVED → CLOSED)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const json = pm.response.json();",
                            "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                            "pm.test('Order status is CLOSED', () => pm.expect(json.status).to.eql('CLOSED'));"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    { "key": "Content-Type", "value": "application/json" },
                    { "key": "X-Branch-Id", "value": "{{branchId}}" }
                ],
                "body": { "mode": "raw", "raw": "{}" },
                "url": {
                    "raw": "{{baseUrl}}/api/pos/orders/{{orderId}}/close",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "pos", "orders", "{{orderId}}", "close"]
                }
            }
        },
        {
            "name": "Void Order (from takeaway)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const json = pm.response.json();",
                            "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                            "pm.test('Order status is VOIDED', () => pm.expect(json.status).to.eql('VOIDED'));"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    { "key": "Content-Type", "value": "application/json" },
                    { "key": "X-Branch-Id", "value": "{{branchId}}" }
                ],
                "body": { "mode": "raw", "raw": "{\n  \"reason\": \"Customer cancelled\"\n}" },
                "url": {
                    "raw": "{{baseUrl}}/api/pos/orders/{{takeawayOrderId}}/void",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "pos", "orders", "{{takeawayOrderId}}", "void"]
                }
            }
        }
    ],
    "variable": [
        { "key": "baseUrl", "value": "http://localhost:3001" }
    ]
}
