# ── Nimbus POS API — Environment Placeholder ──
# Copy to .env and fill values. Do NOT commit .env.

API_PORT=3001

# Database (M1)
DATABASE_URL=
DIRECT_DATABASE_URL=

# Redis (wired in later milestones)
REDIS_URL=

# Auth (M2)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# MTN Mobile Money (M13.1)
PAY_MTN_ENABLED=false
PAY_MTN_BASE_URL=https://sandbox.momodeveloper.mtn.com
PAY_MTN_TARGET_ENV=sandbox
PAY_MTN_SUBSCRIPTION_KEY_PRIMARY=
PAY_MTN_SUBSCRIPTION_KEY_SECONDARY=
PAY_MTN_ACTIVE_SUBSCRIPTION_KEY=primary
PAY_MTN_API_USER=
PAY_MTN_API_KEY=
PAY_MTN_CALLBACK_URL=
PAY_MTN_PROVIDER_CALLBACK_HOST=
PAY_MTN_CURRENCY=EUR
PAY_MTN_PAYER_MESSAGE=Nimbus POS Payment
PAY_MTN_PAYEE_NOTE=POS Order
PAY_OFFLINE_MANUAL_REFERENCE_ENABLED=true
